@using TransferApp.Extensions
@{
    ViewData["Title"] = "Countries";
}

<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --primary: #4f46e5;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
    }

    .fade-in {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }
</style>

<div class="container-fluid mt-4 px-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between mb-3">
            <h3><i class="bi bi-flag-fill"></i> Countries</h3>
            @if (User.HasPermission("Countries.Create"))
            {
                <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalCountry">
                    <i class="bi bi-plus"></i> Add Country
            </button>
            }
        </div>

        <table id="tblCountries" class="table table-hover w-100">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Currency</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalCountry">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-custom p-3">
            <div class="modal-header">
                <h5>New Company</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCountry">
                <label class="form-label">Name</label>
                <input name="Name" class="form-control mb-2" placeholder="Name" required />
                <label class="form-label">Code</label>
                <input name="Code" class="form-control mb-2" placeholder="Code (SV, US)" required />
                <label class="form-label">Currency</label>
                <input name="Currency" class="form-control mb-2" placeholder="Currency (USD)" />
            </form>

            <div class="modal-footer">
                <button class="btn btn-custom" id="btnSaveCountry"><i class="bi bi-floppy-fill"></i> Save</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        let table;
        $(document).ready(function () {
            table = loadCountries();
        });
        function loadCountries() {
            return $('#tblCountries').DataTable({
                ajax: {
                    url: '/Countries/GetAll',
                    type: 'GET',
                    dataSrc: ''
                },
                columns: [
                    { data: 'name' },
                    { data: 'code' },
                    { data: 'currency' },
                    {
                        data: 'idCountry',
                        render: id => `
                            <a href="/Countries/Update/${id}" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <button class="btn btn-danger btn-sm" onclick="deleteCountry(${id})">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        `
                    }
                ],
                language: {
                    emptyTable: "No countries available"
                },
                drawCallback: () => $('#tblCountries tbody tr').addClass('fade-in')
            });
        }

                $('#btnSaveCountry').click(function () {

            let data = {
                Name: $('input[name="Name"]').val().trim(),
                Code: $('input[name="Code"]').val().trim().toUpperCase(),
                Currency: $('input[name="Currency"]').val(),
                UserC: "admin"
            };

            if (!data.Name || !data.Code) {
                Swal.fire('Error', 'Name & Code required', 'error');
                return;
            }

            $.ajax({
                url: '/Countries/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),

                beforeSend: () => {
                    Swal.fire({
                        title: 'Saving...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });
                },

                success: function (res) {
                    Swal.fire({
                        icon: 'success',
                        title: res.message,
                        timer: 1500,
                        showConfirmButton: false
                    });

                    $('#formCountry')[0].reset();
                    $('#modalCountry').modal('hide');
                    table.ajax.reload();
                },

                error: function (err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: err.responseJSON?.message || 'Something went wrong'
                    });
                }
            });
        });

                function deleteCountry(id) {

            Swal.fire({
                title: 'Delete?',
                text: 'This country will be removed',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete'
            }).then(r => {

                if (!r.isConfirmed) return;

                $.ajax({
                    url: '/Countries/Delete?id=' + id,
                    type: 'POST',

                    beforeSend: () => {
                        Swal.fire({
                            title: 'Deleting...',
                            allowOutsideClick: false,
                            didOpen: () => Swal.showLoading()
                        });
                    },

                    success: function (res) {
                        Swal.fire({
                            icon: 'success',
                            title: res.message
                        });

                        table.ajax.reload();
                    },

                    error: function (err) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: err.responseJSON?.message
                        });
                    }
                });

            });
        }

    </script>

}