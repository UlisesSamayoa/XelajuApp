@{
    ViewData["Title"] = "Update Company";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    :root {
        --primary: #4f46e5;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
        }

    .form-control {
        border-radius: 10px;
    }

    .title {
        font-weight: bold;
    }
</style>

<div class="container mt-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="title">Update Company</h3>

            <a href="/Companies" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <form id="formUpdate">

            <input type="hidden" id="Id" value="1" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Name</label>
                    <input type="text" id="Name" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Country</label>
                    <select name="Country" id="Country" class="form-control mb-2" required></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label>Swift Code</label>
                    <input type="text" id="SwiftCode" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Phone</label>
                    <input type="text" name="Phone" id="Phone" class="form-control" />
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label">TransactionType</label>
                    <select name="TransactionType" id="TransactionType" class="form-control mb-2" required></select>
                </div>
                <div class="col-12 mb-3">
                    <label>Status Company</label>
                    <select id="StatusCompany" name="StatusCompany" class="form-control">
                        <option value="Excellent">Excellent</option>
                        <option value="Suspicious">Suspicious</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label">Last justification for change of status</label>
                    <input name="StatusCompanyComment" id="StatusCompanyComment" class="form-control mb-2" />
                </div>
                <div class="row">
                    <div class="row">
                        <div class="col-4 mb-3">
                            <label>Contact person</label>
                            <input name="ContactPerson" id="ContactPerson" class="form-control mb-2" placeholder="Contact Person" />
                        </div>
                        <div class="col-4 mb-3">
                            Position
                            <input name="Position" id="Position" class="form-control mb-2" placeholder="Position" />
                        </div>
                        <div class="col-4 mb-3">
                            <label>Phone Contact person</label>
                            <input name="PhoneContactPerson" id="PhoneContactPerson" class="form-control mb-2" placeholder="Phone Contact Person" />
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label">Service Code</label>
                    <input name="ServiceCode" id="ServiceCode" class="form-control mb-2" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="button" class="btn btn-custom" id="btnUpdate">
                    <i class="bi bi-floppy-fill"></i> Update
                </button>

                <a href="/Companies" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>

        </form>

    </div>

</div>

<script>
     const id = '@ViewBag.IdCompany';
     console.log(id);

    $(document).ready(function () {

        loadCountriesDropdown('#Country');
        // loadCompaniesDropdown('#TransactionType');
        $.ajax({
        url: '/Companies/GetById?id=' + id,
        type: 'GET',

        beforeSend: () => {
            Swal.fire({
                title: 'Loading...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });
        },

        success: function (data) {

            Swal.close();

            if (!data) {
                Swal.fire('Error', 'Company not found', 'error')
                    .then(() => window.location.href = '/Companies');
                return;
            }

            $('#IdCompany').val(data.idCompany);
            $('#Name').val(data.name);
            $('#SwiftCode').val(data.swiftCode);
            $('#Phone').val(data.phone);
            $('#Position').val(data.position);
            $('#ContactPerson').val(data.contactPerson);
            $('#PhoneContactPerson').val(data.phoneContactPerson);
            $('#StatusCompany').val(data.statusCompany);
            $('#StatusCompanyComment').val(data.statusCompanyComment);
            $('#ServiceCode').val(data.serviceCode);
            loadCountriesDropdown('#Country', data.idCountry);
            loadCompaniesDropdown('#TransactionType',data.transactionType);
        },

        error: () => {
            Swal.fire('Error', 'Failed to load company', 'error');
        }
    });
     applyPhoneMask('#Phone');
     applyPhoneMask('#PhoneContactPerson');
    });
    function applyPhoneMask(selector) {
            Inputmask("(999)-999-9999").mask(selector);
        }
        $('#btnUpdate').click(function () {
            let data = {
                IdCompany: id,
                Name: $('#Name').val(),
                Country: $('#Country option:selected').text(),
                IdCountry: $('#Country').val(),
                SwiftCode: $('#SwiftCode').val(),
                Phone: $('#Phone').val(),
                TransactionType: $('#TransactionType').val(),
                ContactPerson: $('#ContactPerson').val(),
                PhoneContactPerson: $('#PhoneContactPerson').val(),
                Position: $('#Position').val(),
                StatusCompany: $('#StatusCompany').val(),
                StatusCompanyComment: $('#StatusCompanyComment').val(),
                UserU: "admin"
            };
            let transactionType = parseInt(data.TransactionType);
             if (!data.Name) {
                Swal.fire('Error', 'Name is required', 'error');
                return;
            }
            if (!data.IdCountry) {
                Swal.fire('Error', 'Country is required', 'error');
                return;
            }
            // if (!data.SwiftCode) {
            //     Swal.fire('Error', 'SwiftCode is required', 'error');
            //     return;
            // }
            if (!data.Phone) {
                Swal.fire('Error', 'Phone is required', 'error');
                return;
            }
            if (!data.TransactionType) {
                Swal.fire('Error', 'TransactionType is required', 'error');
                return;
            }
            if (transactionType === 4) {
                let serviceCode = $('#ServiceCode').val()?.trim() || '';
                if (!serviceCode) {
                    Swal.fire('Error', 'Service Code is required', 'error');
                    return;
                }
                data.ServiceCode = serviceCode;
            } else {

                if (!data.SwiftCode) {
                    Swal.fire('Error', 'Swift Code is required', 'error');
                    return;
                }

                if (!data.ContactPerson) {
                    Swal.fire('Error', 'Contact Person is required', 'error');
                    return;
                }

                if (!data.Position) {
                    Swal.fire('Error', 'Position is required', 'error');
                    return;
                }

                if (!data.PhoneContactPerson) {
                    Swal.fire('Error', 'Phone Contact Person is required', 'error');
                    return;
                }
            }

        $.ajax({
            url: '/Companies/Update',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),

            beforeSend: () => {
                Swal.fire({
                    title: 'Updating...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });
            },

            success: function (res) {
                Swal.fire({
                        icon: 'success',
                        title: res.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                    window.location.href = '/Companies';
                });
            },

            error: function (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: err.responseJSON?.message
                });
            }
        });
    });

    function loadCountriesDropdown(selectId, selectedValue = null) {

            $.ajax({
                url: '/Countries/GetAll',
                type: 'GET',

                success: function (data) {

                    let select = $(selectId);
                    select.empty();

                    select.append(`<option value="">Select country</option>`);

                    data.forEach(c => {
                        select.append(`
                            <option value="${c.idCountry}">
                                ${c.name}
                            </option>
                        `);
                    });

                    // 🔥 seleccionar valor si viene
                    if (selectedValue) {
                        select.val(selectedValue);
                    }
                },

                error: function () {
                    Swal.fire('Error', 'Failed to load countries', 'error');
                }
            });
        }

        function loadCompaniesDropdown(selectId, selectedValue = null) {

            $.ajax({
                url: '/TransactionsTypes/GetAllTypes',
                type: 'GET',

                success: function (data) {

                    let select = $(selectId);
                    select.empty();

                    data.forEach(c => {
                        select.append(`
                            <option value="${c.numberT}">
                                ${c.name}
                            </option>
                        `);
                    });
                    if (selectedValue) {
                        select.val(selectedValue);
                    }
                },

                error: function () {
                    Swal.fire('Error', 'Failed to load countries', 'error');
                }
            });
        }
</script>