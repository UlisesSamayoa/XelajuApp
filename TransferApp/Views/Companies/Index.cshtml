    <script>
        let table;
        $(document).ready(function () {
            table = loadTable();
            $('#tableLoader').hide();
            $('#tblCompanies').show();
            $('#filterCountry').on('keyup', function () {
                table.column(6).search(this.value).draw();
            });
             loadCountriesDropdown('#Country');
                  applyPhoneMask('#Phone');
                      applyPhoneMask('#PhoneContactPerson');
        });

        $('#TransactionType').change(function () {
            let type = parseInt($(this).val());
            if (type === 4) {
                $('#financialSection').hide();
                $('#serviceSection').show();
                $('#SwiftCode').val('').prop('disabled', true);
                $('#ContactPerson').val('').prop('disabled', true);
                $('#Position').val('').prop('disabled', true);
                $('#PhoneContactPerson').val('').prop('disabled', true);
            }
            else {
                $('#financialSection').show();
                $('#serviceSection').hide();
                $('#SwiftCode').prop('disabled', false);
                $('#ContactPerson').prop('disabled', false);
                $('#Position').prop('disabled', false);
                $('#PhoneContactPerson').prop('disabled', false);
                $('#ServiceCode').val('');
        }

        });


        $('#modalCompany').on('shown.bs.modal', function () {
            $('#TransactionType').trigger('change');
        });


            function applyPhoneMask(selector) {
                Inputmask("(999)-999-9999").mask(selector);
            }
         function loadTable() {
            return $('#tblCompanies').DataTable({
                ajax: {
                    url: '/Companies/GetAll',
                    type: 'GET',
                    dataSrc: ''
                },
                columns: [
                    { data: 'name' },
                    { data: 'swiftCode' },
                    { data: 'country' },
                    { data: 'phone' },
                        { data: 'transactionTypeName' },
                        { data: 'contactPerson' },
                            {
                        data: 'statusCompany',
                        render: function (data) {

                            let badgeClass = 'bg-secondary';
                            let icon = 'bi-question-circle';

                            switch (data) {

                                    case 'Excellent':
                                    badgeClass = 'bg-success';
                                    icon = 'bi-check-circle-fill';
                                    break;

                                    case 'Suspicious':
                                    badgeClass = 'bg-warning text-dark';
                                    icon = 'bi-clock-fill';
                                    break;

                                    case 'Rejected':
                                    badgeClass = 'bg-danger';
                                    icon = 'bi-x-circle-fill';
                                    break;
                            }

                            return `
                                <span class="badge ${badgeClass}"
                                      style="
                                        padding:8px 12px;
                                        font-size:13px;
                                        border-radius:20px;
                                        min-width:110px;
                                        display:inline-block;
                                        text-align:center;
                                      ">
                                    <i class="bi ${icon}"></i>
                                    ${data}
                                </span>
                            `;
                        }
                    },
                    {
                     className: 'tmin-w',
                      render: function (data, type, row) {
                             return `
                                <div class="d-flex gap-2">

                                    <button class="btn btn-warning btn-sm"
                                        onclick="openChangeStatusModal(${row.idCompany}, '${row.statusCompany}')">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>

                                    <a href="/Companies/Update/${row.idCompany}"
                                        class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <button class="btn btn-sm btn-danger"
                                        onclick="deleteItem(${row.idCompany})">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>

                                </div>
                                `;
                        }
                      }
                ],
                language: {
                    emptyTable: "No Companies available yet",
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries"
                },
                drawCallback: function () {
                    $('#tblCompanies tbody tr').addClass('fade-in');
                }
            });
        }


