@{
    ViewData["Title"] = "Companies";
    Layout = "_Layout";
}

<!-- LIBS -->
@* <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> *@

<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .tmin-w {
        min-width: 150px !important;
        white-space: nowrap;
    }
    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

    .skeleton {
        animation: shimmer 1.5s infinite linear;
        background: linear-gradient(to right, #eee 8%, #ddd 18%, #eee 33%);
        height: 20px;
        border-radius: 5px;
        margin-bottom: 10px;
    }

    @@keyframes shimmer {
        0% {
            background-position: -1000px 0;
        }

        100% {
            background-position: 1000px 0;
        }
    }

    .fade-in {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #tblCompanies tbody tr:hover {
        background: #f8fafc;
        transform: scale(1.01);
    }
</style>

<div class="container mt-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3><i class="bi bi-bank2"></i> Companies</h3>

            <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalCompany">
                <i class="bi bi-plus"></i> Add Company
            </button>
        </div>

        <!-- FILTROS -->
        <div class="row mb-3">
            <div class="col-md-4">
                <input type="text" id="filterCountry" class="form-control" placeholder="Filter by Status">
            </div>
        </div>

        <!-- SKELETON -->
        <div id="tableLoader">
            <div class="skeleton"></div>
            <div class="skeleton"></div>
            <div class="skeleton"></div>
        </div>

        <!-- TABLA -->
        <table id="tblCompanies" class="table table-hover w-100" style="display:none;">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Swift</th>
                    <th>Country</th>
                    <th>Phone</th>
                    <th>Transaction Type</th>
                    <th>Contact Person</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalCompany">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content card-custom">

            <div class="modal-header">
                <h5>New Company</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="formCompany">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Name</label>
                            <input name="Name" class="form-control mb-2" placeholder="Name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Country</label>
                            <select name="Country" id="Country" class="form-control mb-2" required></select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Swift Code</label>
                            <input name="SwiftCode" id="SwiftCode" class="form-control mb-2" placeholder="Swift Code" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input name="Phone" id="Phone" class="form-control mb-2" placeholder="Phone" />
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">TransactionType</label>
                        <select name="TransactionType" id="TransactionType" class="form-control mb-2" required></select>
                    </div>
                    <br />
                    <hr />
                    <div class="row">
                        <div class="col-4">
                            <label>Contact person</label>
                            <input name="ContactPerson" id="ContactPerson" class="form-control mb-2" placeholder="Contact Person" />
                        </div>
                        <div class="col-4">
                            Position
                            <input name="Position" id="Position" class="form-control mb-2" placeholder="Position" />
                        </div>
                        <div class="col-4">
                            <label>Phone Contact person</label>
                            <input name="PhoneContactPerson" id="PhoneContactPerson" class="form-control mb-2" placeholder="Phone Contact Person" />
                        </div>
                    </div>
                    <div id="serviceSection" style="display:none;">
                        <hr />
                        <div class="row">
                            <div class="col-md-12">
                                <label class="form-label">Service Code</label>
                                <input id="ServiceCode" class="form-control mb-2" placeholder="Service Code" />
                            </div>
                        </div>

                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-custom" id="btnSave"><i class="bi bi-floppy-fill"></i> Save</button>
            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="modalChangeStatus">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">
                    <i class="bi bi-arrow-repeat"></i>
                    Change Company Status
                </h5>
                <button class="btn-close" data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ChangeStatus_IdCompany" />
                <div class="mb-3">
                    <label class="form-label">
                        Current Status
                    </label>
                    <input type="text" id="ChangeStatus_Current" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        New Status
                    </label>
                    <select id="ChangeStatus_New" class="form-control">
                        <option value="">
                            Select Status
                        </option>
                        <option value="Excellent">
                            Excellent
                        </option>
                        <option value="Suspicious">
                            Suspicious
                        </option>
                        <option value="Rejected">
                            Rejected
                        </option>
                    </select>
                </div>
                <label>Justify</label>
                <input name="statusCompany" id="statusCompany" class="form-control mb-2" placeholder="Justify" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal"> Cancel </button>

                <button class="btn btn-warning" id="btnSaveCompanyStatus">
                    <i class="bi bi-floppy-fill"></i> Save Status
                </button>

            </div>

        </div>
    </div>
</div>
