                $('#btnSave').click(function () {

            let data = {
                Name: $('input[name="Name"]').val().trim(),
                Country: $('#Country option:selected').text(),
                IdCountry: $('#Country').val(),
                SwiftCode: $('#SwiftCode').val()?.trim() || '',
                Phone: $('#Phone').val()?.trim() || '',
                TransactionType: $('#TransactionType').val(),
                PhoneContactPerson: $('#PhoneContactPerson').val()?.trim() || '',
                ContactPerson: $('#ContactPerson').val()?.trim() || '',
                Position: $('#Position').val()?.trim() || '',
                UserC: "admin"
            };

            let transactionType = parseInt(data.TransactionType);

            // VALIDACIONES GENERALES

            if (!data.Name) {
                Swal.fire('Error', 'Name is required', 'error');
                return;
            }

            if (!data.IdCountry) {
                Swal.fire('Error', 'Country is required', 'error');
                return;
            }

            if (!data.Phone) {
                Swal.fire('Error', 'Phone is required', 'error');
                return;
            }

            if (!data.TransactionType) {
                Swal.fire('Error', 'Transaction Type is required', 'error');
                return;
            }

            // PAID SERVICE

            if (transactionType === 4) {
                let serviceCode = $('#ServiceCode').val()?.trim() || '';
                if (!serviceCode) {
                    Swal.fire('Error', 'Service Code is required', 'error');
                    return;
                }
                data.ServiceCode = serviceCode;
            }
            // FINANCIAL COMPANIES
            else {

                if (!data.SwiftCode) {
                    Swal.fire('Error', 'Swift Code is required', 'error');
                    return;
                }

                if (!data.ContactPerson) {
                    Swal.fire('Error', 'Contact Person is required', 'error');
                    return;
                }

                if (!data.Position) {
                    Swal.fire('Error', 'Position is required', 'error');
                    return;
                }

                if (!data.PhoneContactPerson) {
                    Swal.fire('Error', 'Phone Contact Person is required', 'error');
                    return;
                }
            }

            $.ajax({
                url: '/Companies/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                beforeSend: () => {
                    Swal.fire({
                        title: 'Saving...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });
                },
                success: function (res) {

                    Swal.fire({
                        icon: 'success',
                        title: res.message,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    $('#formCompany')[0].reset();
                    $('#modalCompany').modal('hide');
                    table.ajax.reload();
                    $('#TransactionType').trigger('change');
                },
                error: function (err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: err.responseJSON?.message || 'Something went wrong'
                    });
                }
            });
        });

                function deleteItem(id) {

            Swal.fire({
                title: 'Are you sure?',
                text: 'This company will be deleted',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete'
            }).then((result) => {

                if (!result.isConfirmed) return;

                $.ajax({
                    url: '/Companies/Delete?id=' + id,
                    type: 'POST',

                    beforeSend: () => {
                        Swal.fire({
                            title: 'Deleting...',
                            allowOutsideClick: false,
                            didOpen: () => Swal.showLoading()
                        });
                    },

                    success: function (res) {
                        Swal.fire({
                            icon: 'success',
                            title: res.message
                        });

                        table.ajax.reload();
                    },

                    error: function (err) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: err.responseJSON?.message
                        });
                    }
                });

            });
        }
                function loadCountriesDropdown(selectId, selectedValue = null) {

            $.ajax({
                url: '/Countries/GetAll',
                type: 'GET',

                success: function (data) {

                    let select = $(selectId);
                    select.empty();

                    select.append(`<option value="">Select country</option>`);

                    data.forEach(c => {
                        select.append(`
                            <option value="${c.idCountry}">
                                ${c.name}
                            </option>
                        `);
                    });

                    // 🔥 seleccionar valor si viene
                    if (selectedValue) {
                        select.val(selectedValue);
                    }
                },

                error: function () {
                    Swal.fire('Error', 'Failed to load countries', 'error');
                }
            });
        

       $.get('/TransactionsTypes/GetAllTypes', function (data) {
                    $('#TransactionType').empty();
                data.forEach(t => {
                        $('#TransactionType').append(
                        `<option value="${t.numberT}"
                                 data-commission="${t.commission}">
                            ${t.name}
                        </option>`
                        );
                });

        });
        
    }


        function openChangeStatusModal(id, currentStatus) {

                $('#ChangeStatus_IdCompany').val(id);

                $('#ChangeStatus_Current').val(currentStatus);

                $('#ChangeStatus_New').val('');

                $('#modalChangeStatus').modal('show');
            }
                    $('#btnSaveCompanyStatus').click(function () {

                    let idCompany =$('#ChangeStatus_IdCompany').val();

                let status =$('#ChangeStatus_New').val();
                let statusCompanyComment =$('#statusCompany').val();

                if (!status) {
                    Swal.fire(
                        'Error',
                        'Select a status',
                        'error'
                    );
                    return;
                }
                    if (!statusCompanyComment) {
                        Swal.fire(
                            'Error',
                            'Justify is required',
                            'error'
                        );
                        return;
                    }

                Swal.fire({
                    title: 'Saving...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                $.ajax({

                    url: '/Companies/ChangeStatus',

                    method: 'POST',

                    data: {
                                idCompany: idCompany,
                        status: status,
                                        statusCompanyComment:statusCompanyComment
                    },

                    success: function () {

                        $('#modalChangeStatus')
                            .modal('hide');

                            $('#tblCompanies')
                            .DataTable()
                            .ajax.reload();

                        Swal.fire({
                            icon: 'success',
                            title: 'Status updated',
                            timer: 1200,
                            showConfirmButton: false
                        });
                    },

                    error: function (err) {

                        Swal.fire(
                            'Error',
                            err.responseText,
                            'error'
                        );
                    }
                });
            });
