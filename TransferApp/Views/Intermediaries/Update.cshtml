@{
    ViewData["Title"] = "Update Intermediary";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    :root {
        --primary: #4f46e5;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
        }

    .form-control {
        border-radius: 10px;
    }

    .title {
        font-weight: bold;
    }
</style>

<div class="container mt-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="title">Update Intermediary</h3>

            <a href="/Intermediaries" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <form id="formUpdate">

            <input type="hidden" id="Id" value="1" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Name</label>
                    <input type="text" id="Name" class="form-control" value="Bank of America" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Country</label>
                    <input type="text" id="Country" class="form-control" value="USA" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Swift Code</label>
                    <input type="text" id="SwiftCode" class="form-control" value="BOFAUS3N" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Phone</label>
                    <input type="text" id="Phone" class="form-control" value="+1 800 432 1000" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Status</label>
                    <select id="IsActive" class="form-control">
                        <option value="true" selected>Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="button" class="btn btn-custom" id="btnUpdate">
                    <i class="bi bi-floppy-fill"></i> Update
                </button>

                <a href="/Intermediaries" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>

        </form>

    </div>

</div>

<script>
    $('#btnUpdate').click(function () {

        // 👇 aquí luego conectas tu backend
        let data = {
            id: $('#Id').val(),
            name: $('#Name').val(),
            country: $('#Country').val(),
            swiftCode: $('#SwiftCode').val(),
            phone: $('#Phone').val(),
            isActive: $('#IsActive').val()
        };

        Swal.fire({
            title: 'Updating...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
        });

        setTimeout(() => {
            Swal.fire({
                icon: 'success',
                title: 'Updated!',
                text: 'Intermediary updated successfully'
            });
        }, 1000);
    });

    function resetForm() {
        document.getElementById('formUpdate').reset();
    }
</script>