@{
    ViewData["Title"] = "Intermediaries";
}

<!-- LIBS -->
<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --bg: #f1f5f9;
    }
    body {
        background: var(--bg);
    }
    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }
    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
        transition: 0.3s;
    }
        .btn-custom:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }
    .skeleton {
        animation: shimmer 1.5s infinite linear;
        background: linear-gradient(to right, #eee 8%, #ddd 18%, #eee 33%);
        height: 20px;
        border-radius: 5px;
        margin-bottom: 10px;
    }
    @@keyframes shimmer {
        0%
    {
        background-position: -1000px 0;
    }
    100% {
        background-position: 1000px 0;
    }

    }
    .fade-in {
        animation: fadeIn 0.4s ease-in-out;
    }
    @@keyframes fadeIn {
        from
    {
        opacity: 0;
        transform: translateY(5px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
    }
    #tblIntermediaries tbody tr:hover {
        background: #f8fafc;
        transform: scale(1.01);
    }
</style>

<div class="container mt-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3><i class="bi bi-bank2"></i> Intermediaries</h3>

            <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalIntermediary">
                <i class="bi bi-plus"></i> Add Intermediary
            </button>
        </div>

        <!-- FILTROS -->
        <div class="row mb-3">
            <div class="col-md-4">
                <input type="text" id="filterCountry" class="form-control" placeholder="Filter by country">
            </div>
            <div class="col-md-4">
                <select id="filterStatus" class="form-control">
                    <option value="">All Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>

        <!-- SKELETON -->
        <div id="tableLoader">
            <div class="skeleton"></div>
            <div class="skeleton"></div>
            <div class="skeleton"></div>
        </div>

        <!-- TABLA -->
        <table id="tblIntermediaries" class="table table-hover w-100" style="display:none;">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Country</th>
                    <th>Swift</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalIntermediary">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-custom">

            <div class="modal-header">
                <h5>New Intermediary</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="formIntermediary">
                    <label class="form-label">Name</label>
                    <input name="Name" class="form-control mb-2" placeholder="Name" required />
                    <label class="form-label">Country</label>
                    <select name="Country" id="Country" class="form-control mb-2"></select>
                    <label class="form-label">Swift Code</label>
                    <input name="SwiftCode" class="form-control mb-2" placeholder="Swift Code" />
                    <label class="form-label">Phone</label>
                    <input name="Phone" class="form-control mb-2" placeholder="Phone" />
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-custom" id="btnSave"><i class="bi bi-floppy-fill"></i> Save</button>
            </div>

        </div>
    </div>
</div>

