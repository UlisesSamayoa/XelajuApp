                    $('#btnSave').click(function () {

            let name = $('input[name="Name"]').val().trim();
            let country = $('#Country').val();
            let swift = $('input[name="SwiftCode"]').val();
            let phone = $('input[name="Phone"]').val();

            // 🧠 Validación básica
            if (!name) {
                Swal.fire('Error', 'Name is required', 'error');
                return;
            }

            // 🚫 VALIDAR DUPLICADO (case-insensitive)
            const exists = intermediariesData.some(x =>
                x.name.toLowerCase() === name.toLowerCase()
            );

            if (exists) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Duplicate!',
                    text: 'An intermediary with this name already exists'
                });
                return;
            }

            // 🆔 Generar ID
            let newId = intermediariesData.length > 0
                ? Math.max(...intermediariesData.map(x => x.id)) + 1
                : 1;

            let newItem = {
                id: newId,
                name: name,
                country: country,
                swiftCode: swift,
                phone: phone,
                isActive: true
            };

            // 💾 Guardar
            intermediariesData.push(newItem);

            // 📊 Agregar a tabla
            table.row.add(newItem).draw();

            // 🔔 Éxito
            Swal.fire({
                icon: 'success',
                title: 'Saved!',
                text: 'Intermediary added successfully',
                timer: 1500,
                showConfirmButton: false
            });
            $('#formIntermediary')[0].reset();
            $('#modalIntermediary').modal('hide');
        });

