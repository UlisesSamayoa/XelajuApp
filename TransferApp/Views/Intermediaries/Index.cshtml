        function deleteItem(id) {
            const item = intermediariesData.find(x => x.id === id);
            if (!item) return;
            Swal.fire({
                title: 'Are you sure?',
                html: `
                    You are about to delete:<br>
                    <b>${item.name}</b><br>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete'
            }).then((result) => {
                if (result.isConfirmed) {
                    const index = intermediariesData.findIndex(x => x.id === id);
                    if (index !== -1) {
                        intermediariesData.splice(index, 1);
                    }
                    table.clear().rows.add(intermediariesData).draw();
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: `${item.name} was removed`
                    });
                }
            });
        }
