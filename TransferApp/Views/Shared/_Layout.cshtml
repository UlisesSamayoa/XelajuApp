<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TransferApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/TransferApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<style>
    :root {
        --sidebar-bg: #362926; /* 🔵 CAMBIA ESTE COLOR */
        --sidebar-text: #ffffff;
        --sidebar-hover: #0b5ed7;
        --content-bg: #f5f7fb;
    }

    body {
        margin: 0;
        display: flex;
        background-color: var(--content-bg);
        font-family: 'Segoe UI', sans-serif;
    }

    .sidebar {
        width: 250px;
        height: 100vh;
        background: var(--sidebar-bg);
        color: var(--sidebar-text);
        position: fixed;
        display: flex;
        flex-direction: column;
        transition: 0.3s;
        /* 🔥 CLAVE */
        overflow-y: auto;
        overflow-x: hidden;
    }

        /* opcional: mejor scroll visual */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
        }

        .sidebar h2 {
            position: sticky;
            top: 0;
            background: var(--sidebar-bg);
            z-index: 10;
        }
    .sidebar a {
        color: var(--sidebar-text);
        text-decoration: none;
        padding: 10px 15px;
        display: block;
        transition: 0.2s;
    }

    .sidebar a:hover {
        background: var(--sidebar-hover);
        padding-left: 25px;
    }

    /* CONTENIDO */
    .main-content {
        margin-left: 250px;
        padding: 20px;
        width: 100%;
    }

    /* TOP BAR */
    .topbar {
        background: white;
        padding: 10px 20px;
        border-bottom: 1px solid #ddd;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .sidebar {
            width: 70px;
        }

        .sidebar h2 {
            display: none;
        }

        .sidebar a {
            text-align: center;
            padding: 15px 5px;
        }

        .main-content {
            margin-left: 70px;
        }
    }
</style>
<body>
    @* <div class="sidebar">
        <h2>Xelaju Water</h2>

        <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill" style="font-size:1.5rem;"></i> Home</a>
        <a asp-controller="Transactions" asp-action="Index"><i class="bi bi-currency-exchange" style="font-size:1.5rem;"></i> Transactions</a>
        <a asp-controller="Clients" asp-action="Index"><i class="bi bi-people-fill" style="font-size:1.5rem;"></i> Clients</a>
        <a asp-controller="Beneficiaries" asp-action="Index"><i class="bi bi-person-heart" style="font-size:1.5rem;"></i> Beneficiaries</a>
        <a asp-controller="Companies" asp-action="Index"><i class="bi bi-bank2" style="font-size:1.5rem;"></i> Companies</a>
        <a asp-controller="Reviews" asp-action="Index"><i class="bi bi-journal-text" style="font-size:1.5rem;"></i> Independent Review</a>
        <a asp-controller="TrainingsLicenses" asp-action="Index"><i class="bi bi-award" style="font-size:1.5rem;"></i> Trainings & Licenses</a>
        <a asp-controller="Countries" asp-action="Index"><i class="bi bi-flag" style="font-size:1.5rem;"></i> Countries</a>
        <a asp-controller="DocumentsTypes" asp-action="Index"><i class="bi bi-file-earmark-medical-fill" style="font-size:1.5rem;"></i> Documents Types</a>
        <a asp-controller="TransactionsTypes" asp-action="Index"><i class="bi bi-cash-stack" style="font-size:1.5rem;"></i> TransactionsTypes</a>
        <a asp-controller="Users" asp-action="Index"><i class="bi bi-person-fill-gear" style="font-size:1.5rem;"></i> Users</a>
        <a asp-controller="Parameters" asp-action="Index"><i class="bi bi-sliders" style="font-size:1.5rem;"></i> Parameters</a>
        <a asp-controller="Auth" asp-action="Login"><i class="bi bi-box-arrow-in-left" style="font-size:1.5rem;"></i> Log out</a>
    </div> *@
    <div class="sidebar">
        <div class="text-center" style="margin-top:30px; margin-bottom:30px;">
            <h2>Xelaju Water</h2>
        </div>
        <a asp-controller="Home" asp-action="Index">
            <i class="bi bi-house-fill" style="font-size:1.5rem;"></i> Home
        </a>

        <a asp-controller="Transactions" asp-action="Index">
            <i class="bi bi-currency-exchange" style="font-size:1.5rem;"></i> Transactions
        </a>

        <a asp-controller="Clients" asp-action="Index">
            <i class="bi bi-people-fill" style="font-size:1.5rem;"></i> Clients
        </a>
        <a asp-controller="ClientCompanies" asp-action="Index">
            <i class="bi bi-people-fill" style="font-size:1.5rem;"></i> Client Companies
        </a>
        <a asp-controller="Beneficiaries" asp-action="Index">
            <i class="bi bi-person-heart" style="font-size:1.5rem;"></i> Beneficiaries
        </a>
        <a asp-controller="Reports" asp-action="Index">
            <i class="bi bi-file-earmark-bar-graph-fill" style="font-size:1.5rem;"></i> Reports
        </a>

        

        <a asp-controller="Reviews" asp-action="Index">
            <i class="bi bi-journal-text" style="font-size:1.5rem;"></i> Independent Review
        </a>

        <a asp-controller="TrainingsLicenses" asp-action="Index">
            <i class="bi bi-award" style="font-size:1.5rem;"></i> Trainings & Licenses
        </a>
        
        <div class="mt-2">
            <a class="d-flex justify-content-between align-items-center text-white"
               data-bs-toggle="collapse"
               href="#configMenu"
               role="button"
               aria-expanded="false"
               aria-controls="configMenu">
                <span>
                    <i class="bi bi-gear-fill" style="font-size:1.5rem;"></i>
                    Configurations
                </span>
                <i class="bi bi-chevron-down"></i>
            </a>
            <div class="collapse ms-3 mt-2" id="configMenu">
                <a asp-controller="Countries" asp-action="Index">
                    <i class="bi bi-flag" style="font-size:1.5rem;"></i> Countries
                </a>
                <a asp-controller="Companies" asp-action="Index">
                    <i class="bi bi-bank2" style="font-size:1.5rem;"></i> Companies
                </a>
                <a asp-controller="DocumentsTypes" asp-action="Index">
                    <i class="bi bi-file-earmark-medical-fill"></i> Documents Types
                </a>
                <a asp-controller="Parameters" asp-action="Index">
                    <i class="bi bi-sliders"></i> Parameters
                </a>
                <a asp-controller="TransactionsTypes" asp-action="Index">
                    <i class="bi bi-cash-stack"></i> Transactions Types
                </a>
            </div>
        </div>
        <a asp-controller="Users" asp-action="Index">
            <i class="bi bi-person-fill-gear" style="font-size:1.5rem;"></i> Users
        </a>
        <a asp-controller="Auth" asp-action="Login">
            <i class="bi bi-box-arrow-in-left" style="font-size:1.5rem;"></i> Log out
        </a>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div class="text-start">
                <span>Welcome</span>
            </div>
            <div class="text-end">
                @if (User.Identity!.IsAuthenticated)
                {
                    <span>
                        @User.FindFirst("FirstName")?.Value
                    </span>
                    <a asp-controller="Auth" class="btn btn-secondary" asp-action="Logout">Logout</a>
                }
            </div>
        </div>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="border-top mt-4 pt-3 text-muted">
            &copy; 2026 - TransferApp
        </footer>
    </div>

    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.9/jquery.inputmask.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
