<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TransferApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TransferApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>
<style>
    :root {
        --sidebar-bg: #362926; /* 🔵 CAMBIA ESTE COLOR */
        --sidebar-text: #ffffff;
        --sidebar-hover: #0b5ed7;
        --content-bg: #f5f7fb;
    }

    body {
        margin: 0;
        display: flex;
        background-color: var(--content-bg);
        font-family: 'Segoe UI', sans-serif;
    }

    /* SIDEBAR */
    .sidebar {
        width: 250px;
        height: 100vh;
        background: var(--sidebar-bg);
        color: var(--sidebar-text);
        position: fixed;
        display: flex;
        flex-direction: column;
        transition: 0.3s;
    }

    .sidebar h2 {
        text-align: center;
        padding: 20px 0;
        margin: 0;
        font-weight: bold;
    }

    .sidebar a {
        color: var(--sidebar-text);
        text-decoration: none;
        padding: 15px 20px;
        display: block;
        transition: 0.2s;
    }

    .sidebar a:hover {
        background: var(--sidebar-hover);
        padding-left: 25px;
    }

    /* CONTENIDO */
    .main-content {
        margin-left: 250px;
        padding: 20px;
        width: 100%;
    }

    /* TOP BAR */
    .topbar {
        background: white;
        padding: 10px 20px;
        border-bottom: 1px solid #ddd;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .sidebar {
            width: 70px;
        }

        .sidebar h2 {
            display: none;
        }

        .sidebar a {
            text-align: center;
            padding: 15px 5px;
        }

        .main-content {
            margin-left: 70px;
        }
    }
</style>
<body>
    <div class="sidebar">
        <h2>Xelaju Water</h2>

        <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill" style="font-size:1.5rem;"></i> Home</a>
        <a asp-controller="Transactions" asp-action="Index"><i class="bi bi-currency-exchange" style="font-size:1.5rem;"></i> Transactions</a>
        <a asp-controller="Clients" asp-action="Index"><i class="bi bi-people-fill" style="font-size:1.5rem;"></i> Clients</a>
        <a asp-controller="Intermediaries" asp-action="Index"><i class="bi bi-bank2" style="font-size:1.5rem;"></i> Intermediaries</a>
        <a asp-controller="Countries" asp-action="Index"><i class="bi bi-flag-fill" style="font-size:1.5rem;"></i> Countries</a>
        <a asp-controller="Users" asp-action="Index"><i class="bi bi-person-fill-gear" style="font-size:1.5rem;"></i> Users</a>
        <a asp-controller="Auth" asp-action="Login"><i class="bi bi-box-arrow-in-left" style="font-size:1.5rem;"></i> Log out</a>
    </div>

    <div class="main-content">
        <div class="topbar">
            <span>Welcome</span>
            <span>👤 Usuario</span>
        </div>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="border-top mt-4 pt-3 text-muted">
            &copy; 2026 - TransferApp
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
