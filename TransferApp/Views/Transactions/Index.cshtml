            $('#SimpleTx_SumAmount').val(totalAmount.toFixed(2));
            $('#SimpleTx_SumFees').val(totalFees.toFixed(2));
            //SE DESACTIVA EL PRIMERO PARA DEJAR EL NET AMOUNT PARA QUE SALGA EL RESTADO
            //$('#SimpleTx_GrandTotal').val(grandTotal.toFixed(2));
            $('#SimpleTx_GrandTotal').val(netAmount.toFixed(2));
            //SE DESACTIVA EL PRIMERO PARA DEJAR EL NET AMOUNT PARA QUE SALGA EL RESTADO
            $('#SimpleTx_NetAmountL').text(netAmount.toFixed(2));
        }
