                $('#btnSaveSimpleTx').click(async function () {

            // 🔵 VALIDACIONES FRONTEND (required *)
            let reference = $('#SimpleTx_ReferenceNumber').val().trim();
            let type = $('#SimpleTx_TransactionType').val();
            let company = $('#SimpleTx_Company').val();
            let amount = $('#SimpleTx_Amount').val();

            let senderName = $('#SimpleTx_SenderName').val().trim();
            let senderDocType = $('#SimpleTx_SenderDocumentType').val();
            let senderDocNumber = $('#SimpleTx_SenderDocumentNumber').val().trim();
            let senderPhone = $('#SimpleTx_SenderPhone').val().trim();
            let senderAddress = $('#SimpleTx_SenderAddress').val().trim();

            if (!reference) return Swal.fire('Error', 'Reference Number is required', 'error');
            if (!type) return Swal.fire('Error', 'Transaction Type is required', 'error');
            if (!company) return Swal.fire('Error', 'Company is required', 'error');
            if (!amount || amount <= 0) return Swal.fire('Error', 'Amount is required', 'error');

            if (!senderName) return Swal.fire('Error', 'Sender Name is required', 'error');
            if (!senderDocType) return Swal.fire('Error', 'Document Type is required', 'error');
            if (!senderDocNumber) return Swal.fire('Error', 'Document Number is required', 'error');
            if (!senderPhone) return Swal.fire('Error', 'Phone is required', 'error');
            if (!senderAddress) return Swal.fire('Error', 'Address is required', 'error');

            // 🔵 VALIDAR CLIENTE SELECCIONADO
            if (!SimpleTx_selectedClientId || SimpleTx_selectedClientId <= 0) {
                return Swal.fire('Error', 'Select a valid client', 'error');
            }

            // 🔵 RE-VALIDAR CLIENTE EN BACKEND (seguridad anti manipulación)
            let clientValidation = await $.get(
                '/Clients/GetById?id=' + SimpleTx_selectedClientId
            );

            if (!clientValidation || !clientValidation.idClient) {
                return Swal.fire('Error', 'Client no longer exists', 'error');
            }

            // 🔵 FORM DATA
            let formData = new FormData();

            formData.append("IdClient_fk", SimpleTx_selectedClientId);
            formData.append("ReferenceNumber", reference);
            formData.append("TransactionType", type);
            formData.append("Company", company);
            formData.append("Amount", amount);
            formData.append("Commission", $('#SimpleTx_Commission').val());
            formData.append("TotalAmount", $('#SimpleTx_TotalAmount').val());

            formData.append("SenderName", senderName);
            formData.append("SenderDocumentType", senderDocType);
            formData.append("SenderDocumentNumber", senderDocNumber);
            formData.append("SenderPhone", senderPhone);
            formData.append("SenderAddress", senderAddress);

            formData.append("JustifyDetails", $('#SimpleTx_JustifyDetails').val());
            formData.append("UserC", "admin");

            // 🔵 FILE (opcional)
            let file = $('#SimpleTx_File')[0].files[0];
            if (file) {
                formData.append("ImgJustify", file);
            }

            // 🔵 LOADING
            Swal.fire({
                title: 'Saving...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            // 🔵 AJAX
            $.ajax({
                url: '/Transactions/CreateSimpleTx',
                method: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function () {

                    $('#modalSimpleTx').modal('hide');

                    $('#formSimpleTx')[0].reset();

                    $('#SimpleTx_ImgPreview').hide();

                    SimpleTx_selectedClientId = 0;

                    Swal.fire({
                        icon: 'success',
                        title: 'Transaction saved',
                        timer: 1200,
                        showConfirmButton: false
                    });
                    $('#tblTx')
                        .DataTable()
                        .ajax.reload();

                },
                       error: function (err) {
            let msg = err.responseJSON?.message || 'Error';

            // 🔴 referencia duplicada
            if (msg.includes('Reference number already exists')) {
                Swal.fire('Duplicate', 'This reference number already exists', 'warning');
                return;
            }

            // 🔴 tipo inválido
            if (msg.includes('Invalid transaction type')) {
                Swal.fire('Error', 'Invalid transaction type', 'error');
                return;
            }

            // 🔴 mismatch total
            if (msg.includes('Total amount mismatch')) {
                Swal.fire('Warning', 'Amount was modified. Please recheck values.', 'warning');
                return;
            }

            Swal.fire('Error', msg, 'error');
        }
            });

        });
    </script>
