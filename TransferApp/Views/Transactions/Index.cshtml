        //GUARDAR SimpleTx o CHECK CASHING
            $('#btnSaveSimpleTx').click(async function () {
            let prefix = "SimpleTx_";
            // =========================================
            // BUILD CHECKS ARRAY
            // =========================================
            let checks = [];
            let totalAmountAML = 0;
            if (!validateCheckDates()) {
                return;
            }
            $('.simpletx-row').each(function () {
                let row = $(this)
                    let deductFeesB = $('#SimpleTx_DeductFees').is(':checked');
                let reference =row.find('.simpletx-reference').val()?.trim();
                let company =row.find('.simpletx-company').val();
                // let amount =parseFloat(row.find('.simpletx-amount').val()) || 0;
                let amount = deductFeesB? (parseFloat(row.data('.simpletx-net-amount')) || 0): (parseFloat(row.find('.simpletx-amount').val()) || 0);
                let commission = parseFloat(row.find('.simpletx-commission').val()) || 0;
                let fixed_commission = parseFloat(row.find('.simpletx-fixed').val()) || 0;
                let totalAmount = parseFloat(row.find('.simpletx-total').val()) || 0;
                let IssueDateC = row.find('.simpletx-issuedatecheck').val();
                let deductFees =  $('#SimpleTx_DeductFees').is(':checked') ? 2 : 1;
                // IGNORE EMPTY ROWS
                if (!reference && !company && amount <= 0) {
                    return;
                }
                checks.push({
                    ReferenceNumber: reference,
                    Company: parseInt(company),
                    Amount: amount,
                    Commission: commission,
                    TotalAmount: totalAmount,
                    FixedCommission:fixed_commission,
                    IssueDateCheck:IssueDateC,
                    CalculationMode:deductFees
                });
                
                totalAmountAML +=parseFloat($(this).find('.simpletx-amount').val()) || 0;
            });
            // =========================================
            // VALIDATE CHECKS
            // =========================================
            if (checks.length <= 0) {
                return Swal.fire('Error','At least one check is required','error');
            }
            // =========================================
            // GLOBAL FIELDS
            // =========================================
            let type =$('#' + prefix + 'TransactionType').val();
            let senderName = $('#' + prefix + 'SenderName').val().trim();
            let senderDocType = $('#' + prefix + 'SenderDocumentType').val();
            let senderDocNumber = $('#' + prefix + 'SenderDocumentNumber').val().trim();
            let senderPhone = $('#' + prefix + 'SenderPhone').val().trim();
            let senderAddress = $('#' + prefix + 'SenderAddress').val().trim();
            let justifyDetails = $('#' + prefix + 'JustifyDetails').val().trim();
            let justifyAgent =  $('#' + prefix + 'Justify_AgentName').val();
            let justifuDateError =  $('#' + prefix + 'Justify_DateError').val() || '';
            // =========================================
            // BASIC VALIDATIONS
            // =========================================
            if (!type)
                return Swal.fire('Error','Transaction Type is required','error');
            if (!senderName)
                return Swal.fire('Error','Sender Name is required','error');
            if (!senderDocType)
                return Swal.fire('Error','Document Type is required','error');
            if (!senderDocNumber)
                return Swal.fire('Error','Document Number is required','error');
            if (!senderPhone)
                return Swal.fire('Error','Phone is required','error');
            if (!senderAddress)
                return Swal.fire('Error','Address is required','error');
            // =========================================
            // VALIDATE EACH ROW
            // =========================================
            for (let i = 0; i < checks.length; i++) {
                let check = checks[i];
                if (!check.ReferenceNumber) {
                    return Swal.fire('Error',`Reference is required on row ${i + 1}`,'error');
                }
                if (!check.Company || check.Company <= 0) {
                    return Swal.fire('Error',`Company is required on row ${i + 1}`,'error');
                }
                if (!check.Amount || check.Amount <= 0) {
                    return Swal.fire('Error',`Amount is required on row ${i + 1}`,'error');
                }
            }

            // =========================================
            // CLIENT VALIDATION
            // =========================================
            if (
                !selectedClients[prefix] || selectedClients[prefix] <= 0
            ) {
                return Swal.fire('Error','Select a valid client','error');
            }
            let clientValidation = await $.get(
                '/Clients/GetById?id=' +
                selectedClients[prefix]
            );
            if (!clientValidation || !clientValidation.idClient
            ) {
                return Swal.fire('Error','Client no longer exists','error');
            }
            // =========================================
            // AML VALIDATION
            // =========================================
            let validation = await $.get(
                '/Parameters/ValidateClientTransactions' +
                '?documentNumber=' + selectedClients[prefix] +
                '&TransactionType=' + type
            );
            let warnings = [];
            let futureAmount = parseFloat(validation.totalAmount || 0) + totalAmountAML;
            let futureTransactions = parseInt(validation.totalTransactions || 0) + checks.length;
            if (futureAmount > validation.maxAmount) {
                warnings.push(`
                    Maximum amount exceeded.<br>
                    Current Total:
                    <b>$${futureAmount.toFixed(2)}</b><br>
                    Allowed:
                    <b>$${parseFloat(validation.maxAmount).toFixed(2)}</b>
                `);
            }
            if (
                futureTransactions >
                validation.maxTransactions
            ) {
                warnings.push(`
                    Maximum transactions exceeded.<br>
                    Current Transactions:
                    <b>${futureTransactions}</b><br>
                    Allowed:
                    <b>${validation.maxTransactions}</b>
                `);
            }
            // =========================================
            // AML REQUIREMENTS
            // =========================================
            if (warnings.length > 0) {
                let validAML =CCvalidateAMLRequiredFields();
                if (!validAML)
                    return;
                let accepted =await CCconfirmAMLWarnings(warnings);
                if (!accepted)
                    return;
            }
            // =========================================
            // BUILD FORM DATA
            // =========================================
            let formData = new FormData();
            formData.append("IdClient_fk",selectedClients[prefix]);
            formData.append("TransactionType",type);
            formData.append("SenderName",senderName);
            formData.append("SenderDocumentType",senderDocType);
            formData.append("SenderDocumentNumber",senderDocNumber);
            formData.append("SenderPhone",senderPhone);
            formData.append("SenderAddress",senderAddress);
            formData.append("JustifyDetails",justifyDetails);
            formData.append("Justify_AgentName",justifyAgent);
            formData.append("Justify_DateError",justifuDateError);
            formData.append("UserC","admin");

            // =========================================
            // SEND CHECKS ARRAY
            // =========================================
            formData.append(
                "Checks",
                JSON.stringify(checks)
            );

            // =========================================
            // ATTACHMENTS
            // =========================================
            $('.SimpleTx_justify-file').each(function () {
                if (this.files.length > 0) {
                    formData.append(
                        'SimpleTx_ImgJustify',
                        this.files[0]
                    );
                }
            });
            // =========================================
            // LOADING
            // =========================================
            Swal.fire({title: 'Saving...',allowOutsideClick: false,didOpen: () => Swal.showLoading()});
            // =========================================
            // AJAX
            // =========================================
            $.ajax({
                url: '/Transactions/CreateSimpleTx',
                method: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function () {
                    // $('#modalSimpleTx').modal('hide');
                    // $('#formSimpleTx')[0].reset();
