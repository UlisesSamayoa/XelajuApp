                function calculateCheckCommission(row) {

            let commissionInput = row.find('.simpletx-commission');

            let amount =
                parseFloat(row.find('.simpletx-amount').val()) || 0;

            let ranges =
                $('#SimpleTx_TransactionType').data('ranges');

            if (!ranges || ranges.length === 0) {

                commissionInput.val('');
                row.find('.simpletx-totalfee').val('');
                row.find('.simpletx-total').val('');
                row.data('.simpletx-net-amount', 0);

                return;
            }

            // Buscar Federal (%)
            let federalRange = ranges.find(r =>
                Number(r.commissionType) === 0 &&
                amount >= parseFloat(r.minAmount) &&
                amount <= parseFloat(r.maxAmount)
            );

            // Buscar Fee (Monto fijo)
            let feeRange = ranges.find(r =>
                Number(r.commissionType) === 1 &&
                amount >= parseFloat(r.minAmount) &&
                amount <= parseFloat(r.maxAmount)
            );

            //-----------------------------------
            // Federal
            //-----------------------------------

            let federalPercent = 0;
            let federalAmount = 0;

            if (federalRange) {

                federalPercent =
                    parseFloat(federalRange.commissionPercent);

                federalAmount =
                    amount * (federalPercent / 100);
            }

            //-----------------------------------
            // Fee
            //-----------------------------------

            let feeAmount = 0;

            if (feeRange) {

                feeAmount =
                    parseFloat(feeRange.commissionPercent);

            }

            //-----------------------------------
            // Totales
            //-----------------------------------

            let totalFee =
                federalAmount +
                feeAmount;

            let netAmount =
                amount - totalFee;

            if (netAmount < 0)
                netAmount = 0;

            //-----------------------------------
            // Mostrar información
            //-----------------------------------

            commissionInput.val(federalAmount.toFixed(2));

            commissionInput.attr(
                'title',
                `Federal: ${federalPercent.toFixed(2)}% = $${federalAmount.toFixed(2)}
        Fee: $${feeAmount.toFixed(2)}
        Total Fee: $${totalFee.toFixed(2)}`
            );
            row.data('.simpletx-net-amount', netAmount);
            row.find('.simpletx-totalfee').val(totalFee.toFixed(2));
            row.find('.simpletx-fixed').val(feeAmount.toFixed(2));
            row.find('.simpletx-total').val(netAmount.toFixed(2));
            row.find('.simpletx-amount').attr('title',`Net Amount: ${netAmount.toFixed(2)}`);
        }

        function calculateChecksTotals() {
            let totalAmount = 0;
            let totalFees = 0;
            let grandTotal = 0;
            let netAmount = 0;
            $('.simpletx-row').each(function () {
                let row = $(this);
                totalAmount +=parseFloat(row.find('.simpletx-amount').val()) || 0;
                totalFees +=parseFloat(row.find('.simpletx-totalfee').val()) || 0;
                grandTotal +=parseFloat(row.find('.simpletx-total').val()) || 0;
                netAmount +=parseFloat(row.data('.simpletx-net-amount')) || 0;
