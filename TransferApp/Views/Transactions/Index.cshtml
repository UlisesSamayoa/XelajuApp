    </div>
</div>
<div class="modal fade" id="modalTxDetails">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content p-3">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Transaction Details</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <hr>

            <!-- SUMMARY CARD -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="card shadow-sm p-2">
                        <small class="text-muted">Reference</small>
                        <b id="dReference"></b>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm p-2">
                        <small class="text-muted">Amount</small>
                        <b id="dAmount"></b>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm p-2">
                        <small class="text-muted">Commission</small>
                        <b id="dCommission"></b>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm p-2 bg-light">
                        <small class="text-muted">Total</small>
                        <b id="dTotal"></b>
                    </div>
                </div>
            </div>

            <!-- SENDER & RECEIVER -->
            <div class="row">

                <!-- SENDER -->
                <div class="col-md-6">
                    <div class="card p-3 shadow-sm">
                        <h6 class="text-primary">Sender</h6>

                        <p class="mb-1"><b>Name:</b> <span id="dSender"></span></p>
                        <p class="mb-1"><b>Document:</b> <span id="dSenderDoc"></span></p>
                        <p class="mb-1"><b>Phone:</b> <span id="dSenderPhone"></span></p>
                        <p class="mb-1"><b>Address:</b> <span id="dSenderAddress"></span></p>
                        <p class="mb-0"><b>Country:</b> <span id="dSenderCountry"></span></p>
                    </div>
                </div>

                <!-- RECEIVER -->
                <div class="col-md-6">
                    <div class="card p-3 shadow-sm">
                        <h6 class="text-success">Receiver</h6>

                        <p class="mb-1"><b>Name:</b> <span id="dReceiver"></span></p>
                        <p class="mb-1"><b>Document:</b> <span id="dReceiverDoc"></span></p>
                        <p class="mb-1"><b>Phone:</b> <span id="dReceiverPhone"></span></p>
                        <p class="mb-1"><b>Address:</b> <span id="dReceiverAddress"></span></p>
                        <p class="mb-0"><b>Country:</b> <span id="dReceiverCountry"></span></p>
                    </div>
                </div>

            </div>

            <!-- JUSTIFICATION -->
            <div class="row mt-3">

                <div class="col-md-6">
                    <div class="card p-3 shadow-sm">
                        <h6>AML Justification</h6>
                        <p id="dJustify"></p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card p-3 shadow-sm text-center">
                        <h6>Evidence</h6>
                        <img id="imgJustifyPreview"
                             class="img-fluid rounded border"
                             style="max-height:250px; object-fit:contain;">
                    </div>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="text-end mt-3">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

@* MODAL DE OTRAS TRANASCCIONES *@
<div class="modal fade" id="modalSimpleTx">
    <div class="modal-dialog modal-xl">
        <div class="modal-content card-custom p-3">

            <h5>New Transaction</h5>

            <form id="formSimpleTx">

                <!-- 🔵 HEADER -->
                <div class="row">
                    <div class="col-3">
                        <label class="form-label">Reference Number *</label>
                        <input id="SimpleTx_ReferenceNumber" class="form-control mb-2" placeholder="Reference Number" />
                    </div>
                    <div class="col-2">
                        <label class="form-label">Transaction Type *</label>
                        <select id="SimpleTx_TransactionType" class="form-control mb-2"></select>
                    </div>
                    <div class="col-2">
                        <label class="form-label">Company *</label>
                        <select id="SimpleTx_Company" class="form-control mb-2"></select>
                    </div>

                    <div class="col-2">
                        <label class="form-label">Amount *</label>
                        <input id="SimpleTx_Amount" type="number" class="form-control mb-2" placeholder="Amount"/>
                    </div>

                    <div class="col-1">
                        <label class="form-label">Commission</label>
                        <input id="SimpleTx_Commission" type="number" class="form-control mb-2" readonly placeholder="0.0" />
                    </div>
                    <div class="col-2">
                        <label class="form-label">Total Amount</label>
                        <input id="SimpleTx_TotalAmount" type="number" class="form-control mb-2" readonly placeholder="0.0" />
                    </div>

                </div>
                <hr />
                <div class="row">
                    <div class="input-group" style="margin-bottom:5px;">
                        <h6>Sender Info </h6> &nbsp;&nbsp;&nbsp;
                        <button type="button" class="btn btn-primary btn-sm" onclick="loadModalSearchClientSimpleTx()">
                            Search Client <i class="bi bi-search"></i>
                        </button>&nbsp;&nbsp;&nbsp;
                        <button type="button" class="btn btn-success" onclick="loadModalNewClientSimpleTx()">
                            New Client <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div class="col-4">
                        <label class="form-label">Sender Name *</label>
                        <input id="SimpleTx_SenderName" class="form-control mb-2" placeholder="Client Name" />
                    </div>
                    <div class="col-3">
                        <label class="form-label">Sender DocumentType *</label>
                        <select id="SimpleTx_SenderDocumentType" class="form-control mb-2"></select>
                    </div>
                    <div class="col-3">
                        <label class="form-label">Sender Document Number *</label>
                        <input id="SimpleTx_SenderDocumentNumber" class="form-control mb-2" placeholder="Document" />
                    </div>
                    <div class="col-2">
                        <label class="form-label">Sender Phone *</label>
                        <input id="SimpleTx_SenderPhone" class="form-control mb-2" placeholder="Phone" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Sender Address *</label>
                        <input id="SimpleTx_SenderAddress" class="form-control mb-2" placeholder="Address" />
                    </div>
                </div>
                <hr />
                <div class="row">

                    <div class="col-12">
                        <label class="form-label">Notes / Justification</label>
                        <input id="SimpleTx_JustifyDetails" class="form-control mb-2" />
                    </div>

                </div>
                <div class="row">

                    <div class="col-12">
                        <label class="form-label">Attachment</label>
                        <input type="file"
                               class="form-control"
                               id="SimpleTx_File"
                               onchange="previewSimpleTxImage(this)" />
                    </div>

                    <div class="col-12 mt-2">
                        <img id="SimpleTx_ImgPreview"
                             class="img-preview"
                             style="max-width:200px; display:none;" />
                    </div>

                </div>

            </form>

            <div class="modal-footer">
                <button class="btn btn-custom" id="btnSaveSimpleTx">
                    <i class="bi bi-floppy-fill"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="SimpleTx_modalSearchClient">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-search">

            <!-- HEADER -->
            <div class="modal-header modal-search-header">
