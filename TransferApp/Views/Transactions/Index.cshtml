                        </div>

                        <div class="col-md-6">
                            <label>Last Name</label>
                            <input id="SimpleTx_C_LastName" class="form-control mb-2" placeholder="Last Name" />
                        </div>

                        <div class="col-md-4">
                            <label>Document Type</label>
                            <select id="SimpleTx_C_DocumentType" class="form-control mb-2"></select>
                        </div>

                        <div class="col-md-4">
                            <label>Document Number</label>
                            <input id="SimpleTx_C_DocumentNumber" class="form-control mb-2" placeholder="Document Number" />
                        </div>

                        <div class="col-md-4">
                            <label>Expiration Date</label>
