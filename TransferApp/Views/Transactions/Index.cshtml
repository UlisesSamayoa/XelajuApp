                function loadTransactionAttachments(idTransaction) {

            $.get('/Transactions/GetAttachments?idTransaction=' + idTransaction, function (files) {
                $('#dEvidenceCount').text(files.length);
                let container = $('#evidenceContainer');
                container.empty();
                if (files.length === 0) {
                    container.html(`
                        <div class="col-12 text-center text-muted py-4">
                            <i class="bi bi-images fs-1"></i>
                            <br>
                            No evidence available.
                        </div>
                    `);
                    return;
                }
                files.forEach(file => {
                    container.append(`
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="card shadow-sm h-100">
                                <img
                                    src="/Transactions/ViewAttachment?id=${file.idTransactionAttachment}"
                                    class="card-img-top"
                                    style="height:180px;object-fit:cover;cursor:pointer"
                                    onclick="window.open('/Transactions/ViewAttachment?id=${file.idTransactionAttachment}','_blank')">
                                <div class="card-body text-center">
                                    <small class="text-muted d-block mb-2">
                                        ${file.originalFileName}
                                    </small>
                                    <a
                                        href="/Transactions/DownloadAttachment?id=${file.idTransactionAttachment}"
                                        class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    `);
                });
            });
        }



