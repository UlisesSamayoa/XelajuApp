                function calculateCommission() {

            let amount = parseFloat($('#Amount').val()) || 0;

            let commissionInput = $('#Commission');

            let ranges = $('#TransactionType').data('ranges');

            if (!ranges || ranges.length === 0) {

                $('#Commission').val('');
                $('#FixedCommission').val('');
                $('#TotalCommission').val('');
                $('#TotalAmount').val('');
                $('#NetAmount').val('');
                $('#CommissionL').text('0');

                return;
            }

            //-------------------------------------------------
            // TIPO 0 -> Comisiones porcentuales
            //-------------------------------------------------

            let percentageRanges = ranges.filter(r =>
                Number(r.commissionType) === 0 &&
                amount >= parseFloat(r.minAmount) &&
                amount <= parseFloat(r.maxAmount)
            );

            let commissionPercent = 0;

            percentageRanges.forEach(r => {
                commissionPercent += parseFloat(r.commissionPercent);
            });

            $('#CommissionL').text(commissionPercent.toFixed(2));

            let commission = 0;

            if (commissionInput.data('auto') !== false) {

                commission = amount * (commissionPercent / 100);

                commissionInput.val(
                    commission.toFixed(2)
                );

            }
            else {

                commission =
                    parseFloat(commissionInput.val()) || 0;

            }

            //-------------------------------------------------
            // TIPO 1 -> Fee fijo
            //-------------------------------------------------

            let feeRanges = ranges.filter(r =>
                Number(r.commissionType) === 1 &&
                amount >= parseFloat(r.minAmount) &&
                amount <= parseFloat(r.maxAmount)
            );

            let fixedCommission = 0;

            feeRanges.forEach(r => {
                fixedCommission += parseFloat(r.commissionPercent);
            });

            $('#FixedCommission').val(
                fixedCommission.toFixed(2)
            );

            //-------------------------------------------------
            // Totales
            //-------------------------------------------------

            let totalCommission =
                commission + fixedCommission;

            let deductFees =
                $('#DeductFees').is(':checked');

            let totalAmount = 0;
            let netAmount = 0;

            if (!deductFees) {

                netAmount = amount;

                totalAmount =
                    amount + totalCommission;

            }
            else {

                totalAmount = amount;

                netAmount =
                    amount - totalCommission;

                if (netAmount < 0)
                    netAmount = 0;

            }

            //-------------------------------------------------
            // Mostrar resultados
            //-------------------------------------------------

            $('#Commission').val(
                commission.toFixed(2)
            );

            $('#TotalCommission').val(
                totalCommission.toFixed(2)
            );

            $('#TotalAmount').val(
                totalAmount.toFixed(2)
            );

            $('#NetAmount').val(
                netAmount.toFixed(2)
            );

            $('#NetAmountL').text(
                netAmount.toFixed(2)
            );

        }

