                function loadTransactions() {

            return $('#tblTx').DataTable({

                ajax: {
                    url: '/Transactions/GetAll',
                    type: 'GET',
                    dataSrc: ''
                },
                columns: [
                    {
                        data: 'referenceNumber'
                    },
                    {
                        data: 'senderDocumentNumber'
                    },
                    {
                        data: 'senderName',
                        render: d =>
                            `<b>${d}</b>`
                    },
                    {
                        data: 'senderCompanyName',
                    },
                    {
                        data: 'transactionTypeName'
                    },
                    {
                    data: 'transactionStatus',
                    render: function (data) {

                        let badgeClass = 'bg-secondary';
                        let icon = 'bi-question-circle';

                        switch (data) {

                            case 'Completed':
                                badgeClass = 'bg-success';
                                icon = 'bi-check-circle-fill';
                                break;

                            case 'Pending':
                                badgeClass = 'bg-warning text-dark';
                                icon = 'bi-clock-fill';
                                break;

                            case 'Rejected':
                                badgeClass = 'bg-danger';
                                icon = 'bi-x-circle-fill';
                                break;
                        }

                        return `
                            <span class="badge ${badgeClass}"
                                  style="
                                    padding:8px 12px;
                                    font-size:13px;
                                    border-radius:20px;
                                    min-width:110px;
                                    display:inline-block;
                                    text-align:center;
                                  ">
                                <i class="bi ${icon}"></i>
                                ${data}
                            </span>
                        `;
                    }
                },
                    {
                        data: 'amount',
                        render: d =>
