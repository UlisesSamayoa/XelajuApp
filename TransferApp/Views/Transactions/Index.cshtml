@{
    ViewData["Title"] = "Transactions";
}

<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
    }

    .img-preview {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
        margin-top: 10px;
    }

    .modal-search {
        background: #f8fafc; /* gris claro elegante */
        border-radius: 15px;
        border: 2px solid #4f46e5;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

    .modal-new {
        background: #f8fafc; /* gris claro elegante */
        border-radius: 15px;
        border: 2px solid #154719;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

    /* header con identidad */
    .modal-search-header {
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        color: white;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    /* input más elegante */
    .search-input {
        border-radius: 10px;
        border: 1px solid #cbd5f5;
    }

    /* hover tabla más pro */
    #tblSearchClient tbody tr:hover {
        background-color: #eef2ff;
        cursor: pointer;
    }
</style>

<div class="container-fluid mt-4 px-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between mb-3">
            <h3><i class="bi bi-currency-exchange" "></i> Transactions</h3>

            <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalTx">
                <i class="bi bi-plus"></i> New Transaction
            </button>
        </div>

        <table id="tblTx" class="table table-hover w-100">
            <thead class="table-light">
                <tr>
                    <th>Reference</th>
                    <th>Sender</th>
                    <th>Receiver</th>
                    <th>Country</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>
<div class="modal fade" id="modalTx">
    <div class="modal-dialog modal-xl">
        <div class="modal-content card-custom p-3">

            <h5>New Transaction</h5>

            <form id="formTx">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-3">
                                <label class="form-label">Reference Number</label>
                                <input id="ReferenceNumber" class="form-control mb-2" placeholder="Reference Number" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Amount</label>
                                <input id="Amount" type="number" class="form-control mb-2" placeholder="Amount" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Transaction Type</label>
                                <input id="TransactionType" type="text" class="form-control mb-2" placeholder="Transaction Type" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Currency</label>
                                <select id="Currency" class="form-control mb-2"></select>
                            </div>
                        </div>
                    </div>
                </div>
                <hr />

                <div class="row">
                    <div class="col-12">
                        <div class="input-group" style="margin-bottom:5px;">
                            <h6>Sender Info </h6> &nbsp;&nbsp;&nbsp;
                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSearchClient">
                                Search Client <i class="bi bi-search"></i>
                            </button>&nbsp;&nbsp;&nbsp;
                            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalNewClient">
                                New Client <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="col-12">
                            <div class="row">
                                <div class="col-4">
                                    <label class="form-label">Country</label>
                                    <select id="SenderCountry" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Company</label>
                                    <select id="SenderCompany" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Currency</label>
                                    <select id="SenderCurrency" class="form-control mb-2"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <label class="form-label">Sender Name</label>
                                <input id="SenderName" class="form-control mb-2" placeholder="Sender Name" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Sender DocumentType</label>
                                <select id="SenderDocumentType" class="form-control mb-2"></select>
                            </div>
                            <div class="col-3">
                                <label class="form-label">Sender Document Number</label>
                                <input id="SenderDocumentNumber" class="form-control mb-2" placeholder="Document" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Sender Phone</label>
                                <input id="SenderPhone" class="form-control mb-2" placeholder="Phone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Sender Address</label>
                                <input id="SenderAddress" class="form-control mb-2" placeholder="Address" />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="col-12">
                        <div class="input-group" style="margin-bottom:5px;">
                            <h6>Receiver Info</h6> &nbsp;&nbsp;&nbsp;
                            @* <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSearchBeneficiaries">
                                Beneficiaries <i class="bi bi-search"></i> <label id="CantBeneficiariesXClient"></label>
                            </button>&nbsp;&nbsp;&nbsp;
                            <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalNewBeneficiary">
                                New Beneficiary <i class="bi bi-plus-lg"></i>
                            </button> *@
                            <button id="btnOpenBeneficiaries" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSearchBeneficiaries" disabled>
                                Beneficiaries <i class="bi bi-search"></i> <label id="CantBeneficiariesXClient"></label>
                            </button>

                            <button id="btnNewBeneficiary" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewBeneficiary" disabled>
                                New Beneficiary <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="col-12">
                            <div class="row">
                                <div class="col-4">
                                    <label class="form-label">Country</label>
                                    <select id="ReceiverCountry" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Company</label>
                                    <select id="ReceiverCompany" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Currency</label>
                                    <select id="ReceiverCurrency" class="form-control mb-2"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <label class="form-label">Receiver Name</label>
                                <input id="ReceiverName" class="form-control mb-2" placeholder="Receiver Name" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Receiver DocumentType</label>
                                <select id="ReceiverDocumentType" class="form-control mb-2"></select>
                            </div>
                            <div class="col-3">
                                <label class="form-label">Receiver Document Number</label>
                                <input id="ReceiverDocumentNumber" class="form-control mb-2" placeholder="Document" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Receiver Phone</label>
                                <input id="ReceiverPhone" class="form-control mb-2" placeholder="Phone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Receiver Address</label>
                                <input id="ReceiverAddress" class="form-control mb-2" placeholder="Address" />
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="col-12">
                    <label class="form-label">Justify Details</label>
                    <input id="JustifyDetails" class="form-control mb-2" placeholder="Address" />
                </div>
                <hr />
                <input type="file" class="form-control" onchange="previewImage(this)" />
                <img id="imgPreview" class="img-preview" />

            </form>
            <div class="modal-footer">
                <button class="btn btn-custom" id="btnSaveTx"><i class="bi bi-floppy-fill"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSearchClient">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-search">

            <!-- HEADER -->
            <div class="modal-header modal-search-header">
                <h5><i class="bi bi-search"></i> Search Client</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <input id="searchClientInput"
                       class="form-control mb-3 search-input"
                       placeholder="Search by name or document..." />

                <table id="tblSearchClient" class="table table-hover w-100">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Document</th>
                            <th>Phone</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                </table>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="modalNewClient">
    <div class="modal-dialog modal-lg">
        <div class="modal-content card-custom modal-new">

            <div class="modal-header bg-success text-white">
                <h5><i class="bi bi-person-plus-fill"></i> New Client</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="formNewClient">

                    <div class="row">
                        <div class="col-md-6">
                            <label>First Name</label>
                            <input id="C_FirstName" class="form-control mb-2" placeholder="First Name" />
                        </div>

                        <div class="col-md-6">
                            <label>Last Name</label>
                            <input id="C_LastName" class="form-control mb-2" placeholder="Last Name" />
                        </div>

                        <div class="col-md-4">
                            <label>Document Type</label>
                            <select id="C_DocumentType" class="form-control mb-2"></select>
                        </div>

                        <div class="col-md-4">
                            <label>Document Number</label>
                            <input id="C_DocumentNumber" class="form-control mb-2" placeholder="Document Number" />
                        </div>

                        <div class="col-md-4">
                            <label>Expiration Date</label>
                            <input type="date" id="C_ExpirationDate" class="form-control mb-2" />
                        </div>

                        <div class="col-md-6">
                            <label>Phone</label>
                            <input id="C_Phone" class="form-control mb-2" placeholder="Phone" />
                        </div>

                        <div class="col-md-6">
                            <label>Country</label>
                            <select id="C_Country" class="form-control mb-2"></select>
                        </div>

                        <div class="col-12">
                            <label>Address</label>
                            <input id="C_Address" class="form-control mb-2" placeholder="Address" />
                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success" id="btnSaveNewClient">
                    <i class="bi bi-floppy-fill"></i> Save Client
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalSearchBeneficiaries">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-search">

            <div class="modal-header modal-search-header">
                <h5>Beneficiaries</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <table id="tblBeneficiaries" class="table table-hover w-100">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Document</th>
                            <th>Country</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalNewBeneficiary">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-new">

            <div class="modal-header bg-success text-white">
                <h5><i class="bi bi-person-plus"></i> New Beneficiary</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="formNewBeneficiary">

                    <div class="row">
                        <div class="col-6">
                            <label>First Name</label>
                            <input id="B_FirstName" class="form-control mb-2" placeholder="First Name"/>
                        </div>

                        <div class="col-6">
                            <label>Last Name</label>
                            <input id="B_LastName" class="form-control mb-2" placeholder="Last Name" />
                        </div>

                        <div class="col-4">
                            <label>Document Type</label>
                            <select id="B_DocumentType" class="form-control mb-2"></select>
                        </div>

                        <div class="col-4">
                            <label>Document Number</label>
                            <input id="B_DocumentNumber" class="form-control mb-2" placeholder="Document Number" />
                        </div>

                        <div class="col-4">
                            <label>Country</label>
                            <select id="B_Country" class="form-control mb-2"></select>
                        </div>
                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success" id="btnSaveBeneficiary">
                    <i class="bi bi-floppy-fill"></i> Save Beneficiary
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
                let tableTx;

        $(document).ready(function () {

            tableTx = loadTransactions();
            loadCountries();
            loadDocumentTypes();

        });
                document.querySelectorAll('.btn').forEach(btn => {
          btn.addEventListener('click', function(event) {
            event.preventDefault(); // evita el submit
          });
        });

        //         $('#modalNewClient').on('shown.bs.modal', function () {

        //     // loadCountriesInto('#C_Country');
        //     // loadDocumentTypesInto('#C_DocumentType');

        // });

        function loadTransactions() {

            return $('#tblTx').DataTable({
                ajax: {
                    url: '/Transactions/GetAll',
                    type: 'GET',
                    dataSrc: ''
                },
                columns: [

                    { data: 'referenceNumber' },

                    {
                        data: 'senderName',
                        render: d => `<b>${d}</b>`
                    },

                    {
                        data: 'receiverName',
                        render: d => `<span class="text-primary">${d}</span>`
                    },

                    { data: 'receiverCountry' },

                    {
                        data: 'amount',
                        render: d => `$ ${parseFloat(d).toFixed(2)}`
                    },

                    {
                        data: 'status',
                        render: s => s === 1
                            ? '<span class="badge bg-success">Completed</span>'
                            : '<span class="badge bg-secondary">Cancelled</span>'
                    },

                    {
                        data: 'idTransaction',
                        orderable: false,
                        render: id => `
                            <div class="d-flex gap-2">
                                <button class="btn btn-danger btn-sm" onclick="deleteTx(${id})">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        `
                    }

                ],

                order: [[0, 'desc']],

                language: {
                    emptyTable: "No transactions yet",
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    loadingRecords: "Loading...",
                    zeroRecords: "No matches found"
                },

                drawCallback: function () {
                    $('#tblTx tbody tr').addClass('fade-in');
                }
            });
        }


                function deleteTx(id) {

            Swal.fire({
                title: 'Delete transaction?',
                text: 'This action will deactivate the transaction',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete'
            }).then(result => {

                if (result.isConfirmed) {

                    $.post('/Transactions/Delete', { id }, function () {

                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            timer: 1200,
                            showConfirmButton: false
                        });

                        tableTx.ajax.reload();

                    }).fail(err => {

                        Swal.fire('Error', err.responseText, 'error');

                    });

                }
            });
        }

                function loadCountries() {

            $.get('/Countries/GetAll', function (data) {

                $('#SenderCountry, #ReceiverCountry, #C_Country,#B_Country').empty();

                data.forEach(c => {

                    $('#SenderCountry, #ReceiverCountry, #C_Country,#B_Country').append(
                        `<option value="${c.idCountry}">${c.name}</option>`
                    );

                });

                // 🔥 dispara carga inicial dependiente
                loadCompaniesByCountry($('#SenderCountry').val(), 'Sender');
                loadCompaniesByCountry($('#ReceiverCountry').val(), 'Receiver');

                loadCurrencyByCountry($('#SenderCountry').val(), 'Sender');
                loadCurrencyByCountry($('#ReceiverCountry').val(), 'Receiver');

            });

        }

                function loadCompaniesByCountry(countryId, type) {

            $.get('/Companies/GetByCountry?countryId=' + countryId, function (data) {

                let select = type === 'Sender'
                    ? $('#SenderCompany')
                    : $('#ReceiverCompany');

                select.empty();

                data.forEach(c => {

                    select.append(
                        `<option value="${c.idCompany}">${c.name}</option>`
                    );

                });

            });

        }

                function loadCurrencyByCountry(countryId, type) {

            $.get('/Countries/GetById?id=' + countryId, function (c) {

                let select = type === 'Sender'
                    ? $('#SenderCurrency')
                    : $('#ReceiverCurrency');

                select.empty();

                select.append(
                    `<option value="${c.idCountry}">${c.currency}</option>`
                );

            });

        }

                function loadDocumentTypes() {

            $.get('/DocumentsTypes/GetAll', function (data) {

                $('#SenderDocumentType, #ReceiverDocumentType').empty();

                data.forEach(d => {

                    $('#SenderDocumentType, #ReceiverDocumentType, #C_DocumentType,#B_DocumentType').append(
                        `<option value="${d.idDocumentType}">${d.name}</option>`
                    );

                });

            });

        }

                $('#SenderCountry').change(function () {

            let id = $(this).val();

            loadCompaniesByCountry(id, 'Sender');
            loadCurrencyByCountry(id, 'Sender');

        });

        $('#ReceiverCountry').change(function () {

            $('#ReceiverCompany').empty();
            $('#ReceiverCurrency').empty();
            let id = $(this).val();

            loadCompaniesByCountry(id, 'Receiver');
            loadCurrencyByCountry(id, 'Receiver');

        });

                $('#SenderCountry').change(function () {

            $('#SenderCompany').empty();
            $('#SenderCurrency').empty();

            let id = $(this).val();

            loadCompaniesByCountry(id, 'Sender');
            loadCurrencyByCountry(id, 'Sender');

        });

        let tableSearchClient;
        let selectedClientId = null;
                $(document).ready(function () {
            toggleBeneficiariesActions();
        });

        function loadSearchClient() {

            tableSearchClient = $('#tblSearchClient').DataTable({
                ajax: {
                    url: '/Clients/Search',
                    data: function (d) {
                        d.term = $('#searchClientInput').val();
                    },
                    dataSrc: ''
                },
                columns: [
                    {
                        data: null,
                        render: d => `<b>${d.firstName} ${d.lastName}</b>`
                    },
                    { data: 'documentNumber' },
                    { data: 'phone' },
                    {
                        data: 'idClient',
                        render: id => `
                            <button class="btn btn-success btn-sm"
                                onclick="selectClient(${id})">
                                Select
                            </button>
                        `
                    }
                ]
            });

        }

                let timer;

        $('#searchClientInput').on('keyup', function () {

            clearTimeout(timer);

            timer = setTimeout(() => {
                tableSearchClient.ajax.reload();
            }, 400);

        });

                        function selectClient(id) {

            $.get('/Clients/GetById?id=' + id, function (c) {

                selectedClientId = c.idClient;
                $('#SenderName').val(c.firstName + ' ' + c.lastName);
                $('#SenderDocumentNumber').val(c.documentNumber);
                $('#SenderPhone').val(c.phone);
                $('#SenderAddress').val(c.address);
                $('#SenderDocumentType').val(c.idDocumentType);
                $('#SenderCountry').val(c.country).trigger('change');
                setTimeout(() => {
                    loadCompaniesByCountry(c.country, 'Sender');
                    loadCurrencyByCountry(c.country, 'Sender');

                }, 200);
                loadBeneficiariesCount(c.idClient);
                toggleBeneficiariesActions();
                $('#modalSearchClient').modal('hide');
                Swal.fire({
                    icon: 'success',
                    title: 'Client loaded',
                    timer: 1000,
                    showConfirmButton: false
                });

            });

        }

                function loadBeneficiariesCount(clientId) {

            $.get('/Beneficiaries/GetByClient?id=' + clientId, function (data) {

                $('#CantBeneficiariesXClient').text(`(${data.length})`);

            });

        }

        // let autoTimer;

        //         $('#SenderName, #SenderDocumentNumber').on('keyup', function () {

        //     clearTimeout(autoTimer);

        //     autoTimer = setTimeout(() => {

        //         let term = $('#SenderName').val() || $('#SenderDocumentNumber').val();

        //         if (!term || term.length < 3) return;

        //         $.get('/Clients/Search?term=' + term, function (data) {

        //             if (data.length === 1) {

        //                 let c = data[0];

        //                 selectedClientId = c.idClient;

        //                 $('#SenderName').val(c.firstName + ' ' + c.lastName);
        //                 $('#SenderDocumentNumber').val(c.documentNumber);
        //                 $('#SenderPhone').val(c.phone);
        //                 $('#SenderAddress').val(c.address);

        //                 // 🔥 NUEVO
        //                 $('#SenderDocumentType').val(c.idDocumentType);
        //                 $('#SenderCountry').val(c.country).trigger('change');

        //                 setTimeout(() => {
        //                     loadCompaniesByCountry(c.country, 'Sender');
        //                     loadCurrencyByCountry(c.country, 'Sender');
        //                 }, 200);

        //                 loadBeneficiariesCount(c.idClient);

        //             }

        //         });

        //     }, 500);

        // });
                let autoTimer;

        // 🔥 limpiar selección si el usuario modifica
        $('#SenderName, #SenderDocumentNumber').on('input', function () {
            selectedClientId = null;
        });

        $('#SenderName, #SenderDocumentNumber').on('keyup', function () {
            clearTimeout(autoTimer);
            let input = $(this);
            let term = input.val().trim();

            autoTimer = setTimeout(() => {
                if (!term || term.length < 3) return;
                if (selectedClientId && term.length < 5) return;
                $.get('/Clients/Search?term=' + term, function (data) {

                    if (data.length === 1) {

                        let c = data[0];

                        selectedClientId = c.idClient;

                        // 🔥 llenar sender
                        $('#SenderName').val(c.firstName + ' ' + c.lastName);
                        $('#SenderDocumentNumber').val(c.documentNumber);
                        $('#SenderPhone').val(c.phone);
                        $('#SenderAddress').val(c.address);

                        // 🔥 selects
                        $('#SenderDocumentType').val(c.idDocumentType);
                        $('#SenderCountry').val(c.country).trigger('change');

                        // 🔥 cargar dependencias del país
                        setTimeout(() => {
                            loadCompaniesByCountry(c.country, 'Sender');
                            loadCurrencyByCountry(c.country, 'Sender');
                        }, 200);

                        // 🔥 beneficiaries
                        loadBeneficiariesCount(c.idClient);

                        // 💥 feedback opcional
                        console.log('Client auto-selected:', c.firstName);
                        toggleBeneficiariesActions();

                    }

                });

            }, 500);

        });

                $('#modalSearchClient').on('shown.bs.modal', function () {

            if (!tableSearchClient) {
                loadSearchClient();
            } else {
                tableSearchClient.ajax.reload();
            }

        });
                function loadCountriesInto(selector) {

            $.get('/Countries/GetAll', function (data) {

                let select = $(selector);
                select.empty();

                data.forEach(c => {
                    select.append(`<option value="${c.idCountry}">${c.name}</option>`);
                });

            });
        }

        function loadDocumentTypesInto(selector) {

            $.get('/DocumentTypes/GetAll', function (data) {

                let select = $(selector);
                select.empty();

                data.forEach(d => {
                    select.append(`<option value="${d.idDocumentType}">${d.name}</option>`);
                });

            });
        }
                $('#btnSaveNewClient').click(function () {

                let formData = new FormData();

                formData.append("FirstName", $('#C_FirstName').val());
                formData.append("LastName", $('#C_LastName').val());
                formData.append("IdDocumentType", $('#C_DocumentType').val());
                formData.append("DocumentNumber", $('#C_DocumentNumber').val());
                formData.append("ExpirationDate", $('#C_ExpirationDate').val());
                formData.append("Phone", $('#C_Phone').val());
                formData.append("Country", $('#C_Country').val());
                formData.append("Address", $('#C_Address').val());
                formData.append("UserC", "admin");


            Swal.fire({
                title: 'Saving...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/Clients/Create',
                method: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    selectedClientId = res.idClient;
                     $('#SenderName').val($('#C_FirstName').val() + ' ' + $('#C_LastName').val());
                    $('#SenderDocumentNumber').val($('#C_DocumentNumber').val());
                    $('#SenderPhone').val($('#C_Phone').val());
                    $('#SenderAddress').val($('#C_Address').val());

                    $('#SenderDocumentType').val($('#C_DocumentType').val());
                    $('#SenderCountry').val($('#C_Country').val()).trigger('change');

                    setTimeout(() => {
                        loadCompaniesByCountry($('#C_Country').val(), 'Sender');
                        loadCurrencyByCountry($('#C_Country').val(), 'Sender');
                    }, 200);

                    $('#CantBeneficiariesXClient').text('(0)');

                    $('#modalNewClient').modal('hide');

                    Swal.fire({
                    icon: 'success',
                    title: 'Client created',
                    timer: 1000,
                    showConfirmButton: false
                    });
                    toggleBeneficiariesActions();
                

                },
                error: function (err) {

                    Swal.fire('Error', err.responseText, 'error');

                }
            });

        });

        function toggleBeneficiariesActions() {

            if (selectedClientId) {

                $('#btnOpenBeneficiaries').prop('disabled', false);
                $('#btnNewBeneficiary').prop('disabled', false);

            } else {

                $('#btnOpenBeneficiaries').prop('disabled', true);
                $('#btnNewBeneficiary').prop('disabled', true);

            }

        }


                let tblBeneficiaries;

        function loadBeneficiariesTable() {

            tblBeneficiaries = $('#tblBeneficiaries').DataTable({
                ajax: {
                    url: '/Beneficiaries/GetByClient?id=' + selectedClientId,
                    dataSrc: ''
                },
                columns: [
                    { data: null, render: d => d.firstName + ' ' + d.lastName },
                    { data: 'documentNumber' },
                    { data: 'countryName' },
                    {
                        data: 'idBeneficiarie',
                        render: id => `
                            <button class="btn btn-success btn-sm"
                                onclick="selectBeneficiary(${id})">
                                Select
                            </button>`
                    }
                ]
            });

        }

                $('#btnOpenBeneficiaries').click(function () {

            if (!selectedClientId) {
                Swal.fire('Warning', 'Select a client first', 'warning');
                return;
            }

            if ($.fn.DataTable.isDataTable('#tblBeneficiaries')) {
                tblBeneficiaries.ajax.url('/Beneficiaries/GetByClient?id=' + selectedClientId).load();
            } else {
                loadBeneficiariesTable();
            }

            $('#modalSearchBeneficiaries').modal('show');
        });

                function selectBeneficiary(id) {

            $.get('/Beneficiaries/GetById?id=' + id, function (b) {

                $('#ReceiverName').val(b.firstName + ' ' + b.lastName);
                $('#ReceiverDocumentNumber').val(b.documentNumber);
                $('#ReceiverCountry').val(b.country).trigger('change');

                $('#ReceiverDocumentType').val(b.idDocumentType);

                setTimeout(() => {
                    loadCompaniesByCountry(b.country, 'Receiver');
                    loadCurrencyByCountry(b.country, 'Receiver');
                }, 200);

                $('#modalSearchBeneficiaries').modal('hide');
                Swal.fire({
                    icon: 'success',
                    title: 'Beneficiary loaded',
                    timer: 1000,
                    showConfirmButton: false
                });

            });

        }

                $('#btnSaveBeneficiary').click(function () {

            if (!selectedClientId) {
                Swal.fire('Error', 'No client selected', 'error');
                return;
            }

            let data = {
                FirstName: $('#B_FirstName').val(),
                LastName: $('#B_LastName').val(),
                IdDocumentType: $('#B_DocumentType').val(),
                DocumentNumber: $('#B_DocumentNumber').val(),
                Country: $('#B_Country').val(),
                IdClient_fk: selectedClientId
            };

            // 🔴 VALIDACIÓN
            if (!data.FirstName || !data.LastName || !data.DocumentNumber) {
                Swal.fire('Error', 'Complete required fields', 'error');
                return;
            }

            Swal.fire({
                title: 'Saving...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '/Beneficiaries/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),

                success: function (res) {
                    let newId = res.idBeneficiarie;
                    selectBeneficiary(newId);
                    loadBeneficiariesCount(selectedClientId);
                    $('#formNewBeneficiary')[0].reset();
                    $('#modalNewBeneficiary').modal('hide');
                    Swal.fire('Saved!', 'Beneficiary created', 'success');
                },

                error: function (err) {
                    Swal.fire('Error', err.responseText, 'error');
                }
            });

        });

                $('#modalNewBeneficiary').on('hidden.bs.modal', function () {
            $('#formNewBeneficiary')[0].reset();
        });
       
        $('#modalNewClient').on('hidden.bs.modal', function () {

            setTimeout(() => {
                document.activeElement.blur();
                $('body').focus();

            }, 100);

        });
    </script>
}