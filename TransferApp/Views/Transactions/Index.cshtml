@{
    ViewData["Title"] = "Transactions";
}

<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
    }

    .img-preview {
        width: 100%;
        height: 250px;
        object-fit: cover;
        border-radius: 10px;
        margin-top: 10px;
    }

    .modal-search {
        background: #f8fafc; /* gris claro elegante */
        border-radius: 15px;
        border: 2px solid #4f46e5;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

    .modal-new {
        background: #f8fafc; /* gris claro elegante */
        border-radius: 15px;
        border: 2px solid #154719;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

    /* header con identidad */
    .modal-search-header {
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        color: white;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    /* input más elegante */
    .search-input {
        border-radius: 10px;
        border: 1px solid #cbd5f5;
    }

    /* hover tabla más pro */
    #tblSearchClient tbody tr:hover {
        background-color: #eef2ff;
        cursor: pointer;
    }

    .img-preview {
        display: none;
    }
</style>

<div class="container-fluid mt-4 px-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between mb-3">
            <h3><i class="bi bi-currency-exchange" "></i> Transactions</h3>

            <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalTx">
                <i class="bi bi-plus"></i> New Money Transfer
            </button>
            <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalSimpleTx">
                <i class="bi bi-plus"></i> New Other Transaction
            </button>
        </div>

        <table id="tblTx" class="table table-hover w-100">
            <thead class="table-light">
                <tr>
                    <th>Reference</th>
                    <th>Sender Document</th>
                    <th>Sender</th>
                    <th>Receiver</th>
                    <th>Receiver Country</th>
                    <th>TransactionType</th>
                    <th>Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>
<div class="modal fade" id="modalTx">
    <div class="modal-dialog modal-xl">
        <div class="modal-content card-custom p-3">

            <h5>New Transaction</h5>

            <form id="formTx">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-3">
                                <label class="form-label">Reference Number *</label>
                                <input id="ReferenceNumber" class="form-control mb-2" placeholder="Reference Number" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Transaction Type *</label>
                                <input id="TransactionTypeName" type="text" class="form-control mb-2" value="Money Transfer" readonly />
                                <input type="hidden" id="TransactionType" value="3" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Amount *</label>
                                <input id="Amount" type="number" class="form-control mb-2" placeholder="Amount" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Commission</label>
                                <input id="Commission" type="text" class="form-control mb-2" placeholder="Commission" readonly />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Total Amount</label>
                                <input id="TotalAmount" type="number" class="form-control mb-2" placeholder="Total Amount" />
                            </div>
                            @* <div class="col-3">
                                <label class="form-label">Currency *</label>
                                <select id="Currency" class="form-control mb-2"></select>
                            </div> *@
                        </div>
                    </div>
                </div>
                <hr />

                <div class="row">
                    <div class="col-12">
                        <div class="input-group" style="margin-bottom:5px;">
                            <h6>Sender Info </h6> &nbsp;&nbsp;&nbsp;
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSearchClient">
                                Search Client <i class="bi bi-search"></i>
                            </button>&nbsp;&nbsp;&nbsp;
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalNewClient">
                                New Client <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="col-12">
                            <div class="row">
                                <div class="col-4">
                                    <label class="form-label">Country *</label>
                                    <select id="SenderCountry" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Company *</label>
                                    <select id="SenderCompany" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Currency *</label>
                                    <select id="SenderCurrency" class="form-control mb-2"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <label class="form-label">Sender Name *</label>
                                <input id="SenderName" class="form-control mb-2" placeholder="Sender Name" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Sender DocumentType *</label>
                                <select id="SenderDocumentType" class="form-control mb-2"></select>
                            </div>
                            <div class="col-3">
                                <label class="form-label">Sender Document Number *</label>
                                <input id="SenderDocumentNumber" class="form-control mb-2" placeholder="Document" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Sender Phone *</label>
                                <input id="SenderPhone" class="form-control mb-2" placeholder="Phone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Sender Address *</label>
                                <input id="SenderAddress" class="form-control mb-2" placeholder="Address" />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="col-12">
                        <div class="input-group" style="margin-bottom:5px;">
                            <h6>Receiver Info</h6> &nbsp;&nbsp;&nbsp;
                            <button id="btnOpenBeneficiaries" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSearchBeneficiaries" disabled>
                                Beneficiaries <i class="bi bi-search"></i> <label id="CantBeneficiariesXClient"></label>
                            </button>
                            &nbsp;&nbsp;&nbsp;
                            <button id="btnNewBeneficiary" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewBeneficiary" disabled>
                                New Beneficiary <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="col-12">
                            <div class="row">
                                <div class="col-4">
                                    <label class="form-label">Country *</label>
                                    <select id="ReceiverCountry" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Company *</label>
                                    <select id="ReceiverCompany" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Currency *</label>
                                    <select id="ReceiverCurrency" class="form-control mb-2"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <label class="form-label">Receiver Name *</label>
                                <input id="ReceiverName" class="form-control mb-2" placeholder="Receiver Name" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Receiver DocumentType *</label>
                                <select id="ReceiverDocumentType" class="form-control mb-2"></select>
                            </div>
                            <div class="col-3">
                                <label class="form-label">Receiver Document Number *</label>
                                <input id="ReceiverDocumentNumber" class="form-control mb-2" placeholder="Document" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Receiver Phone</label>
                                <input id="ReceiverPhone" class="form-control mb-2" placeholder="Phone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Receiver Address</label>
                                <input id="ReceiverAddress" class="form-control mb-2" placeholder="Address" />
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="col-12">
                    <label class="form-label">Justify Details</label>
                    <input id="JustifyDetails" class="form-control mb-2" placeholder="Address" />
                </div>
                <hr />
                <input type="file" class="form-control" onchange="previewImage(this)" id="ImgJustify"/>
                <img id="imgPreview" class="img-preview" />

            </form>
            <div class="modal-footer">
                <button class="btn btn-custom" id="btnSaveTx"><i class="bi bi-floppy-fill"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSearchClient">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-search">

            <!-- HEADER -->
            <div class="modal-header modal-search-header">
                <h5><i class="bi bi-search"></i> Search Client</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <input id="searchClientInput"
                       class="form-control mb-3 search-input"
                       placeholder="Search by name or document..." />

                <table id="tblSearchClient" class="table table-hover w-100">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Document</th>
                            <th>Phone</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                </table>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="modalNewClient">
    <div class="modal-dialog modal-lg">
        <div class="modal-content card-custom modal-new">

            <div class="modal-header bg-success text-white">
                <h5><i class="bi bi-person-plus-fill"></i> New Client</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="formNewClient">

                    <div class="row">
                        <div class="col-md-6">
                            <label>First Name</label>
                            <input id="C_FirstName" class="form-control mb-2" placeholder="First Name" />
                        </div>

                        <div class="col-md-6">
                            <label>Last Name</label>
                            <input id="C_LastName" class="form-control mb-2" placeholder="Last Name" />
                        </div>

                        <div class="col-md-4">
                            <label>Document Type</label>
                            <select id="C_DocumentType" class="form-control mb-2"></select>
                        </div>

                        <div class="col-md-4">
                            <label>Document Number</label>
                            <input id="C_DocumentNumber" class="form-control mb-2" placeholder="Document Number" />
                        </div>

                        <div class="col-md-4">
                            <label>Expiration Date</label>
                            <input type="date" id="C_ExpirationDate" class="form-control mb-2" />
                        </div>

                        <div class="col-md-6">
                            <label>Phone</label>
                            <input id="C_Phone" class="form-control mb-2" placeholder="Phone" />
                        </div>

                        <div class="col-md-6">
                            <label>Country</label>
                            <select id="C_Country" class="form-control mb-2"></select>
                        </div>

                        <div class="col-12">
                            <label>Address</label>
                            <input id="C_Address" class="form-control mb-2" placeholder="Address" />
                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success" id="btnSaveNewClient">
                    <i class="bi bi-floppy-fill"></i> Save Client
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalSearchBeneficiaries">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-search">

            <div class="modal-header modal-search-header">
                <h5>Beneficiaries</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <table id="tblBeneficiaries" class="table table-hover w-100">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Document</th>
                            <th>Country</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalNewBeneficiary">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-new">

            <div class="modal-header bg-success text-white">
                <h5><i class="bi bi-person-plus"></i> New Beneficiary</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="formNewBeneficiary">

                    <div class="row">
                        <div class="col-6">
                            <label>First Name</label>
                            <input id="B_FirstName" class="form-control mb-2" placeholder="First Name"/>
                        </div>

                        <div class="col-6">
                            <label>Last Name</label>
                            <input id="B_LastName" class="form-control mb-2" placeholder="Last Name" />
                        </div>

                        <div class="col-4">
                            <label>Document Type</label>
                            <select id="B_DocumentType" class="form-control mb-2"></select>
                        </div>

                        <div class="col-4">
                            <label>Document Number</label>
                            <input id="B_DocumentNumber" class="form-control mb-2" placeholder="Document Number" />
