                function loadTransactionDetails(id) {

            $.get('/Transactions/GetById?id=' + id, function (t) {

                //-------------------------
                // HEADER
                //-------------------------

                $('#dTransactionType').text(t.transactionTypeName);

                $('#dReference').text(t.referenceNumber);

                $('#dCompany').text(
                    t.senderCompanyName ||
                    t.receiverCompanyName ||
                    '-'
                );

                $('#dDate').text(
                    t.transactionDate ?? '-'
                );

                //-------------------------
                // FINANCIAL
                //-------------------------

                $('#dAmount').text('$' + Number(t.amount).toFixed(2));

                // Estos tres vienen del SP nuevo
                $('#dRate').text(
                    t.commissionRate != null
                        ? t.commissionRate + ' %'
                        : '-'
                );

                $('#dFixedFee').text(
                    '$' + Number(t.fixedCommission || 0).toFixed(2)
                );

                // $('#dVariableFee').text(
                //     '$' + Number(t.Commission || 0).toFixed(2)
                // );

                $('#dCommission').text(
                    '$' + Number(t.Commission || 0).toFixed(2)
                );

                $('#dTotal').text(
                    '$' + Number(t.totalAmount).toFixed(2)
                );

                //-------------------------
                // STATUS
                //-------------------------

                let statusHtml = '';

                switch (t.transactionStatus) {

                    case 'Completed':

                        statusHtml = `
                            <span class="badge bg-success px-3 py-2">
                                <i class="bi bi-check-circle-fill"></i>
                                Completed
                            </span>`;
                        break;

                    case 'Pending':

                        statusHtml = `
                            <span class="badge bg-warning text-dark px-3 py-2">
                                <i class="bi bi-clock-fill"></i>
                                Pending
                            </span>`;
                        break;

                    case 'Rejected':

                        statusHtml = `
                            <span class="badge bg-danger px-3 py-2">
                                <i class="bi bi-x-circle-fill"></i>
                                Rejected
                            </span>`;
                        break;

                    default:

                        statusHtml = `
                            <span class="badge bg-secondary px-3 py-2">
                                Unknown
                            </span>`;
                        break;

                }

                $('#dStatus').html(statusHtml);

                //-------------------------
                // TITULOS
                //-------------------------

                switch (t.transactionType) {

                    case 1: // Check

                        $('#lblSenderTitle').text('Client');
                        $('#receiverBlock').hide();
                        break;

                    case 2: // Money Order

                        $('#lblSenderTitle').text('Sender');
                        $('#lblReceiverTitle').text('Receiver');
                        $('#receiverBlock').show();
                        break;

                    case 3: // Money Transfer

                        $('#lblSenderTitle').text('Client');
                        $('#receiverBlock').hide();
                        break;

                    case 4: // Paid Service

                        $('#lblSenderTitle').text('Customer');
                        $('#lblReceiverTitle').text('Service Company');
                        $('#receiverBlock').show();
                        break;

                    default:

                        $('#lblSenderTitle').text('Sender');
                        $('#lblReceiverTitle').text('Receiver');
                        $('#receiverBlock').show();
                        break;
                }

                //-------------------------
                // SENDER
                //-------------------------

                $('#dSender').text(t.senderName);
                $('#dSenderDoc').text(t.senderDocumentNumber);
                $('#dSenderPhone').text(t.senderPhone);
                $('#dSenderCountry').text(t.senderCountryName);
                $('#dSenderAddress').text(t.senderAddress);

                //-------------------------
                // RECEIVER
                //-------------------------

                if (!t.isSimpleTransaction) {

                    $('#receiverBlock').show();

                    $('#dReceiver').text(t.receiverName);
                    $('#dReceiverDoc').text(t.receiverDocumentNumber);
                    $('#dReceiverPhone').text(t.receiverPhone);
                    $('#dReceiverCountry').text(t.receiverCountryName);
                    $('#dReceiverAddress').text(t.receiverAddress);

                }

                //-------------------------
                // NOTES
                //-------------------------

                $('#dJustify').text(
                    t.justifyDetails || 'No notes'
                );

                //-------------------------
                // EVIDENCE
                //-------------------------

                $('#evidenceContainer').empty();

                $('#dEvidenceCount').text('0');

                /*
                Próximo paso

                $.get('/Transactions/GetAttachments?id=' + id,function(files){

                    $('#dEvidenceCount').text(files.length);

                    files.forEach(f=>{

                        $('#evidenceContainer').append(`
                            <div class="col-md-3 mb-3">

