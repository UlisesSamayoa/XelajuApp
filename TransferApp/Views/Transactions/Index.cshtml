        //PARA MONETY TRANSFER
        function getCommissionByType(amount, ranges, commissionType) {
            if (!ranges || ranges.length === 0)
                return null;
            return ranges.find(r =>
                Number(r.commissionType) === commissionType &&
                amount >= parseFloat(r.minAmount) &&
                amount <= parseFloat(r.maxAmount)
            ) || null;
        }
        function getCommissionByAmount(amount, ranges) {
            if (!ranges || ranges.length === 0)
                return null;
            let range = ranges.find(r =>
                amount >= parseFloat(r.minAmount) &&
                amount <= parseFloat(r.maxAmount)
            );
            return range || null;
        }

