            let validation =
                await $.get(
                    '/Parameters/ValidateClientTransactions?documentNumber='+selectedClientId);

            let warnings =buildRiskMessages(validation,$('#Amount').val());
         if(warnings.length > 0){
            let validAML = validateAMLRequiredFields();
            if(!validAML)
                return;
            let accepted = await confirmAMLWarnings(warnings);
            if(!accepted)
                return;
          }
            saveTransaction();
        });
