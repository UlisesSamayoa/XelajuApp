                                           href="/Transactions/DownloadAttachment?id=${f.idTransactionAttachment}">
                                            <i class="bi bi-download"></i>
                                        </a>

                                    </div>

                                </div>

                            </div>
                        `);

                    });

                });
                */

                //-------------------------
                // SHOW
