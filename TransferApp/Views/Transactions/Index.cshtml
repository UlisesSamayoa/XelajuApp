         function validateCheckDates() {
            let today = new Date();
            today.setHours(0, 0, 0, 0);
            let isValid = true;
            $('.simpletx-issuedatecheck').each(function () {
                let value = $(this).val();
                if (!value) {
                    Swal.fire('Validation','Issue Date is required','warning');
                    $(this).focus();
                    isValid = false;
                    return false;
                }
                let parts = value.split('-');
                let issueDate = new Date(parts[0],parts[1] - 1,parts[2]);
                issueDate.setHours(0, 0, 0, 0);
                let diffTime =today - issueDate;
                let diffDays =diffTime / (1000 * 60 * 60 * 24);
                if (diffDays > 30) {
                    Swal.fire('Expired Check','The check cannot be older than 30 days','warning');
                    $(this).focus();
                    isValid = false;
                    return false;
                }
                if (diffDays < 0) {
                    Swal.fire('Validation','Issue Date cannot be in the future','warning');
                    $(this).focus();
                    isValid = false;
                    return false;
                }
            });
            return isValid;
        }

        function CCbuildRiskMessages(validation){
            let warnings = [];
            let amount = parseFloat($('#SimpleTx_Amount').val()) || 0;
            let futureAmount = parseFloat(validation.totalAmount || 0) + amount;
            let futureTransactions = parseInt(validation.totalTransactions || 0) + 1;
            if(futureAmount > validation.maxAmount){
                warnings.push(`
                    Maximum amount exceeded.<br>
                    Current Total: <b>$${futureAmount.toFixed(2)}</b><br>
                    Allowed: <b>$${parseFloat(validation.maxAmount).toFixed(2)}</b>
                `);
            }
            if(futureTransactions > validation.maxTransactions){
                warnings.push(`
                    Maximum transactions exceeded.<br>
                    Current Transactions: <b>${futureTransactions}</b><br>
                    Allowed: <b>${validation.maxTransactions}</b>
                `);
            }
            return warnings;
        }
        async function CCconfirmAMLWarnings(warnings){

            if(warnings.length === 0)
                return true;
            let html = '';
            warnings.forEach(x => {
                html += `
                    <div class="text-danger mb-2">
                        ⚠️ ${x}
                    </div>
                `;
            });

            let result = await Swal.fire({
                icon:'warning',
                title:'AML Warning',
                html:html,
                showCancelButton:true,
                confirmButtonText:'Accept Risk',
                cancelButtonText:'Cancel'
            });
            return result.isConfirmed;
        }
        function CCvalidateAMLRequiredFields() {
            let justify =$('#SimpleTx_JustifyDetails').val().trim();
            if (!justify) {
                Swal.fire(
                    'AML Validation',
                    'Justify Details is required',
                    'warning');
                $('#SimpleTx_JustifyDetails').focus();
                return false;
            }
            let hasFiles = false;
            $('.SimpleTx_justify-file').each(function () {
                if (this.files.length > 0) {
                    hasFiles = true;
                    return false;
                }
            });
            if (!hasFiles) {
                Swal.fire(
                    'AML Validation',
                    'At least one attachment is required',
                    'warning');
                return false;
            }
            return true;
        }

