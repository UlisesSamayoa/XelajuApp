@{
    ViewData["Title"] = "Transactions";
    Layout = "_Layout";
}



<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .tmin-w {
        min-width: 100px !important;
        white-space: nowrap;
    }
    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }
    .img-preview {
        width: 100%;
        height: 250px;
        object-fit: cover;
        border-radius: 10px;
        margin-top: 10px;
    }

    .modal-search {
        background: #f8fafc; /* gris claro elegante */
        border-radius: 15px;
        border: 2px solid #4f46e5;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

    .modal-new {
        background: #f8fafc; /* gris claro elegante */
        border-radius: 15px;
        border: 2px solid #154719;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    }

    /* header con identidad */
    .modal-search-header {
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        color: white;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    /* input más elegante */
    .search-input {
        border-radius: 10px;
        border: 1px solid #cbd5f5;
    }

    /* hover tabla más pro */
    #tblSearchClient tbody tr:hover {
        background-color: #eef2ff;
        cursor: pointer;
    }

    .img-preview {
        display: none;
    }
</style>

<div class="container-fluid mt-4 px-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between mb-3">
            <h3><i class="bi bi-currency-exchange"></i> Transactions</h3>

            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalTx" onclick="ObtenerTipoTransaccion(3,'TransactionType')">
                <i class="bi bi-currency-exchange"></i> Money Transfer
            </button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalSimpleTx" onclick="ObtenerTipoTransaccion(1,'SimpleTx')">
                <i class="bi bi-cash-coin"></i> Check Cashing
            </button>
            <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#modalOrderTx" onclick="ObtenerTipoTransaccion(2,'MOrder')">
                <i class="bi bi-folder-plus"></i> Money Order
            </button>
            <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalPaidTx" onclick="ObtenerTipoTransaccion(4,'PService')">
                <i class="bi bi-lightbulb-fill"></i> Paid Service
            </button>
        </div>
        <div class="row mb-3">
            <div class="col-md-4">
                <input type="text" id="filterTransactioType" class="form-control" placeholder="Filter by Transaction type">
            </div>
        </div>
        <table id="tblTx" class="table table-hover w-100">
            <thead class="table-light">
                <tr>
                    <th>Reference</th>
                    <th>Sender Document</th>
                    <th>Name</th>
                    <th>Sender Company</th>
                    <th>Transaction Type</th>
                    <th>Status</th>
                    <th>Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>
<div class="modal fade" id="modalTx">
    <div class="modal-dialog modal-xl">
        <div class="modal-content card-custom p-3">

            <h5>New Transaction</h5>

            <form id="formTx">
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-3">
                                <label class="form-label">Reference Number *</label>
                                <input id="ReferenceNumber" class="form-control mb-2" placeholder="Reference Number" readonly/>
                                <input type="hidden" id="TransactionType" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Amount * ($<label id="NetAmountL"></label>)</label>
                                <input id="Amount" type="number" class="form-control mb-2" placeholder="Amount" />
                            </div>
                            <div class="col-1">
                                <label class="form-label"> <label id="CommissionL"></label> %</label>
                                <input id="Commission" type="number" class="form-control mb-2" placeholder="0.00"/>
                            </div>
                            <div class="col-1">
                                <label class="form-label">Fee</label>
                                <input id="FixedCommission" type="number" value="0" class="form-control mb-2" placeholder="0.00" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">% / Fee</label>
                                <input id="TotalCommission" type="text" class="form-control mb-2" placeholder="0.00" readonly />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Total Amount</label>
                                <input id="TotalAmount" type="number" class="form-control mb-2" placeholder="Total Amount" />
                            </div>
                            <div class="col-1">
                                @* <label class="form-label">Mode</label>
                                <input id="DeductFees" type="checkbox" class="form-check-input" /> *@
                                <label class="form-check-label">
                                    Calculation Mode
                                </label>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="DeductFees" />
                                </div>
                                <input id="NetAmount" readonly type="hidden" />
                            </div>
                        </div>
                    </div>
                </div>
                <hr />

                <div class="row">
                    <div class="col-12">
                        <div class="input-group" style="margin-bottom:5px;">
                            <h6>Sender Info </h6> &nbsp;&nbsp;&nbsp;
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSearchClient">
                                Search Client <i class="bi bi-search"></i>
                            </button>&nbsp;&nbsp;&nbsp;
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalNewClient">
                                New Client <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="col-12">
                            <div class="row">
                                <div class="col-4">
                                    <label class="form-label">Country *</label>
                                    <select id="SenderCountry" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Company *</label>
                                    <select id="SenderCompany" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Currency *</label>
                                    <select id="SenderCurrency" class="form-control mb-2"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <label class="form-label">Sender Name *</label>
                                <input id="SenderName" class="form-control mb-2" placeholder="Sender Name" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Sender DocumentType *</label>
                                <select id="SenderDocumentType" data-target="#SenderDocumentNumber" class="form-control mb-2 document-type"></select>
                            </div>
                            <div class="col-4">
                                <label class="form-label">Sender Document Number *</label>
                                <input id="SenderDocumentNumber" class="form-control mb-2" placeholder="Document" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <label class="form-label">Issue Date</label>
                                <input type="date" id="IssueDate" class="form-control mb-2 issue-date" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Expiration Date *</label>
                                <input type="date" id="ExpirationDate" class="form-control mb-2" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Sender Phone *</label>
                                <input id="SenderPhone" class="form-control mb-2" placeholder="Phone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Sender Address *</label>
                                <input id="SenderAddress" class="form-control mb-2" placeholder="Address" />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="col-12">
                        <div class="input-group" style="margin-bottom:5px;">
                            <h6>Receiver Info</h6> &nbsp;&nbsp;&nbsp;
                            <button id="btnOpenBeneficiaries" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSearchBeneficiaries" disabled>
                                Beneficiaries <i class="bi bi-search"></i> <label id="CantBeneficiariesXClient"></label>
                            </button>
                            &nbsp;&nbsp;&nbsp;
                            <button id="btnNewBeneficiary" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewBeneficiary" disabled>
                                New Beneficiary <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="col-12">
                            <div class="row">
                                <div class="col-4">
                                    <label class="form-label">Country *</label>
                                    <select id="ReceiverCountry" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Company *</label>
                                    <select id="ReceiverCompany" class="form-control mb-2"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Currency *</label>
                                    <select id="ReceiverCurrency" class="form-control mb-2"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4">
                                <label class="form-label">Receiver Name *</label>
                                <input id="ReceiverName" class="form-control mb-2" placeholder="Receiver Name" />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Receiver DocumentType *</label>
                                <select id="ReceiverDocumentType" data-target="#ReceiverDocumentNumber" class="form-control mb-2 document-type"></select>
                            </div>
                            <div class="col-3">
                                <label class="form-label">Receiver Document Number *</label>
                                <input id="ReceiverDocumentNumber" class="form-control mb-2" placeholder="Document" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Receiver Phone</label>
                                <input id="ReceiverPhone" class="form-control mb-2" placeholder="Phone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Receiver Address</label>
                                <input id="ReceiverAddress" class="form-control mb-2" placeholder="Address" />
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="col-12">
                    <label class="form-label">Justify Details</label>
                    <input id="JustifyDetails" class="form-control mb-2" placeholder="Justify Details" />
                </div>
                <hr />
                <label id="justifyCounter">0 / 5 files</label>
                <div id="justifyContainer">
                    <div class="justify-item row mb-2">
                        <div class="col-11">
                            <input type="file" name="ImgJustify" class="form-control justify-file" />
                        </div>
                        <div class="col-1">
                            <button type="button" class="btn btn-success" onclick="addJustifyFile()">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label class="form-label">Justify Agent Name</label>
                        <input id="Justify_AgentName" type="text" class="form-control mb-2" placeholder="Agent name" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Justify Date</label>
                        <input id="Justify_DateError" type="date" class="form-control mb-2"/>
                    </div>
                </div>
            </form>
            <div class="modal-footer">
                <button class="btn btn-success" id="btnSaveTx"><i class="bi bi-floppy-fill"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSearchClient">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-search">

            <!-- HEADER -->
            <div class="modal-header modal-search-header">
                <h5><i class="bi bi-search"></i> Search Client</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <input id="searchClientInput"
                       class="form-control mb-3 search-input"
                       placeholder="Search by name or document..." />

                <table id="tblSearchClient" class="table table-hover w-100">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Document</th>
                            <th>Phone</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                </table>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="modalNewClient">
    <div class="modal-dialog modal-lg">
        <div class="modal-content card-custom modal-new">

            <div class="modal-header bg-success text-white">
                <h5><i class="bi bi-person-plus-fill"></i> New Client</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="formNewClient">

                    <div class="row">
                        <div class="col-md-6">
                            <label>First Name</label>
                            <input id="C_FirstName" class="form-control mb-2" placeholder="First Name" />
                        </div>

                        <div class="col-md-6">
                            <label>Last Name</label>
                            <input id="C_LastName" class="form-control mb-2" placeholder="Last Name" />
                        </div>

                        <div class="col-md-6">
                            <label>Document Type</label>
                            <select id="C_DocumentType" data-target="#C_DocumentNumber" class="form-control mb-2 document-type"></select>
                        </div>

                        <div class="col-md-6">
                            <label>Document Number</label>
                            <input id="C_DocumentNumber" class="form-control mb-2" placeholder="Document Number" />
                        </div>

                        <div class="col-md-6">
                            <label>Issue Date</label>
                            <input type="date" id="C_IssueDate" class="form-control mb-2 issue-date" />
                        </div>
                        <div class="col-md-6">
                            <label>Expiration Date</label>
                            <input type="date" id="C_ExpirationDate" class="form-control mb-2" />
                        </div>

                        <div class="col-md-6">
                            <label>Phone</label>
                            <input id="C_Phone" class="form-control mb-2" placeholder="Phone" />
                        </div>

                        <div class="col-md-6">
                            <label>Country</label>
                            <select id="C_Country" class="form-control mb-2"></select>
                        </div>

                        <div class="col-12">
                            <label>Address</label>
                            <input id="C_Address" class="form-control mb-2" placeholder="Address" />
                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success" id="btnSaveNewClient">
                    <i class="bi bi-floppy-fill"></i> Save Client
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalSearchBeneficiaries">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-search">

            <div class="modal-header modal-search-header">
                <h5>Beneficiaries</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <table id="tblBeneficiaries" class="table table-hover w-100">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Document</th>
                            <th>Country</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalNewBeneficiary">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-new">

            <div class="modal-header bg-success text-white">
                <h5><i class="bi bi-person-plus"></i> New Beneficiary</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="formNewBeneficiary">

                    <div class="row">
                        <div class="col-6">
                            <label>First Name</label>
                            <input id="B_FirstName" class="form-control mb-2" placeholder="First Name" />
                        </div>

                        <div class="col-6">
                            <label>Last Name</label>
                            <input id="B_LastName" class="form-control mb-2" placeholder="Last Name" />
                        </div>

                        <div class="col-6">
                            <label>Document Type</label>
                            <select id="B_DocumentType" data-target="#B_DocumentNumber" class="form-control mb-2 document-type"></select>
                        </div>

                        <div class="col-6">
                            <label>Document Number</label>
                            <input id="B_DocumentNumber" class="form-control mb-2" placeholder="Document Number" />
                        </div>

                        <div class="col-6">
                            <label>Country</label>
                            <select id="B_Country" class="form-control mb-2"></select>
                        </div>
                        <div class="col-6">
                            <label>Phone</label>
                            <input name="B_Phone" id="B_Phone" class="form-control mb-2" placeholder="Phone" />
                        </div>
                    </div>
                    <label>Address</label>
                    <textarea name="B_Address" id="B_Address" class="form-control mb-2" placeholder="Address"></textarea>
                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success" id="btnSaveBeneficiary">
                    <i class="bi bi-floppy-fill"></i> Save Beneficiary
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalTxDetails">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <!-- HEADER -->
            <div class="modal-header bg-dark text-white">

                <div>
                    <h5 class="mb-0">
                        <i class="bi bi-receipt-cutoff"></i>
                        Transaction Details
                    </h5>

                    <small id="dTransactionType"></small>
                </div>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <!-- ========================= -->
                <!-- RESUMEN -->
                <!-- ========================= -->

                <div class="row g-3">

                    <div class="col-md-3">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <small class="text-muted">Reference</small>
                                <h6 id="dReference"></h6>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <small class="text-muted">Company</small>
                                <h6 id="dCompany"></h6>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <small class="text-muted">Status</small>
                                <div id="dStatus"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <small class="text-muted">Date</small>
                                <h6 id="dDate"></h6>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ========================= -->
                <!-- FINANCIAL -->
                <!-- ========================= -->

                <div class="card shadow-sm mt-4">

                    <div class="card-header bg-light">

                        <strong>
                            <i class="bi bi-cash-stack"></i>
                            Financial Summary
                        </strong>

                    </div>

                    <div class="card-body">

                        <div class="row text-center">

                            <div class="col-md-2">
                                <small class="text-muted">Amount</small>
                                <h5 id="dAmount"></h5>
                            </div>

                            <div class="col-md-2">
                                <small class="text-muted">Rate</small>
                                <h5 id="dRate"></h5>
                            </div>

                            <div class="col-md-2">
                                <small class="text-muted">Fixed Fee</small>
                                <h5 id="dFixedFee"></h5>
                            </div>

                            <div class="col-md-2">
                                <small class="text-muted">Variable Fee</small>
                                <h5 id="dVariableFee"></h5>
                            </div>

                            <div class="col-md-2">
                                <small class="text-muted">Commission</small>
                                <h5 id="dCommission"></h5>
                            </div>

                            <div class="col-md-2">
                                <small class="text-muted">Total</small>
                                <h4 class="text-success" id="dTotal"></h4>
                            </div>

                        </div>

                    </div>

                </div>

                <!-- ========================= -->
                <!-- PARTICIPANTS -->
                <!-- ========================= -->

                <div class="row mt-4">

                    <div class="col-md-6">

                        <div class="card shadow-sm h-100">

                            <div class="card-header bg-primary text-white">

                                <span id="lblSenderTitle">
                                    Sender
                                </span>

                            </div>

                            <div class="card-body">

                                <table class="table table-sm table-borderless">

                                    <tr>
                                        <th width="35%">Name</th>
                                        <td id="dSender"></td>
                                    </tr>

                                    <tr>
                                        <th>Document</th>
                                        <td id="dSenderDoc"></td>
                                    </tr>

                                    <tr>
                                        <th>Phone</th>
                                        <td id="dSenderPhone"></td>
                                    </tr>

                                    <tr>
                                        <th>Country</th>
                                        <td id="dSenderCountry"></td>
                                    </tr>

                                    <tr>
                                        <th>Address</th>
                                        <td id="dSenderAddress"></td>
                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6" id="receiverBlock">

                        <div class="card shadow-sm h-100">

                            <div class="card-header bg-success text-white">

                                <span id="lblReceiverTitle">
                                    Receiver
                                </span>

                            </div>

                            <div class="card-body">

                                <table class="table table-sm table-borderless">

                                    <tr>
                                        <th width="35%">Name</th>
                                        <td id="dReceiver"></td>
                                    </tr>

                                    <tr>
                                        <th>Document</th>
                                        <td id="dReceiverDoc"></td>
                                    </tr>

                                    <tr>
                                        <th>Phone</th>
                                        <td id="dReceiverPhone"></td>
                                    </tr>

                                    <tr>
                                        <th>Country</th>
                                        <td id="dReceiverCountry"></td>
                                    </tr>

                                    <tr>
                                        <th>Address</th>
                                        <td id="dReceiverAddress"></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- ========================= -->
                <!-- NOTES -->
                <!-- ========================= -->
                <div class="card shadow-sm mt-4">
                    <div class="card-header">
                        <i class="bi bi-chat-left-text"></i>
                        Notes / Justification
                    </div>
                    <div class="card-body">
                        <p id="dJustify" class="mb-0"></p>
                    </div>
                </div>
                <!-- ========================= -->
                <!-- EVIDENCE -->
                <!-- ========================= -->
                <div class="card shadow-sm mt-4">
                    <div class="card-header d-flex justify-content-between">
                        <span><i class="bi bi-images"></i> Evidence </span>
                        <span id="dEvidenceCount" class="badge bg-primary">0</span>
                    </div>
                    <div class="card-body">
                        <div class="row" id="evidenceContainer"> </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalTransactionEvidence">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-dark text-white">
                <div>
                    <h5 class="mb-0"> <i class="bi bi-images"></i>Add Transaction Evidence</h5>
                    <small>
                        Upload additional documents requested after the transaction was completed.
                    </small>
                </div>
