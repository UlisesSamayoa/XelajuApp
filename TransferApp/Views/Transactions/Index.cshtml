        function loadCompaniesByTransactionType_Service(transactionType, selectId, selectedValue = null) {
                    $('#SimpleTx_Company').val('');
            $.get(
                '/Companies/GetByTransactionType_Service?transactionType=' + transactionType,
                function (data) {
                    let select;
                    let select2;
                    if (selectId == "TransactionType") {
                        select = $('#SenderCompany');
                        select2 = $('#ReceiverCompany');
                            select2.empty();
                            data.forEach(c => {
                                select2.append(
                                    `<option value="${c.idCompany}">
                                        ${c.name}
                                    </option>`
                                );
                            });
                    } else {
                        select = $('#' + selectId);
                    }
                    select.empty();
                       data.forEach(c => {
                        select.append(
                            `<option
                                value="${c.idCompany}"
                                data-swift="${c.swiftCode || ''}">
                                ${c.name}
                            </option>`
                        );
                    });
                }

            );
        }

                function openChangeStatusModal(id, currentStatus) {

            $('#ChangeStatus_IdTransaction').val(id);

            $('#ChangeStatus_Current').val(currentStatus);

            $('#ChangeStatus_New').val('');

            $('#modalChangeStatus').modal('show');
        }
                $('#btnSaveTransactionStatus').click(function () {

            let idTransaction =$('#ChangeStatus_IdTransaction').val();

            let status =$('#ChangeStatus_New').val();
            let transactionsStatusComment =$('#TransactionsStatusComment').val();

            if (!status) {

                Swal.fire(
                    'Error',
                    'Select a status',
                    'error'
                );

                return;
            }

            Swal.fire({
                title: 'Saving...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({

                url: '/Transactions/ChangeStatus',

                method: 'POST',

                data: {
                    idTransaction: idTransaction,
                    status: status,
                    transactionsStatusComment:transactionsStatusComment
                },

                success: function () {

                    $('#modalChangeStatus')
                        .modal('hide');

                    $('#tblTx')
                        .DataTable()
                        .ajax.reload();

                    Swal.fire({
                        icon: 'success',
                        title: 'Status updated',
                        timer: 1200,
                        showConfirmButton: false
                    });
                },

                error: function (err) {

                    Swal.fire(
                        'Error',
                        err.responseText,
                        'error'
                    );
                }
            });
        });

        //FUNCIONAMIENTO DE ENLAZAR COMPAÑIAS DE SERVICIOS
        $('#btnAddClientCompany').click(function(){
            let clientId =selectedClients["PService_"];
            if(!clientId){
                Swal.fire(
                    'Error',
                    'Select a client first',
                    'error'
                );
                return;
            }
            loadCompaniesForAccount();
            $('#modalClientCompany').modal('show');
        });
         
        
        $('#btnSaveClientCompany').click(function () {
                let companyId = $('#CC_Company').val();
            let accountNumber = $('#CC_AccountNumber').val().trim();

            ////////////////////////////////////
            // VALIDATIONS
            ////////////////////////////////////
             if (!selectedClients["PService_"]) {
                Swal.fire(
                    'Error',
                    'Please select a client first',
                    'error'
                );
                return;
            }
            if (!companyId) {
                Swal.fire(
                    'Error',
                    'Please select a company',
                    'error'
                );
                return;
            }

            if (!accountNumber) {
                Swal.fire(
                    'Error',
                    'Account Number is required',
                    'error'
                );
                return;
            }

            let data = {
                idClient: selectedClients["PService_"],
                idCompany: companyId,
                accountNumber: accountNumber
            };
            $.ajax({
                url: '/ClientCompanies/Create',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),

                success: function () {

                    $('#modalClientCompany').modal('hide');

                    Swal.fire(
                        'Success',
                        'Account linked',
                        'success'
                    );

                    loadPaidServiceCompanies(
                        selectedClients["PService_"]
                    );
                },

                error: function (xhr) {

                    let msg = 'Unexpected error';

                    if (xhr.responseJSON?.message) {
                        msg = xhr.responseJSON.message;
                    }

                    Swal.fire(
                        'Error',
                        msg,
                        'error'
                    );
                }
            });

        });
        function loadCompaniesForAccount() {
            $.get('/Companies/GetByTransactionType_Service?transactionType=4',function(data) {
                    let select = $('#CC_Company');
                    select.empty();
                    select.append('<option value="">Select Company</option>');
                    data.forEach(c => {
                        select.append(`
                            <option value="${c.idCompany}">
                                ${c.name}
                            </option>
                        `);
                    });
                }
            );
        }
    </script>
}