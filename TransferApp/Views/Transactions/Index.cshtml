                    function getHighestPreviewForCompany(companyId, currentReferenceSelector) {

            let highest = 0;

            $('.simpletx-row').each(function () {

                const rowCompany =
                    $(this).find('.simpletx-company').val();

                if (rowCompany != companyId)
                    return;

                const referenceInput =
                    $(this).find('.simpletx-reference');

                if (
                    '#' + referenceInput.attr('id') ===
                    currentReferenceSelector
                )
                    return;

                const reference =
                    referenceInput.val();

                if (!reference)
                    return;

                const match =
                    reference.match(/-(\d+)$/);

                if (!match)
                    return;

                const number =
                    parseInt(match[1]);

                if (number > highest)
                    highest = number;
            });

            return highest;
        }

                   function Global_selectCompany(id) {

            $.get('/Companies/GetById?id=' + id, function (c) {
                let companyIdSelector =currentSimpleTxIndex == 0? '#SimpleTx_Company': `#SimpleTx_Company_${currentSimpleTxIndex}`;
                let companyTextSelector =currentSimpleTxIndex == 0? '#SimpleTx_CompanyText': `#SimpleTx_CompanyText_${currentSimpleTxIndex}`;
                let referenceSelector =currentSimpleTxIndex == 0? '#SimpleTx_ReferenceNumber': `#SimpleTx_ReferenceNumber_${currentSimpleTxIndex}`;
                $(companyIdSelector).val(c.idCompany);
                $(companyTextSelector).val(c.name);

                $.get(
                    '/ReferenceNumber/GetReferencePreview',
                    {
                        senderCompany: c.idCompany,
                        transactionType: 1
                    },
                    function (preview) {
                        const match =preview.match(/^(.*)-(\d+)$/);
                        if (!match) {
                            $(referenceSelector).val(preview);
                            return;
                        }
                        const swiftCode =match[1];
                        const baseSequence =parseInt(match[2]);
                        const highestPreview =getHighestPreviewForCompany(c.idCompany,referenceSelector);
                        let finalSequence =baseSequence;
                        if (
                            highestPreview >= baseSequence
                        ) {
                            finalSequence =highestPreview + 1;
                        }
                        const finalReference =`${swiftCode}-${finalSequence.toString().padStart(8, '0')}`;
                        $(referenceSelector).val(finalReference);
                    });
                $('#SimpleTx_modalSearchCompany').modal('hide');
                Swal.fire({icon: 'success',title: 'Company loaded',timer: 1000,showConfirmButton: false});
            });
        }
