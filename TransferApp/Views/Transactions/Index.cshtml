                        <i class="bi bi-images"></i>
                    </button>
                    ${row.transactionType == 1 ? `
                        <button class="btn btn-warning btn-sm"
                            onclick="openChangeStatusModal(
                                ${row.idTransaction},
                                '${row.transactionStatus}'
                            )">
                            <i class="bi bi-arrow-repeat"></i>
                        </button>
                    ` : ''}

                    <button class="btn btn-info btn-sm"
                        onclick="loadTransactionDetails(${row.idTransaction})">
                        <i class="bi bi-eye-fill"></i>
                    </button>

                    <button class="btn btn-danger btn-sm"
                        onclick="deleteTx(${row.idTransaction})">
                        <i class="bi bi-trash-fill"></i>
                    </button>

                `;
            }
        }

                ],

                ordering: false,

                language: {

                    emptyTable:
                        "No transactions yet",

                    search:
                        "Search:",

                    lengthMenu:
                        "Show _MENU_ entries",

                    loadingRecords:
                        "Loading...",

                    zeroRecords:
                        "No matches found"
                },

                drawCallback: function () {

                    $('#tblTx tbody tr')
                        .addClass('fade-in');

                }
            });
        }


                function deleteTx(id) {

            Swal.fire({
                title: 'Delete transaction?',
                text: 'This action will deactivate the transaction',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete'
            }).then(result => {

                if (result.isConfirmed) {

                    $.post('/Transactions/Delete', { id }, function () {

                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            timer: 1200,
                            showConfirmButton: false
                        });

                        tableTx.ajax.reload();

                    }).fail(err => {

                        Swal.fire('Error', err.responseText, 'error');

                    });

                }
            });
        }

        function loadTransactionAddFiles(id){
            $.get('/Transactions/GetById?id=' + id,function(t){
                $('#Evidence_IdTransaction').val(t.idTransaction);
                $('#Evidence_Reference').val(t.referenceNumber);
                $('#Evidence_Client').val(t.senderName);
                $('#Evidence_Files').val('');
                $('#Evidence_FileList').html(`<span class="text-muted">No files selected.</span>`);
                $('#modalTransactionEvidence').modal('show');
            });
        }
            $('#Evidence_Files').change(function(){
                let container = $('#Evidence_FileList');
                container.empty();
                let files = this.files;
                if(files.length == 0){
                    container.html(`
                        <span class="text-muted">
                            No files selected.
                        </span>
                    `);
                    return;
                }
                Array.from(files).forEach(function(file,index){

                    container.append(`
                        <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
                            <div>
                                <i class="bi bi-file-earmark"></i>
                                ${file.name}
                            </div>
                            <span class="badge bg-primary">
                                ${(file.size/1024).toFixed(1)} KB
                            </span>
                        </div>
                    `);
                });
            });
                $('#btnSaveEvidence').click(function(){
                    let files = $('#Evidence_Files')[0].files;
                    if(files.length == 0){
                        Swal.fire(
                            'Error',
                            'Select at least one evidence file.',
                            'error'
                        );
                        return;
                    }
                    let form = new FormData();
                    form.append('idTransaction',$('#Evidence_IdTransaction').val());
                    for(let i=0;i<files.length;i++){
                        form.append('files',files[i]);
                    }
                    Swal.fire({
                        title:'Uploading...',
                        allowOutsideClick:false,
                        didOpen:()=>Swal.showLoading()
                    });
                    $.ajax({
                        url:'/Transactions/AddEvidence',
                        type:'POST',
                        data:form,
                        processData:false,
                        contentType:false,
                        success:function(res){
                            $('#modalTransactionEvidence').modal('hide');
                            $('#Evidence_Files').val('');
                            $('#Evidence_FileList').html('');
                            Swal.fire({
                                icon:'success',
                                title:'Evidence uploaded',
                                text:res.message,
                                timer:1200,
                                showConfirmButton:false
                            });
                        },
                        error:function(xhr){
                            Swal.fire(
                                'Error',
                                xhr.responseJSON?.message ?? 'Unexpected error',
                                'error'
                            );
                        }
                    });
                });

