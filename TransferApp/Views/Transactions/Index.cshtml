                function validateRequiredFields() {
            let required = [

                { id:'ReferenceNumber', name:'Reference Number' },
                { id:'Amount', name:'Amount' },
                { id:'Commission', name:'Commission' },
                { id:'TotalAmount', name:'TotalAmount' },

                { id:'SenderCountry', name:'Sender Country' },
                { id:'SenderCompany', name:'Sender Company' },
                { id:'SenderCurrency', name:'Sender Currency' },
                { id:'SenderName', name:'Sender Name' },
                { id:'SenderDocumentType', name:'Sender Document Type' },
                { id:'SenderDocumentNumber', name:'Sender Document Number' },
                { id:'SenderPhone', name:'Sender Phone' },
                { id:'SenderAddress', name:'Sender Address' },

                { id:'ReceiverCountry', name:'Receiver Country' },
                { id:'ReceiverCompany', name:'Receiver Company' },
                { id:'ReceiverCurrency', name:'Receiver Currency' },
                { id:'ReceiverName', name:'Receiver Name' },
                { id:'ReceiverDocumentType', name:'Receiver Document Type' },
                { id:'ReceiverDocumentNumber', name:'Receiver Document Number' }

            ];

            for(let f of required){

                let value = $('#' + f.id).val();

                if(!value){

                    Swal.fire(
                        'Required field',
                        f.name + ' is required',
                        'warning'
                    );

                    $('#' + f.id).focus();

                    return false;
                }
            }

            return true;
        }

