            function buildRiskMessages(validation){
            let warnings = [];
            let amount = parseFloat($('#Amount').val()) || 0;
            let futureAmount = parseFloat(validation.totalAmount || 0) + amount;
            let futureTransactions = parseInt(validation.totalTransactions || 0) + 1;
            if(futureAmount > validation.maxAmount){
                warnings.push(`
                    Maximum amount exceeded.<br>
                    Current Total: <b>$${futureAmount.toFixed(2)}</b><br>
                    Allowed: <b>$${parseFloat(validation.maxAmount).toFixed(2)}</b>
                `);
            }
            if(futureTransactions > validation.maxTransactions){
                warnings.push(`
                    Maximum transactions exceeded.<br>
                    Current Transactions: <b>${futureTransactions}</b><br>
                    Allowed: <b>${validation.maxTransactions}</b>
                `);
            }
            return warnings;
        }
        async function confirmAMLWarnings(warnings){

            if(warnings.length === 0)
                return true;
            let html = '';
            warnings.forEach(x => {
                html += `
                    <div class="text-danger mb-2">
                        ⚠️ ${x}
                    </div>
                `;
            });

            let result = await Swal.fire({
                icon:'warning',
                title:'AML Warning',
                html:html,
                showCancelButton:true,
                confirmButtonText:'Accept Risk',
                cancelButtonText:'Cancel'
            });
            return result.isConfirmed;
        }

        function validateAMLRequiredFields(){
            let justify =
                $('#JustifyDetails').val().trim();

            let file = $('#ImgJustify')[0].files[0];
            if(!justify){
                Swal.fire(
                    'AML Validation',
                    'Justify Details is required',
                    'warning');
                $('#JustifyDetails').focus();
                return false;
            }
            if(!file){
                Swal.fire(
                    'AML Validation',
                    'Justification image is required',
                    'warning');
                return false;
            }
            return true;
        }
        $('#Amount').on('keyup change', function(){
            calculateCommission();
