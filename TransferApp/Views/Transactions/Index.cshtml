          function calculateCommission(){
            let amount = parseFloat( $('#Amount').val()) || 0;
            let commissionPercent = parseFloat( $('#TransactionType').data('commission')) || 0;
            let commissionValue = amount * (commissionPercent / 100);
            let total = amount + commissionValue;
            $('#Commission').val(commissionValue.toFixed(2));

            $('#TotalAmount').val(total.toFixed(2));
        }
        $('#btnSaveTx').click(async function(){
            if(!validateRequiredFields())
                return;
            let exists =
