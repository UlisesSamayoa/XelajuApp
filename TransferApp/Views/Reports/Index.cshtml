@{
    ViewData["Title"] = "Companies";
    Layout = "_Layout";
}
<style>
    .report-card {
        background: #fff;
        border-radius: 18px;
        padding: 28px;
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid #ECECEC;
        transition: .25s;
        box-shadow: 0 6px 20px rgba(0,0,0,.05);
    }

        .report-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 35px rgba(0,0,0,.15);
        }

    .report-icon {
        width: 70px;
        height: 70px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 30px;
    }

    .report-card h4 {
        font-weight: 700;
    }

    .report-card p {
        min-height: 60px;
    }

    .report-filters {
        margin-top: 12px;
        padding-left: 18px;
        flex-grow: 1;
    }

    .report-filters li {
        margin-bottom: 6px;
    }

    .btnOpenReport {
        border-radius: 10px;
        font-weight: 600;
    }
</style>

<div class="container-fluid mt-4">
    <div class="row g-4">
        <!-- REPORT 1 -->
        <div class="col-xl-4 col-lg-4 col-md-6 d-flex">
            <div class="report-card h-100 w-100 d-flex flex-column">
                <div class="row">
                    <div class="col-3">
                        <div class="report-icon bg-primary">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                    </div>
                    <div class="col-9 mt-3">
                        <h5>Daily transactions</h5>
                    </div>
                </div>
                <p class="text-muted">
                    Generate daily transactions.
                </p>
                <hr>
                <small class="text-secondary fw-bold">
                    Filters
                </small>
                <div class="flex-grow-1">
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label>Start Date</label>
                            <input type="date" id="Dayli_StartDate" class="form-control">
                        </div>
                        <div class="col-6 mb-2">
                            <label>End Date</label>
                            <input type="date" id="Dayli_EndDate" class="form-control">
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary w-100 btnOpenReport" data-report="transactions_day">Generate Report</button>
            </div>
        </div>
        <!-- REPORT 2 -->
        <div class="col-xl-4 col-lg-4 col-md-6 d-flex">
            <div class="report-card h-100 w-100 d-flex flex-column">
                <div class="row">
                    <div class="col-3">
                        <div class="report-icon bg-primary">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                    </div>
                    <div class="col-9 mt-3">
                        <h5>Transactions by Company</h5>
                    </div>
                </div>
                <p class="text-muted">
                    Generate transaction reports by dates,
                    companies and transaction type.
                </p>
                <hr>
                <small class="text-secondary fw-bold">
                    Filters
                </small>
                <div class="flex-grow-1">
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label>Start Date</label>
                            <input type="date" id="TCompany_StartDate" class="form-control">
                        </div>
                        <div class="col-6 mb-2">
                            <label>End Date</label>
                            <input type="date" id="TCompany_EndDate" class="form-control">
                        </div>
                        <div class="col-12">
                            <label>Transaction Type</label>
                            <select id="TransactionType" class="form-control"></select>
                            <br />
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary w-100 btnOpenReport" data-report="transactions_type">Generate Report</button>
            </div>
        </div>
        <!-- REPORT 3 -->
        <div class="col-xl-4 col-lg-4 col-md-6 d-flex">
            <div class="report-card h-100 w-100 d-flex flex-column">
                <div class="row">
                    <div class="col-3">
                        <div class="report-icon bg-success">
                            <i class="bi bi-person-rolodex"></i>
                        </div>
                    </div>
                    <div class="col-9 mt-3">
                        <h5>Transaction by Client</h5>
                    </div>
                </div>
                <p class="text-muted">
                    Generate transaction reports by dates and
                    companies
                </p>
                <hr>
                <small class="text-secondary fw-bold">
                    Filters
                </small>
                <div class="flex-grow-1">
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label>Start Date</label>
                            <input type="date" id="TClient_StartDate" class="form-control">
                        </div>
                        <div class="col-6 mb-2">
                            <label>End Date</label>
                            <input type="date" id="TClient_EndDate" class="form-control">
                        </div>
                        <div class="col-12 mb-2">
                            <label>Client</label>
                            <div class="position-relative">
                                <input type="text"
                                       id="TClient_Search" class="form-control" placeholder="Search client by name or document..." autocomplete="off" />
                                <input type="hidden" id="TClient_Id" />
                                <div id="TClient_SearchResults"
                                     class="list-group position-absolute w-100 shadow"
                                     style="z-index:1050; display:none; max-height:250px; overflow-y:auto;">
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <small id="TClient_Selected"
                                   class="text-success fw-semibold"
                                   style="display:none;">
                            </small>
                        </div>
                    </div>
                </div>
                @* <button class="btn btn-success w-100 mt-3"> <i class="bi bi-bar-chart-line"></i> Open Report </button> *@
                <button class="btn btn-primary w-100 btnOpenReport" data-report="trans_clients">Generate Report</button>

            </div>
        </div>

        @* REPORTE 4 *@
        <div class="col-xl-4 col-lg-4 col-md-6 d-flex">
            <div class="report-card h-100 w-100 d-flex flex-column">
                <div class="row">
                    <div class="col-3">
                        <div class="report-icon bg-success">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                    <div class="col-9 mt-3">
                        <h5>Clients Report</h5>
                    </div>
                </div>
                <p class="text-muted">
                    View news customers,
                    registration date and country.
                </p>
                <hr>
                <small class="text-secondary fw-bold">
                    Filters
                </small>
                <div class="flex-grow-1">
                    <div class="row">
                        <div class="col-6 mb-2">
                            <label>Start Date</label>
                            <input type="date" id="Clients_StartDate" class="form-control">
                        </div>
                        <div class="col-6 mb-2">
                            <label>End Date</label>
                            <input type="date" id="Clients_EndDate" class="form-control">
                        </div>
                    </div>
                </div>
                @* <button class="btn btn-success w-100 mt-3"> <i class="bi bi-bar-chart-line"></i> Open Report </button> *@
                <button class="btn btn-primary w-100 btnOpenReport" data-report="new_clients">Generate Report</button>

            </div>
        </div>



    </div>
</div>

@section Scripts {
<script>

        //fechas para los Justify date
        const today = new Date();
        const todayString =today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
        const firstDayOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        const firstDayString =firstDayOfMonth.getFullYear() + '-' +String(firstDayOfMonth.getMonth() + 1).padStart(2, '0') + '-' +String(firstDayOfMonth.getDate()).padStart(2, '0');
        //FECHA ACTUAL
        $('#Dayli_StartDate').val(todayString);
        $('#Dayli_EndDate').val(todayString);
        $('#TCompany_EndDate').val(todayString);
        $('#Clients_EndDate').val(todayString);
            $('#TClient_EndDate').val(todayString);

        //FECHA PRIMER DIA DEL MES
        $('#TCompany_StartDate').val(firstDayString);
        $('#Clients_StartDate').val(firstDayString);
            $('#TClient_StartDate').val(firstDayString);

    $.get('/TransactionsTypes/GetAllTypes', function (data) {
        $('#TransactionType').empty();
        data.forEach(t => {
            $('#TransactionType').append(
            `<option value="${t.numberT}"
                    data-commission="${t.commission}">
                ${t.name}
            </option>`);
            $('#4_TransactionType').append(
            `<option value="${t.numberT}"
                     data-commission="${t.commission}">
                 ${t.name}
             </option>`);
        });
    });

        $(document).on('click', '.btnOpenReport', function () {
            let report = $(this).data('report');
            switch (report) {
                case "transactions_day":
                    generateDayliTransactionsReport();
                    break;
                case "transactions_type":
                    generateTransactionsReport();
                    break;
                case "new_clients":
                        generateNewClientsReport();
                    break;
                    case "trans_clients":
                        generateClientTransactionsReport();
                    break;
            }
        });

        //REPORTES
        //REPORTE DE TRANSACCIONES DEL DIA
                function generateDayliTransactionsReport() {
                let startDate = $('#Dayli_StartDate').val();
                let endDate = $('#Dayli_EndDate').val();
                    let urlBase = "https://localhost:28183";
                if (!startDate || !endDate) {
                    Swal.fire(
                        'Required',
                        'Select Start Date and End Date',
                        'warning'
                    );
                    return;
                }
                Swal.fire({
                    title: 'Generating report...',
                    text: 'Please wait',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });
                $.ajax({
                            url: '/Reports/GenerateDayliTransactionsReport',
                    type: 'GET',
                    data: {
                        startDate: startDate,
                        endDate: endDate
                    },
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function (blob) {
                        Swal.close();
                        let url = window.URL.createObjectURL(blob);
                        window.open(url, '_blank');
                    },
                    error: function (xhr) {
                        Swal.close();
                        let message = "Unexpected error";
                        if (xhr.responseText)
                            message = xhr.responseText;
                        Swal.fire(
                            'Error',
                            message,
                            'error'
                        );
                    }
                });
            }


        //REPORTE DE TRANSACCIONES POR TIPO DE TRANSACCIÓN
        function generateTransactionsReport() {
                let startDate = $('#TCompany_StartDate').val();
            let endDate = $('#TCompany_EndDate').val();
            let transactionType = $('#TransactionType').val();
                let urlBase = "https://localhost:28183";
            if (!startDate || !endDate) {
                Swal.fire(
                    'Required',
                    'Select Start Date and End Date',
                    'warning'
                );
                return;
            }
            if (!transactionType) {
                Swal.fire(
                    'Required',
                    'Select a Transaction Type',
                    'warning'
                );
                return;
            }
            Swal.fire({
                title: 'Generating report...',
                text: 'Please wait',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });
            $.ajax({
                    url: '/Reports/GenerateTransactionsReport',
                type: 'GET',
                data: {
                    startDate: startDate,
                    endDate: endDate,
                    transactionType: transactionType
                },
                xhrFields: {
                    responseType: 'blob'
                },
                success: function (blob) {
                    Swal.close();
                    let url = window.URL.createObjectURL(blob);
                    window.open(url, '_blank');
                },
                error: function (xhr) {
                    Swal.close();
                    let message = "Unexpected error";
                    if (xhr.responseText)
                        message = xhr.responseText;
                    Swal.fire(
                        'Error',
                        message,
                        'error'
                    );
                }
            });
        }

        //REPORTE DE TRANSACCIONES POR CLIENTE

            $("#TClient_Search").on("keyup", function () {
                let term = $(this).val();
                if (term.length < 3) {
                    $("#TClient_SearchResults").hide();
                    return;
                }
                $.get("/Clients/Search",
                    { term: term },
                    function (data) {
                        let results = $("#TClient_SearchResults");
                        results.empty();
                        if (data.length === 0) {
                            results.hide();
                            return;
                        }
                        $.each(data, function (i, client) {
                            results.append(`
                                <a href="#"
                                   class="list-group-item list-group-item-action client-item"
                                   data-id="${client.idClient}"
                                   data-name="${client.fullName}"
                                   data-document="${client.documentNumber}">
                                    <strong>${client.fullName}</strong><br>
                                    <small>${client.documentNumber}</small>

                                </a>
                            `);
                        });
                        results.show();
                    });
            });
            $(document).on("click", ".client-item", function (e) {
                e.preventDefault();
                $("#TClient_Id").val($(this).data("id"));
                $("#TClient_Search").val($(this).data("name"));
                $("#TClient_Selected")
                    .html(`
                        <i class="bi bi-check-circle-fill"></i>
                        ${$(this).data("name")} (${$(this).data("document")})
                    `).show();
                $("#TClient_SearchResults").hide();
            });

            //REPORTE
            function generateClientTransactionsReport() {
                    let startDate = $('#TClient_StartDate').val();
                    let endDate = $('#TClient_EndDate').val();
                    let Client_Id = $('#TClient_Id').val();
                if (!startDate || !endDate) {
                    Swal.fire(
                        'Required',
                        'Select Start Date and End Date',
                        'warning'
                    );
                    return;
                }
                    if (!Client_Id) {
                    Swal.fire(
                        'Required',
                        'Select a Client',
                        'warning'
                    );
                    return;
                }
                Swal.fire({
                    title: 'Generating report...',
                    text: 'Please wait',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });
                $.ajax({
                            url: '/Reports/GenerateClientTransactionsReport',
                    type: 'GET',
                    data: {
                        startDate: startDate,
                        endDate: endDate,
                        client_Id: Client_Id
                    },
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function (blob) {
                        Swal.close();
                        let url = window.URL.createObjectURL(blob);
                        window.open(url, '_blank');
                    },
                    error: function (xhr) {
                        Swal.close();
                        let message = "Unexpected error";
                        if (xhr.responseText)
                            message = xhr.responseText;
                        Swal.fire(
                            'Error',
                            message,
                            'error'
                        );
                    }
                });
            }

            //REPORTE DE clientes nuevos en periodo x
                    function generateNewClientsReport() {
                    let startDate = $('#Clients_StartDate').val();
                    let endDate = $('#Clients_EndDate').val();
                    if (!startDate || !endDate) {
                        Swal.fire(
                            'Required',
                            'Select Start Date and End Date',
                            'warning'
                        );
                        return;
                    }
                    Swal.fire({
                        title: 'Generating report...',
                        text: 'Please wait',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });
                    $.ajax({
                                    url: '/Reports/GenerateNewClientsReport',
                        type: 'GET',
                        data: {
                            startDate: startDate,
                            endDate: endDate
                        },
                        xhrFields: {
                            responseType: 'blob'
                        },
                        success: function (blob) {
                            Swal.close();
                            let url = window.URL.createObjectURL(blob);
                            window.open(url, '_blank');
                        },
                        error: function (xhr) {
                            Swal.close();
                            let message = "Unexpected error";
                            if (xhr.responseText)
                                message = xhr.responseText;
                            Swal.fire(
                                'Error',
                                message,
                                'error'
                            );
                        }
                    });
                }

</script>
}