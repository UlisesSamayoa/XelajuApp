@using TransferApp.ViewModels
@model TransactionPreviewViewModel

@if (Model.AttachmentImages.Any() || Model.AttachmentPdfs.Any())
{
    <div class="attachments-section">

        <h5>
            <i class="bi bi-paperclip"></i>
            Supporting Documents
        </h5>


        @foreach (var file in Model.AttachmentImages)
        {
            <div class="attachment-page">

                <div class="attachment-title">
                    @file.FileName
                </div>

                <img src="@file.Base64"
                     class="document-image" />

            </div>
        }

    </div>
    @if (Model.AttachmentPdfs.Any())
    {
        <div class="attachments-section mt-4">

            <h5>
                <i class="bi bi-file-earmark-pdf"></i>
                PDF Documents
            </h5>


            @foreach (var pdf in Model.AttachmentPdfs)
            {
                <div class="pdf-item">

                    <i class="bi bi-file-earmark-pdf-fill"></i>

                    @pdf.OriginalFileName

                </div>
            }

        </div>
    }
}else
{
    <div class="alert alert-light mb-0">

        No evidence attached.

    </div>
}
