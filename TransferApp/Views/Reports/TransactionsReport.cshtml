@using TransferApp.Models.Reports
@model TransactionReportViewModel
@{
    Layout = null;
    bool isCheck = Model.Transactions[0].TransactionType == 1;
    var totalAmount = Model.Transactions.Sum(x => x.Amount);
    var totalFederal = Model.Transactions.Sum(x => x.Commission);
    var totalFee = Model.Transactions.Sum(x => x.FixedCommission);
    var totalFees = totalFederal + totalFee;
    var totalCustomer = Model.Transactions.Sum(x => x.TotalAmount);
    string type = Model.Transactions[0].TransactionType switch
    {
        1 => "Check cashing",
        2 => "Money order",
        3 => "Money transfer",
        4 => "Paid Service",
        5 => "Domestic Transfer",
        _ => "-"
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <div class="section-title">
        Financial Transactions
    </div>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial,Helvetica,sans-serif;
        }

        body {
            margin: 30px;
            color: #222;
            font-size: 13px;
        }

        h1, h2, h3, h4, h5 {
            margin: 0;
        }

        .header {
            width: 100%;
            border-bottom: 3px solid #0d6efd;
            padding-bottom: 18px;
            margin-bottom: 25px;
        }

        .company {
            font-size: 26px;
            font-weight: bold;
            color: #0d6efd;
        }

        .subtitle {
            color: #666;
            margin-top: 3px;
        }

        .report-title {
            text-align: right;
        }

            .report-title h2 {
                font-size: 24px;
            }

            .report-title small {
                color: #777;
            }

        table.info {
            width: 100%;
            margin-bottom: 25px;
            border-collapse: collapse;
        }

            table.info td {
                padding: 6px;
            }

        .info-label {
            color: #777;
            font-weight: bold;
            width: 130px;
        }

        .summary {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
        }

        .card {
            width: 24%;
            border: 1px solid #DDD;
            border-radius: 8px;
            padding: 15px;
            background: white;
            box-shadow: 0 2px 5px rgba(0,0,0,.08);
        }

        .card-title {
            color: #777;
            font-size: 12px;
        }

        .card-value {
            margin-top: 8px;
            font-size: 24px;
            font-weight: bold;
        }

        table.report {
            width: 100%;
            border-collapse: collapse;
        }

            table.report thead {
                background: #0d6efd;
                color: white;
            }

            table.report th {
                padding: 10px;
                text-align: left;
                font-size: 12px;
            }

            table.report td {
                padding: 9px;
                border-bottom: 1px solid #EEE;
            }

            table.report tbody tr:nth-child(even) {
                background: #fafafa;
            }

        .right {
            text-align: right;
        }

        tfoot td {
            font-weight: bold;
            background: #efefef;
        }

        .footer {
            margin-top: 35px;
            border-top: 1px solid #DDD;
            padding-top: 10px;
            color: #777;
            font-size: 11px;
            text-align: center;
        }

        .section-title {
            margin-top: 40px;
            margin-bottom: 12px;
            padding: 10px 14px;
            background: #0d6efd;
            color: white;
            font-size: 16px;
            font-weight: bold;
            border-radius: 5px;
        }

        thead {
            display: table-header-group;
        }

        tfoot {
            display: table-footer-group;
        }

        tr {
            page-break-inside: avoid;
        }

        .report {
            margin-bottom: 35px;
        }

        .footer {
            margin-top: 40px;
            border-top: 1px solid #DDD;
            padding-top: 12px;
            color: #777;
            font-size: 11px;
            text-align: center;
        }

        .summary-table {
            width: 55%;
            margin-left: auto;
            border-collapse: collapse;
            margin-top: 15px;
        }

            .summary-table td {
                padding: 10px;
                border: 1px solid #DDD;
            }

                .summary-table td:first-child {
                    font-weight: bold;
                    background: #f8f9fa;
                }

                .summary-table td:last-child {
                    text-align: right;
                    font-weight: bold;
                }

        .summary-total {
            background: #0d6efd;
            color: white;
            font-size: 15px;
        }

        .summary-container {
            page-break-inside: avoid;
            break-inside: avoid;
            margin-top: 30px;
        }

        .summary-table {
            width: 55%;
            margin-left: auto;
            border-collapse: collapse;
        }

            .summary-table tr {
                page-break-inside: avoid;
            }

            .summary-table td {
                padding: 10px;
                border: 1px solid #DDD;
            }
    </style>
</head>
<body>
    <div class="header">
        <table width="100%">
            <tr>
                <td width="75%">
                    <div class="company">
                        XELAJU WATER
                    </div>
                    <div class="subtitle">
                        Financial Transactions Report
                    </div>
                    <div class="subtitle">Transactions Type: @type</div>
                    <div style="margin-top:15px;font-size:12px;color:#555;">
                        <strong>Period:</strong>
                        @Model.StartDate.ToString("dd/MM/yyyy")
                        -
                        @Model.EndDate.ToString("dd/MM/yyyy")
                    </div>
                </td>
                <td width="25%" style="text-align:right;">
                    @* Aquí luego podemos colocar el logo *@
                    <!--<img src="/images/logo.png" style="height:70px;" />-->
                    <h2 style="margin-top:10px;">
                        REPORT
                    </h2>
                    <div style="font-size:12px;color:#777;">
                        Generated
                    </div>
                    <div style="font-weight:bold;">
                        @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </td>
            </tr>
        </table>
    </div>
    <div class="summary">

        <div class="card">
            <div class="card-title">Operations</div>
            <div class="card-value">@Model.Transactions.Count</div>
        </div>

        <div class="card">
            <div class="card-title">
                @(isCheck ? "Check Value" : "Transaction Volume")
            </div>
            <div class="card-value">
                @totalAmount.ToString("C2")
            </div>
        </div>

        <div class="card">
            <div class="card-title">Total Fees Collected</div>
            <div class="card-value">
                @totalFees.ToString("C2")
            </div>
        </div>

        <div class="card">
            <div class="card-title">
                @(isCheck ? "Cash Delivered" : "Amount Received")
            </div>
            <div class="card-value">
                @totalCustomer.ToString("C2")
            </div>
        </div>

    </div>
    <table class="report">
        <thead>
            <tr>
                <th>#</th>
                <th>Date</th>
                <th>Reference</th>
                <th>Client</th>
                <th>Company</th>
                <th class="right">
                    @(isCheck ? "Check Value" : "Amount")
                </th>
                <th class="right">
                    Federal
                </th>
                <th class="right">
                    Fee
                </th>
                <th class="right">
                    %/Fee
                </th>
                <th class="right">
                    @(isCheck ? "Cash Delivered" : "Customer Paid")
                </th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Transactions.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>
                        @Model.Transactions[i].DateC.ToString("dd/MM/yyyy")
                    </td>
                    <td>@Model.Transactions[i].ReferenceNumber</td>
                    <td>
                        @Model.Transactions[i].ClientName
                    </td>
                    <td>
                        @Model.Transactions[i].CompanyName
                    </td>
                    <td class="right">
                        $@Model.Transactions[i].Amount.ToString("N2")
                    </td>
                    <td class="right">
                        $@Model.Transactions[i].Commission.ToString("N2")
                    </td>
                    <td class="right">
                        $@Model.Transactions[i].FixedCommission.ToString("N2")
                    </td>
                    <td class="right">
                        @* $@(Model.Transactions[i].FixedCommission + Model.Transactions[i].Commission).ToString("N2") *@
                        @String.Format("{0:N2}", Model.Transactions[i].FixedCommission + Model.Transactions[i].Commission)

                    </td>
                    <td class="right">
                        $@Model.Transactions[i].TotalAmount.ToString("N2")
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5">
                    @(isCheck ? "Check Totals" : "Transaction Totals")
                </td>
                <td class="right">
                    @totalAmount.ToString("N2")
                </td>
                <td class="right">
                    @totalFederal.ToString("N2")
                </td>
                <td class="right">
                    @totalFee.ToString("N2")
                </td>
                <td class="right">
                    @String.Format("{0:N2}", @totalFee + @totalFederal)
                </td>
                <td class="right">
                    @totalCustomer.ToString("N2")
                </td>
            </tr>
        </tfoot>
    </table>
    <div class="footer">
        This report was automatically generated by the Xelaju water Management System.<br />
        Generated on @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss")
    </div>
</body>
</html>