        var totalFees = Model.Transactions.Sum(x => x.FixedCommission);
        var totalCommission = Model.Transactions.Sum(x => x.Commission + x.FixedCommission);
        var customerAmount = Model.Transactions.Sum(x => x.TotalAmount);
    }
    <table class="summary-table">
        <tr>
