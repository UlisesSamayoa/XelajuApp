@using TransferApp.Models.Reports
@model TransactionReportViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Dayli Transactions Report</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial,Helvetica,sans-serif;
        }
        body {
            margin: 30px;
            color: #222;
            font-size: 13px;
        }
        h1, h2, h3, h4, h5 {
            margin: 0;
        }
        .header {
            width: 100%;
            border-bottom: 3px solid #0d6efd;
            padding-bottom: 18px;
            margin-bottom: 25px;
        }
        .company {
            font-size: 26px;
            font-weight: bold;
            color: #0d6efd;
        }
        .subtitle {
            color: #666;
            margin-top: 3px;
        }
        .report-title {
            text-align: right;
        }
            .report-title h2 {
                font-size: 24px;
            }
            .report-title small {
                color: #777;
            }
        table.info {
            width: 100%;
            margin-bottom: 25px;
            border-collapse: collapse;
        }
            table.info td {
                padding: 6px;
            }
        .info-label {
            color: #777;
            font-weight: bold;
            width: 130px;
        }
        .summary {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
        }
        .card {
            width: 24%;
            border: 1px solid #DDD;
            border-radius: 8px;
            padding: 15px;
            background: #fafafa;
        }
        .card-title {
            color: #777;
            font-size: 12px;
        }
        .card-value {
            margin-top: 8px;
            font-size: 24px;
            font-weight: bold;
        }
        table.report {
            width: 100%;
            border-collapse: collapse;
        }
            table.report thead {
                background: #0d6efd;
                color: white;
            }
            table.report th {
                padding: 10px;
                text-align: left;
                font-size: 12px;
            }
            table.report td {
                padding: 9px;
                border-bottom: 1px solid #EEE;
            }
            table.report tbody tr:nth-child(even) {
                background: #fafafa;
            }
        .right {
            text-align: right;
        }
        tfoot td {
            font-weight: bold;
            background: #efefef;
        }
        .footer {
            margin-top: 35px;
            border-top: 1px solid #DDD;
            padding-top: 10px;
            color: #777;
            font-size: 11px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <table width="100%">
            <tr>
                <td>
                    <div class="company">
                        XELAJU WATER SYSTEM
                    </div>
                    <div class="subtitle">
                        Dayli Transaction Report
                    </div>
                </td>
                <td class="report-title">
                    <h2>
                        TRANSACTIONS
                    </h2>
                    <small>
                        Generated @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </td>
            </tr>
        </table>
    </div>
    <table class="info">
        <tr>
            <td colspan="2" class="info-label">
                Dayli Transactions
            </td>
            <td class="info-label">
                From
            </td>
            <td>
                @Model.StartDate.ToString("dd/MM/yyyy")
            </td>
            <td class="info-label">
                To
            </td>
            <td>
                @Model.EndDate.ToString("dd/MM/yyyy")
            </td>
        </tr>
    </table>
    <div class="summary">
        <div class="card">
            <div class="card-title">Transactions</div>
            <div class="card-value">@Model.Transactions.Count</div>
        </div>
        <div class="card">
            <div class="card-title">Gross Amount</div>
            <div class="card-value">@Model.Transactions.Sum(x => x.Amount).ToString("C2")</div>
        </div>
        <div class="card">
            <div class="card-title">Total Fees</div>
            <div class="card-value">@Model.Transactions.Sum(x => x.Commission + x.FixedCommission).ToString("C2")</div>
        </div>
        <div class="card">
            <div class="card-title">Net Amount</div>
            <div class="card-value">@Model.Transactions.Sum(x => x.TotalAmount).ToString("C2")</div>
        </div>
    </div>
    <table class="report">
        <thead>
            <tr>
                <th>#</th>
                <th>Reference</th>
                <th>Client</th>
                <th>Company</th>
                <th>Date</th>
                <th class="right">
                    Amount
                </th>
                <th class="right">
                    Federal
                </th>
                <th class="right">
                    Fee
                </th>
                <th class="right">
                    Net
                </th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Transactions.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model.Transactions[i].ReferenceNumber</td>

                    <td>

                        @Model.Transactions[i].ClientName

                    </td>

                    <td>

                        @Model.Transactions[i].CompanyName

                    </td>

                    <td>

                        @Model.Transactions[i].DateC.ToString("dd/MM/yyyy")

                    </td>

                    <td class="right">

                        @Model.Transactions[i].Amount.ToString("N2")

                    </td>

                    <td class="right">

                        @Model.Transactions[i].Commission.ToString("N2")

                    </td>

                    <td class="right">

                        @Model.Transactions[i].FixedCommission.ToString("N2")

                    </td>

                    <td class="right">

                        @Model.Transactions[i].TotalAmount.ToString("N2")

                    </td>

                </tr>

            }

        </tbody>

        <tfoot>

            <tr>

                <td colspan="5">

                    Totals

                </td>

                <td class="right">

                    @Model.Transactions.Sum(x => x.Amount).ToString("N2")

                </td>

                <td class="right">

                    @Model.Transactions.Sum(x => x.Commission).ToString("N2")

                </td>

                <td class="right">

                    @Model.Transactions.Sum(x => x.FixedCommission).ToString("N2")

                </td>

                <td class="right">
                    @Model.Transactions.Sum(x => x.TotalAmount).ToString("N2")
                </td>
            </tr>
        </tfoot>
    </table>
    <div class="footer">
        This report was automatically generated by the Xelaju water Management System.<br />
        Generated on @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss")
    </div>
</body>
</html>