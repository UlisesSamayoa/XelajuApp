    <div class="summary-container">

        <div class="section-title">
            Daily Operations Summary
        </div>

        @{
            var financialCount = financialTransactions.Count;
            var checkCount = checkTransactions.Count;
            var totalTransactions = Model.Transactions.Count;

            // Financial
            var financialVolume = financialTransactions.Sum(x => x.Amount);
            var financialFees = financialTransactions.Sum(x => x.Commission + x.FixedCommission);
            var financialCustomerAmount = financialTransactions.Sum(x => x.TotalAmount);

            // Checks
            var checkVolume = checkTransactions.Sum(x => x.Amount);
            var checkFees = checkTransactions.Sum(x => x.Commission + x.FixedCommission);
            var checkDelivered = checkTransactions.Sum(x => x.TotalAmount);

            // Overall
            var totalVolume = financialVolume + checkVolume;
            var totalFees = financialFees + checkFees;
            var totalDelivered = financialCustomerAmount + checkDelivered;
        }

        <!-- Financial -->
        <table class="summary-table">
            <tr class="summary-header">
                <td colspan="2">Financial Transactions</td>
            </tr>

            <tr>
                <td>Operations</td>
                <td>@financialCount</td>
            </tr>

            <tr>
                <td>Transaction Volume</td>
                <td>@financialVolume.ToString("C2")</td>
            </tr>

            <tr>
                <td>Fees Collected</td>
                <td>@financialFees.ToString("C2")</td>
            </tr>

            <tr class="summary-total">
                <td style="color:#000 !important;">Amount Received from Customers</td>
                <td>@financialCustomerAmount.ToString("C2")</td>
            </tr>
        </table>

        <br />

        <!-- Checks -->
        <table class="summary-table">
            <tr class="summary-header">
                <td colspan="2">Check Cashing</td>
            </tr>

            <tr>
                <td>Operations</td>
                <td>@checkCount</td>
            </tr>

            <tr>
                <td>Check Value Processed</td>
                <td>@checkVolume.ToString("C2")</td>
            </tr>

            <tr>
                <td>Fees Collected</td>
                <td>@checkFees.ToString("C2")</td>
            </tr>

            <tr class="summary-total">
                <td style="color:#000 !important;">Cash Delivered</td>
                <td>@checkDelivered.ToString("C2")</td>
            </tr>
        </table>

        <br />

        <!-- Overall -->
        <table class="summary-table">
            <tr class="summary-header">
                <td colspan="2">Overall Daily Summary</td>
            </tr>

            <tr>
                <td>Total Operations</td>
                <td>@totalTransactions</td>
            </tr>

            <tr>
                <td>Total Business Volume</td>
                <td>@totalVolume.ToString("C2")</td>
            </tr>

            <tr>
                <td>Total Fees Collected</td>
                <td>@totalFees.ToString("C2")</td>
            </tr>

            <tr class="summary-total">
                <td style="color:#000 !important;">Total Amount Delivered to Customers</td>
                <td>@totalDelivered.ToString("C2")</td>
            </tr>
        </table>

    </div>
    <div class="footer">
        This report was automatically generated by the Xelaju water Management System.<br />
        Generated on @Model.GeneratedDate.ToString("dd/MM/yyyy HH:mm:ss")
    </div>
</body>
</html>