@{
    ViewData["Title"] = "Update Transaction Type";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="container mt-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between mb-3">
            <h3>Update Transaction Type</h3>

            <a href="/TransactionsTypes" class="btn btn-secondary">
                Back
            </a>
        </div>

        <form id="formUpdateTT">

            <input type="hidden" id="Id" value="@ViewBag.Id" />
            <label class="form-label">Transaction Number</label>
            <input name="NumberT" id="NumberT" type="number" class="form-control mb-2" placeholder="Transaction Number" required />
            <label class="form-label">Name</label>
            <input id="Name" class="form-control mb-2" placeholder="Name" />
            @* <label class="form-label">Commission</label>
            <input id="Commission" type="number" step="0.01" class="form-control mb-2" placeholder="Commission" /> *@
            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label">
                        Commission Ranges
                    </label>
                    <br /><br />
                    <button type="button"
                            class="btn btn-success btn-sm"
                            id="btnAddRange">

                        <i class="bi bi-plus"></i>
                        Add Range

                    </button>
                </div>

                <div id="commissionRangesContainer">
                </div>
            </div>

            <label class="form-label">Description</label>
            <input id="Description" class="form-control mb-2" placeholder="Description" />
            <div class="mt-3 d-flex gap-2">
                <button type="button" class="btn btn-primary" id="btnUpdate">
                    <i class="bi bi-floppy-fill"></i> Update
                </button>
                <a href="/TransactionsTypes" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </form>

    </div>

</div>

<script>

    let id = $('#Id').val();

    $(document).ready(function(){
        loadData();
    });

    function loadData(){

        $.get('/TransactionsTypes/GetById?id='+id,function(d){

            $('#Name').val(d.name);
            $('#Commission').val(d.commission);
            $('#Description').val(d.description);
            $('#Status').val(d.status);
            $('#NumberT').val(d.numberT);
                $('#commissionRangesContainer').empty();

                if (d.commissionRanges) {
                d.commissionRanges.forEach(r => {
                    addCommissionRange(
                        r.minAmount,
                        r.maxAmount,
                        r.commissionPercent
                    );
                });
                }
        });
    }

    $('#btnUpdate').click(function(){
            let commissionRanges = [];

        $('.commission-row').each(function () {

            commissionRanges.push({
                minAmount:parseFloat($(this).find('.range-min').val()) || 0,
                maxAmount:parseFloat($(this).find('.range-max').val()) || 0,
                commissionPercent:parseFloat($(this).find('.range-percent').val()) || 0
            });
        });
        let data = {
            idTypeTransaction:id,
            name:$('#Name').val(),
            commission:parseFloat($('#Commission').val()),
            description:$('#Description').val(),
            NumberT:$('#NumberT').val(),
            status:$('#Status').val(),
            commissionRanges:commissionRanges
        };
        if(!data.NumberT){
                Swal.fire('Error','Transaction Numner is required','error');
                return;
        }
        
        Swal.fire({title:'Updating...',didOpen:()=>Swal.showLoading()});

        $.ajax({
            url:'/TransactionsTypes/Update',
            method:'POST',
            contentType:'application/json',
            data:JSON.stringify(data),
            success:()=>{
                Swal.fire({
                    icon:'success',
                    title:'Updated!',
                    timer:1200,
                    showConfirmButton:false
                }).then(() => {
                    window.location.href = '/TransactionsTypes';
                });
            },
            error:e=>{
                Swal.fire('Error',e.responseJSON?.message,'error');
            }
        });

    });
        function addCommissionRange(
        minAmount = '',
        maxAmount = '',
        commissionPercent = ''
    ) {

        let html = `
            <div class="row g-2 mb-2 commission-row">

                <div class="col-4">
                    <input
                        type="number"
                        class="form-control range-min"
                        placeholder="Min Amount"
                        value="${minAmount}">
                </div>

                <div class="col-4">
                    <input
                        type="number"
                        class="form-control range-max"
                        placeholder="Max Amount"
                        value="${maxAmount}">
                </div>

                <div class="col-3">
                    <input
                        type="number"
                        step="0.01"
                        class="form-control range-percent"
                        placeholder="%"
                        value="${commissionPercent}">
                </div>

                <div class="col-1">
                    <button
                        type="button"
                        class="btn btn-danger btnRemoveRange">

                        <i class="bi bi-trash"></i>

                    </button>
                </div>

            </div>
        `;

        $('#commissionRangesContainer')
            .append(html);
    }
    $('#btnAddRange').click(function () {

        addCommissionRange();

    });
    $(document).on(
        'click',
        '.btnRemoveRange',
        function () {

            $(this)
                .closest('.commission-row')
                .remove();

        }
    );
</script>