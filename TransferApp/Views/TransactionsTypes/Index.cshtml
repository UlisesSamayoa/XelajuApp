@using TransferApp.Extensions
@{
    ViewData["Title"] = "TransactionsTypes";
}
<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
    }

        .btn-custom:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

    .fade-in {
        animation: fadeIn .4s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
<script>
    const permissions = {
        canView: @User.HasPermission("TransactionsTypes.View").ToString().ToLower(),
        canDelete: @User.HasPermission("TransactionsTypes.Delete").ToString().ToLower(),
        canEdit: @User.HasPermission("TransactionsTypes.Edit").ToString().ToLower(),
    };
</script>
<div class="container-fluid mt-4 px-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between mb-3">
            <h3><i class="bi bi-cash-stack"></i> Transactions Types</h3>
            @if (User.HasPermission("TransactionsTypes.Create"))
            {
                <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalTT">
                    <i class="bi bi-plus"></i> Add Type
            </button>
            }
        </div>

        <table id="tblTT" class="table table-hover w-100">
            <thead class="table-light">
                <tr>
                    <th>Transaction Number</th>
                    <th>Name</th>
                    <th>Commission</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalTT">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content card-custom p-3">
            <div class="modal-header">
                <h5>New Transaction Type</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formTT">
                <div class="row">
                    <div class="col-6">
                        <label class="form-label">Transaction Number</label>
                        <input name="NumberT" type="number" class="form-control mb-2" placeholder="Transaction Number" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Name</label>
                        <input name="Name" class="form-control mb-2" placeholder="Name" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <input name="Description" class="form-control mb-3" placeholder="Description" />
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label mb-0">
                        Commission Ranges
                    </label>

                    <button type="button"
                            class="btn btn-success btn-sm"
                            onclick="addCommissionRange()">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div id="CommissionRangesContainer">
                    <div class="row g-2 commission-row">
                        <div class="col-2">
                            <input type="number"
                                   class="form-control commission-min"
                                   placeholder="From" />
                        </div>
                        <div class="col-2">
                            <input type="number"
                                   class="form-control commission-max"
                                   placeholder="To" />
                        </div>
                        <div class="col-2">
                            <input type="number"
                                   step="0.01"
                                   class="form-control commission-percent"
                                   placeholder="% / Fee" />
                        </div>
                        <div class="col-4">
                            <select class="form-control commission-type">
                                <option value="0">Federal</option>
                                <option value="1">Fee</option>
                            </select>
                        </div>
                        <div class="col-2 text-center">
                            <button type="button"
                                    class="btn btn-danger btn-remove-range">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <br />
            </form>
            <div class="modal-footer">
                <button class="btn btn-custom" id="btnSaveTT"><i class="bi bi-floppy-fill"></i> Save</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    let table;

    $(document).ready(function(){
        loadTable();
    });

    function loadTable(){

        table = $('#tblTT').DataTable({
            ajax:{
                url:'/TransactionsTypes/GetAll',
                type: 'GET',
                dataSrc:''
            },
            columns:[
                { data:'numberT' },
                { data:'name' },
                { data:'name'},
                { data:'description' },
                {
                    // data:'idTypeTransaction',
                    // render:id=>`
                    //     <a href="/TransactionsTypes/Update/${id}" class="btn btn-warning btn-sm">
                    //         <i class="bi bi-pencil-fill"></i>
                    //     </a>
                    //     <button class="btn btn-danger btn-sm" onclick="deleteTT(${id})">
                    //         <i class="bi bi-trash-fill"></i>
                    //     </button>
                    // `

                            data: 'idTypeTransaction',
                            render: function (id) {

                                let buttons = '';

                                if (permissions.canEdit) {
                                    buttons += `
                                    <a href="/TransactionsTypes/Update/${id}" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    `;
                                }

                                if (permissions.canDelete) {
                                    buttons += `
                                    <button class="btn btn-danger btn-sm" onclick="deleteTT(${id})">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                    `;
                                }

                                return buttons;
                            }

                }
            ],
            drawCallback:()=>$('#tblTT tbody tr').addClass('fade-in')
        });
    }

    $('#btnSaveTT').click(function(){
        let commissionRanges = [];
        $('.commission-row').each(function () {
            commissionRanges.push({
                MinAmount:parseFloat($(this).find('.commission-min').val()) || 0,
                MaxAmount:parseFloat($(this).find('.commission-max').val()) || 0,
                CommissionPercent:parseFloat($(this).find('.commission-percent').val()) || 0,
                CommissionType:$(this).find('.commission-type').val() || 1
            });
        });
        let data = {
            name:$('input[name="Name"]').val(),
            //commission:parseFloat($('input[name="Commission"]').val()),
            description:$('input[name="Description"]').val(),
            NumberT:$('input[name="NumberT"]').val(),
            CommissionRanges:commissionRanges
        };
        if(!data.NumberT){
                Swal.fire('Error','Transaction Numner is required','error');
                return;
        }
        // if(!data.name || isNaN(data.commission)){
        //     Swal.fire('Error','Name & Commission required','error');
        //     return;
        // }

        Swal.fire({title:'Saving...',didOpen:()=>Swal.showLoading()});

        $.ajax({
            url:'/TransactionsTypes/Create',
            method:'POST',
            contentType:'application/json',
            data:JSON.stringify(data),
            success:()=>{
                $('#modalTT').modal('hide');
                $('#formTT')[0].reset();
                table.ajax.reload();

                Swal.fire({
                    icon:'success',
                    title:'Saved!',
                    timer:1200,
                    showConfirmButton:false
                });
            },
            error:e=>{
                Swal.fire('Error',e.responseJSON?.message,'error');
            }
        });

    });

    function deleteTT(id){

        Swal.fire({
            title:'Delete?',
                text: 'This TransactionType will be removed',
            icon:'warning',
            showCancelButton:true
        }).then(r=>{
            if(r.isConfirmed){

                $.post('/TransactionsTypes/Delete?id='+id,()=>{
                    table.ajax.reload();

                    Swal.fire({
                        icon:'success',
                        title:'Deleted!',
                        timer:1200,
                        showConfirmButton:false
                    });
                });

            }
        });
    }
            let commissionIndex = 1;

        function addCommissionRange() {

            let html = `
                <div class="row g-2 mt-2 commission-row">

                    <div class="col-2">
                        <input type="number"
                               class="form-control commission-min"
                               placeholder="From" />
                    </div>

                    <div class="col-2">
                        <input type="number"
                               class="form-control commission-max"
                               placeholder="To" />
                    </div>

                    <div class="col-2">
                        <input type="number"
                               step="0.01"
                               class="form-control commission-percent"
                               placeholder="% / Fee" />
                    </div>
                    <div class="col-4">
                            <select class="form-control commission-type">
                             <option value="0">Federal</option>
                             <option value="1">Fee</option>
                        </select>
                    </div>
                        <div class="col-2 text-center">
                        <button type="button"
                                class="btn btn-danger btn-remove-range">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>

                </div>
            `;

            $('#CommissionRangesContainer').append(html);

            commissionIndex++;
        }
        $(document).on(
            'click',
            '.btn-remove-range',
            function () {

                if ($('.commission-row').length > 1) {
                    $(this)
                        .closest('.commission-row')
                        .remove();
                }
            }
        );
</script>
}