@{
    ViewData["Title"] = "Update DocumentsType";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    :root {
        --primary: #4f46e5;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
        }

    .form-control {
        border-radius: 10px;
    }

    .title {
        font-weight: bold;
    }
</style>
<div class="container mt-4">

    <div class="card p-4">
        <div class="d-flex justify-content-between mb-3">
            <h3>Update Document Type</h3>
            <a href="/DocumentsTypes" class="btn btn-secondary"> <i class="bi bi-arrow-left"></i> Back</a>
        </div>
        <label class="form-label">Name</label>
        <input name="Name" id="Name" class="form-control mb-2" />
        <label class="form-label">Description</label>
        <textarea name="Description" id="Description" class="form-control mb-2" placeholder="Description"></textarea>

        <div class="mt-3 d-flex gap-2">
            <button type="button" class="btn btn-primary" id="btnUpdate">
                <i class="bi bi-floppy-fill"></i> Update
            </button>
            <a href="/DocumentsTypes" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

</div>

<script>
           const id = window.location.pathname.split('/').pop();

    $(document).ready(function () {

        $.get('/DocumentsTypes/GetById?id=' + id, function (d) {

            $('#Id').val(d.idDocumentType);
            $('#Name').val(d.name);
            $('#Description').val(d.description);

        });

    });

    $('#btnUpdate').click(function () {
        var _Name= $('input[name="Name"]').val().trim();
            var _Description= $('textarea[name="Description"]').val().trim();
             if (!_Name) {
                    Swal.fire('Error', 'Name is required', 'error');
                    return;
                }
                if (!_Description) {
                        Swal.fire('Error', 'Description is required', 'error');
                    return;
                }
        $.ajax({
            url: '/DocumentsTypes/Update',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                idDocumentType: id,
                 name: _Name,
                    description:_Description
            }),
            success: () =>  Swal.fire('Updated!', '', 'success').then(() => location.href = '/DocumentsTypes'),
            error: e => Swal.fire('Error', e.responseJSON.message, 'error')
        });

    });
</script>