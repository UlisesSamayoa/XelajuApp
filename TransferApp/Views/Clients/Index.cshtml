@{
    ViewData["Title"] = "Clients";
}

<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

    .fade-in {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<div class="container-fluid mt-4 px-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3><i class="bi bi-people-fill"></i> Clients</h3>

            <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalClient">
                <i class="bi bi-plus"></i> Add Client
            </button>
        </div>

        <table id="tblClients" class="table table-hover w-100">
            <thead class="table-light">
                <tr>
                    <th>Client</th>
                    <th>Document</th>
                    <th>Phone</th>
                    <th>Country</th>
                    <th>Picture</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalClient">
    <div class="modal-dialog modal-xl">
        <div class="modal-content card-custom p-3">
            <h5 class="mb-3">New Client</h5>
            <form id="formClient">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-6">
                                <label>First Name</label>
                                <input name="FirstName" class="form-control mb-2" required placeholder="First Name" />
                            </div>
                            <div class="col-md-6">
                                <label>Last Name</label>
                                <input name="LastName" class="form-control mb-2" required placeholder="Last Name" />
                            </div>
                        </div>
                        <label>Document Type</label>
                        @* <select name="IdDocumentType" id="IdDocumentType" class="form-control mb-2">
                            <option value="1">DUI</option>
                            <option value="2">Passport</option>
                            <option value="3">License</option>
                        </select> *@
                        <select name="IdDocumentType" id="IdDocumentType" class="form-control mb-2">
                        </select>
                        <label>Document Number</label>
                        <input name="DocumentNumber" class="form-control mb-2" required placeholder="Document Number" />
                        <label>Expiration Date</label>
                        <input type="date" name="ExpirationDate" class="form-control mb-2" />
                        <label>Phone</label>
                        <input name="Phone" class="form-control mb-2" placeholder="Phone" />
                        <label>Country</label>
                        <select name="Country" id="Country" class="form-control mb-2"></select>
                        <label>Address</label>
                        <textarea name="Address" class="form-control mb-2" placeholder="Address"></textarea>
                    </div>
                    <div class="col-md-6 text-center">
                        <label class="mb-2">Client Photo / ID</label>
                        <input type="file" id="fileClient" class="form-control mb-3"
                               onchange="previewClientImage(this)" />
                        <div id="clientPreview" class="text-center border rounded p-3">
                            <span class="text-muted">No image selected</span>
                        </div>
                    </div>
                </div>
            </form>
            <div class="modal-footer">
                <button class="btn btn-custom" id="btnSaveClient">
                    <i class="bi bi-floppy-fill"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="modalPreview">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content card-custom p-3">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-2">

                <h5 class="mb-0">
                    <i class="bi bi-eye"></i> File Preview
                </h5>

                <div class="d-flex gap-2">

                    <a id="btnDownloadFile"
                       class="btn btn-success btn-sm"
                       target="_blank">
                        <i class="bi bi-download"></i> Download
                    </a>

                    <button class="btn-close" data-bs-dismiss="modal"></button>

                </div>
            </div>

            <!-- BODY -->
            <div id="previewContent" class="text-center">
                <span class="text-muted">No file selected</span>
            </div>

        </div>
    </div>
</div>
@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        let table;
        $(document).ready(function () {
            table = loadClients();
            loadCountriesDropdown('#Country');
            loadDocumentsTypesDropdown('#IdDocumentType');
        });

          function loadClients() {
                return $('#tblClients').DataTable({
                ajax: {
                    url: '/Clients/GetAll',
                    dataSrc: ''
                },
                columns: [
                    {
                        data: null,
                        render: d => `
                            <b>${d.firstName} ${d.lastName}</b>
                        `
                    },
                    {
                        data: null,
                        render: d => `
                            <small>${d.documentNumber}</small>
                        `
                    },
                    { data: 'phone' },
                    { data: 'countryName' },
                    {
                        data: 'picture',
                        render: f => f
                            ? `<img src="${f}"
                                onclick="openPreview('${f}')"
                                style="height:50px;width:50px;object-fit:cover;
                                    border-radius:8px;cursor:pointer;" />`
                            : '<span class="text-muted">No photo</span>'
                    },
                    {
                        data: 'idClient',
                        render: id => `
                            <a href="/Clients/Update/${id}" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <button class="btn btn-danger btn-sm" onclick="deleteClient(${id})">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        `
                    }
                ],
                drawCallback: () => $('#tblClients tbody tr').addClass('fade-in')
            });
        }

            $('#btnSaveClient').click(function () {

             var _FirstName= $('input[name="FirstName"]').val().trim();
             var _LastName= $('input[name="LastName"]').val().trim();
             var _IdDocumentType = $('#IdDocumentType').val();
             var _DocumentNumber= $('input[name="DocumentNumber"]').val().trim();
             var _ExpirationDate= $('input[name="ExpirationDate"]').val().trim();
             var _Phone= $('input[name="Phone"]').val().trim();
             var _Country= $('#Country').val();
             var _Address= $('textarea[name="Address"]').val().trim();
                if (!_FirstName) {
                    Swal.fire('Error', 'FirstName is required', 'error');
                    return;
                }
                if (!_LastName) {
                        Swal.fire('Error', 'LastName is required', 'error');
                    return;
                }
                if (!_IdDocumentType) {
                    Swal.fire('Error', 'DocumentType is required'+ _IdDocumentType, 'error');
                    return;
                }
                if (!_DocumentNumber) {
                    Swal.fire('Error', 'DocumentNumber is required', 'error');
                    return;
                }
                if (!_ExpirationDate) {
                        Swal.fire('Error', 'ExpirationDate is required', 'error');
                    return;
                }
                if (!_Phone) {
                        Swal.fire('Error', 'Phone is required', 'error');
                    return;
                }
                if (!_Country) {
                        Swal.fire('Error', 'Country is required', 'error');
                    return;
                }
                if (!_Address) {
                        Swal.fire('Error', 'Address is required', 'error');
                    return;
                }

            let formData = new FormData();
            $('#formClient').serializeArray().forEach(x => {
                formData.append(x.name, x.value);
            });
            formData.append("UserC", "admin");
            let file = $('#fileClient')[0].files[0];
            if (file) formData.append("File", file);
            $.ajax({
                url: '/Clients/Create',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: () => Swal.fire({ title: 'Saving...', didOpen: () => Swal.showLoading() }),
                success: res => {
                    Swal.fire('Saved!', res.message, 'success');
                    $('#modalClient').modal('hide');
                    $('#formClient')[0].reset();
                    $('#clientPreview').html('<span class="text-muted">No image selected</span>');
                    $('#tblClients').DataTable().ajax.reload();
                },
                error: err => Swal.fire('Error', err.responseJSON?.message, 'error')
            });
        });

        function deleteClient(id) {
            Swal.fire({
                title: 'Delete client?',
                text: 'This Client will be deleted',
                icon: 'warning',
                showCancelButton: true
            }).then(r => {
                if (!r.isConfirmed) return;
                $.post('/Clients/Delete?id=' + id, () => {
                    Swal.fire('Deleted!', '', 'success');
                    $('#tblClients').DataTable().ajax.reload();
                });
            });
        }


                 function previewClientImage(input) {

            const file = input.files[0];
            const preview = $('#clientPreview');

            preview.html('');

            if (!file) return;

            const reader = new FileReader();

            reader.onload = function (e) {

                preview.html(`
                    <img src="${e.target.result}"
                         onclick="openPreview('${e.target.result}')"
                         style="height:120px;width:120px;
                                object-fit:cover;
                                border-radius:12px;
                                cursor:pointer;"
                         class="shadow"/>
                    <div class="mt-2 text-muted small">Click to preview</div>
                `);
            };

            reader.readAsDataURL(file);
        }

        function loadCountriesDropdown(selectId, selectedValue = null) {
            $.ajax({
                url: '/Countries/GetAll',
                type: 'GET',
                success: function (data) {
                    let select = $(selectId);
                    select.empty();
                    select.append(`<option value="">Select country</option>`);
                    data.forEach(c => {
                        select.append(`
                            <option value="${c.idCountry}">
                                ${c.name}
                            </option>
                        `);
                    });
                    if (selectedValue) {
                        select.val(selectedValue);
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Failed to load countries', 'error');
                }
            });
        }

            function openPreview(fileUrl) {

            let content = '';

            if (!fileUrl) {
                content = '<span class="text-muted">No file available</span>';
                $('#btnDownloadFile').hide();
            }
            else if (fileUrl.toLowerCase().includes('.pdf')) {

                content = `
                    <iframe src="${fileUrl}"
                            width="100%"
                            height="500px"
                            style="border-radius:12px;">
                    </iframe>
                `;

                $('#btnDownloadFile')
                    .show()
                    .attr('href', fileUrl)
                    .attr('download', fileUrl.split('/').pop());
            }
            else {

                content = `
                    <div class="text-center">
                        <img src="${fileUrl}"
                             style="max-height:450px; border-radius:12px;"
                             class="shadow"/>
                    </div>
                `;

                // 🔥 si es base64 (preview local), ocultar download
                if (fileUrl.startsWith("data:")) {
                    $('#btnDownloadFile').hide();
                } else {
                    $('#btnDownloadFile')
                        .show()
                        .attr('href', fileUrl)
                        .attr('download', fileUrl.split('/').pop());
                }
            }

            $('#previewContent').html(content);

            $('#modalPreview').modal('show');
        }

        function loadDocumentsTypesDropdown(selectId, selectedValue = null) {
            $.ajax({
                url: '/DocumentsTypes/GetAll',
                type: 'GET',
                success: function (data) {
                    let select = $(selectId);
                    select.empty();
                    select.append(`<option value="">Select country</option>`);
                    data.forEach(c => {
                        select.append(`
                            <option value="${c.idDocumentType}">
                                ${c.name}
                            </option>
                        `);
                    });
                    if (selectedValue) {
                        select.val(selectedValue);
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Failed to load countries', 'error');
                }
            });
        }

    </script>

}