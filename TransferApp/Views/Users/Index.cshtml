@model List<UserModel>
@{
    ViewData["Title"] = "Users";
}

<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Name</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Username</td>
                <td>@item.FullName</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
            </tr>
        }
    </tbody>
</table>