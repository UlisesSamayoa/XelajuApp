@using TransferApp.Extensions
@model List<UserModel>
@{
    ViewData["Title"] = "Users";
    Layout = "_Layout";
}
<div class="container-fluid">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0"> <i class="bi bi-people-fill"></i>
                Users
            </h4>
            @if (User.HasPermission("Users.Create"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    New User
                </a>
            }
        </div>
        <div class="card-body">
            <table id="tblUsers" class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Username</strong>
                            </td>
                            <td>
                                @item.FullName
                            </td>
                            <td>
                                @item.Email
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (User.HasPermission("Users.Edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.IdUser" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                }
                                @if (User.HasPermission("Users.Delete"))
                                {
                                    <button class="btn btn-danger btn-sm" onclick="deleteUser(@item.IdUser)">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function(){
            $('#tblUsers').DataTable({
                ordering:false,
                language:{
                    emptyTable:"No users registered",
                    search:"Search:",
                    lengthMenu:"Show _MENU_ records",
                    zeroRecords:"No matching users found"
                }
            });
        });
        function deleteUser(id){
            if(!confirm("Delete this user?"))
                return;
            $.post('/Users/Delete/'+id,function(){
                location.reload();
            });
        }
    </script>

}