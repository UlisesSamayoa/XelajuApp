@{
    ViewData["Title"] = "Update User";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<style>
    :root {
        --primary: #4f46e5;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
        }

    .form-control {
        border-radius: 10px;
    }

    .title {
        font-weight: bold;
    }
</style>

<div class="container mt-4">

    <div class="card card-custom p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="title">Update User</h3>

            <a href="/Users" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <form id="formUpdateUser">

            <!-- ID oculto -->
            <input type="hidden" id="Id" value="1" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label>First Name</label>
                    <input type="text" id="FirstName" class="form-control" value="John" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Last Name</label>
                    <input type="text" id="LastName" class="form-control" value="Doe" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Email</label>
                    <input type="email" id="Email" class="form-control" value="john@mail.com" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Phone</label>
                    <input type="text" id="Phone" class="form-control" value="12345678" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Country</label>
                    <input type="text" id="Country" class="form-control" value="USA" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Document</label>
                    <input type="text" id="DocumentNumber" class="form-control" value="A12345678" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Status</label>
                    <select id="IsActive" class="form-control">
                        <option value="true" selected>Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="button" class="btn btn-custom" id="btnUpdateUser">
                    <i class="bi bi-floppy-fill"></i> Update
                </button>

                <a href="/Users" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>

        </form>

    </div>

</div>

<script>

    // 💾 UPDATE
    $('#btnUpdateUser').click(function () {

        let data = {
            id: $('#Id').val(),
            firstName: $('#FirstName').val(),
            lastName: $('#LastName').val(),
            email: $('#Email').val(),
            phone: $('#Phone').val(),
            country: $('#Country').val(),
            document: $('#DocumentNumber').val(),
            isActive: $('#IsActive').val()
        };

        // 🧠 Validación simple
        if (!data.firstName || !data.lastName || !data.email) {
            Swal.fire('Error', 'Required fields missing', 'error');
            return;
        }

        // 🔄 Simulación update
        Swal.fire({
            title: 'Updating...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
        });

        setTimeout(() => {
            Swal.fire({
                icon: 'success',
                title: 'Updated!',
                text: `${data.firstName} ${data.lastName} updated successfully`
            });
        }, 1000);

    });

</script>