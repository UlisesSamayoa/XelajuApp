        function loadPaidServiceCompanies(selectId, selectedValue = null) {

            $.get(
                '/Companies/GetByTransactionType?transactionType=4',
                function (data) {

                    let select = $('#' + selectId);

                    select.empty();

                    select.append(`
                        <option value="">
                            Select Company
                        </option>
                    `);

                    data.forEach(c => {

                        select.append(`
                            <option value="${c.idCompany}">
                                ${c.name}
                            </option>
                        `);

                    });

                    if (selectedValue) {
                        select.val(selectedValue);
                    }
                }
            );
