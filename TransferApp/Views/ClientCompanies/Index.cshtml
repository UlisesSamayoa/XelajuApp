@using TransferApp.Extensions
@{
    ViewData["Title"] = "ClientCompanies";
    Layout = "_Layout";
}
@* <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> *@

<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --bg: #f1f5f9;
    }

    body {
        background: var(--bg);
    }

    .card-custom {
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .btn-custom {
        background: var(--primary);
        color: white;
        border-radius: 10px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

    #ParentClientName {
        background: #eef2ff;
        font-weight: 500;
    }

    .fade-in {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container-fluid mt-4 px-4">
    <div class="card card-custom p-4">
        <div class="d-flex justify-content-between mb-3">
            <h3><i class="bi bi-person-heart"></i> Client Company</h3>
            @if (User.HasPermission("ClientCompanies.Create"))
            {
                <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#modalClientCompany">
                    <i class="bi bi-plus"></i> Add Client Companies
            </button>
            }
        </div>
        <table id="tblClientCompanies" class="table table-hover w-100">
            <thead class="table-light">
                <tr>
                    <th>Client</th>
                    <th>Company</th>
                    <th>Account Number</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>

    </div>
</div>

<div class="modal fade" id="modalClientCompany">
    <div class="modal-dialog">
        <div class="modal-content card-custom p-3">
            <h5>New Client Account</h5>
            <form id="formClientCompany">
                <label>Client</label>
                <div class="input-group mb-2">
                    <input id="ClientName" class="form-control" readonly placeholder="Select client..." />
                    <button type="button" class="btn btn-outline-primary" onclick="openClientModal()">🔍</button>
                </div>
                <input type="hidden" id="IdClient" />
                <label>Company</label>
                <select id="IdCompany"
                        class="form-control mb-2">
                </select>

                <label>Account Number</label>
                <input id="AccountNumber"
                       class="form-control mb-2"
                       placeholder="Account Number" />

            </form>

            <div class="modal-footer">
                <button class="btn btn-custom"
                        id="btnSaveClientCompany">
                    Save
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalClients">
    <div class="modal-dialog modal-xl">
        <div class="modal-content card-custom p-3">

            <h5>👤 Select Client</h5>

            <input id="searchClient" class="form-control mb-3"
                   placeholder="Search by name, document or phone..." />

            <table id="tblClientsModal" class="table table-hover w-100">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Document</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                </thead>
            </table>

        </div>
    </div>
</div>
