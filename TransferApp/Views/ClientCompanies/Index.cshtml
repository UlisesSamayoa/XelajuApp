        function loadTable() {
            return $('#tblClientCompanies').DataTable({
                ajax: {
                    url: '/ClientCompanies/GetAll',
                    dataSrc: ''
                },
                columns: [
                    { data: 'clientName' },
                    { data: 'companyName' },
                    { data: 'accountNumber' },
                    {
                        data: 'idClientCompany',
                        render: id => `
                            <button
                                class="btn btn-danger btn-sm"
                                onclick="deleteItem(${id})">

                                <i class="bi bi-trash-fill"></i>

                            </button>
                        `
                    }
                ]
            });
        }

        $('#btnSaveClientCompany').click(function () {
            let data = {
                idClient:$('#IdClient').val(),
                idCompany:$('#IdCompany').val(),
                accountNumber:$('#AccountNumber').val()
            };
            if (!data.idClient) {
                Swal.fire(
                    'Error',
                    'Client is required',
                    'error'
                );
                return;
            }

            if (!data.idCompany) {
                Swal.fire(
                    'Error',
                    'Company is required',
                    'error'
                );
                return;
            }

            if (!data.accountNumber) {
                Swal.fire(
                    'Error',
                    'Account Number is required',
                    'error'
                );
                return;
            }
            $.ajax({
                url: '/ClientCompanies/Create',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: () => {
                    $('#modalClientCompany').modal('hide');
                    table.ajax.reload();
                    $('#formClientCompany')[0].reset();
                    Swal.fire({
                        icon: 'success',
                        title: 'Saved!',
                        timer: 1200,
                        showConfirmButton: false
                    });
                },
                error: e => {

                    Swal.fire(
                        'Error',
                        e.responseJSON?.message,
                        'error'
                    );
                }
            });
        });

        function deleteItem(id) {
            Swal.fire({
                title: 'Delete record?',
                text: 'This action cannot be undone',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete'
            }).then((result) => {

                if (!result.isConfirmed)
                    return;

                $.post(
                    '/ClientCompanies/Delete?id=' + id,
                    function () {

                        table.ajax.reload();

                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            timer: 1200,
                            showConfirmButton: false
                        });
                    }
                );

            });

        }

        function openClientModal(){

            $('#modalClients').modal('show');

            if (!window.clientTableLoaded) {
                loadClientsModal();
                window.clientTableLoaded = true;
            }
        }

                function loadClientsModal(){

                window.tblClientsModal = $('#tblClientsModal').DataTable({
                    data: [],
                    columns:[
                        { data:'fullName' },
                        { data:'documentNumber' },
                        { data:'phone' },
                        {
                            data:null,
                            render:d=>`
                                <button class="btn btn-success btn-sm"
                                    onclick="selectClient(${d.idClient}, '${d.fullName}')">
                                    Select
                                </button>
                            `
                        }
                    ],
                    language:{
                        emptyTable:'Type to search clients...'
                    }
                });

            }

            $('#searchClient').on('keyup', function () {

                clearTimeout(timer);

                let term = this.value;

                timer = setTimeout(() => {

                    if(term.length < 2){
                        tblClientsModal.clear().draw();
                        return;
                    }

                    $.get('/Clients/Search?term=' + term, function(data){

                        tblClientsModal.clear().rows.add(data).draw();

                    });

                }, 400);

            });

        function selectClient(id, name){

            //$('#IdClient_fk').val(id);
            $('#IdClient').val(id);
            $('#ClientName').val(name);

            $('#modalClients').modal('hide');

            Swal.fire({
                icon:'success',
                title:'Client selected',
                text:name,
                timer:1200,
                showConfirmButton:false
            });
        }
